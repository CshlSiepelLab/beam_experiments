import os
import sys
import glob

# specific to yang et al data to get the input files (character matrices and tissue labeling files)
character_matrices = glob.glob(os.path.join(config['inputpath'], "*_successive_char_matrix_collapsed.txt"))
mouse_ids = ["_".join(os.path.basename(x).split("_")[0:3]) for x in character_matrices]



tissue_labeling_files = [os.path.join(config['inputpath'], f"{x}_successive_char_matrix_collapsing_dict.txt") for x in mouse_ids]

outdir = config['outdir']

rule all:
    input:
        expand("{outdir}/beam/{mouse}/terminal_{num}.log", mouse=mouse_ids, num=range(1, config['numChains']+1), outdir=outdir),
        expand("{outdir}/beam/{mouse}/combined.log", mouse=mouse_ids, outdir=outdir),
        expand("{outdir}/beam/{mouse}/threshold_migration_graph.pdf", mouse=mouse_ids, outdir=outdir)

rule runCassiopeiaDs:
    input:
        matrix = os.path.join(config['inputpath'], "{mouse}_successive_char_matrix_collapsed.txt")
    output:
        "{outdir}/ds_cassiopeia_greedy/{mouse}/cassiopeia_greedy_inferred.nwk"
    params:
        cassiopeia_script = os.path.join(config['scripts'], "cassiopeia/cassiopeia_greedy.py"),
        outputdir = "{outdir}/ds_cassiopeia_greedy/{mouse}"
    singularity:
        "../../envs/simulate.sif"
    shell:
        """
        # run cassiopeia greedy
        python {params.cassiopeia_script} {input.matrix} {params.outputdir}
        """

rule runLAMLds:
    input:
        matrix = os.path.join(config['inputpath'], "{mouse}_successive_char_matrix_collapsed.txt"),
        casTree = "{outdir}/ds_cassiopeia_greedy/{mouse}/cassiopeia_greedy_inferred.nwk"
    output:
        lamlTree = "{outdir}/ds_laml/{mouse}/{mouse}_laml_trees.nwk",
        lamlAnnotations = "{outdir}/ds_laml/{mouse}/{mouse}_laml_annotations.txt",
        lamlTreeNoBranchLengths = "{outdir}/ds_laml/{mouse}/{mouse}_laml_trees_no_branch_lengths.nwk",
        lamlTreeNoOrigin = "{outdir}/ds_laml/{mouse}/{mouse}_laml_trees_no_origin.nwk",
        matrix2 = "{outdir}/ds_laml/{mouse}/matrix.csv"
    params:
        outputdir = "{outdir}/ds_laml/{mouse}",
        experimentTime = lambda wildcards: config['experimentTime'][wildcards.mouse],
    conda:
        "../../envs/laml.yaml"
    shell:
        """
        # copy matrix and replace -1 with ? for missing data
        cp {input.matrix} {params.outputdir}/matrix.csv
        sed -i 's/-1/?/g; s/\t/,/g' {params.outputdir}/matrix.csv

        # run laml
        run_laml -c {params.outputdir}/matrix.csv -t {input.casTree} -o {params.outputdir}/{wildcards.mouse}_laml --timescale {params.experimentTime} --parallel

        # obtain newick without branch lengths
        sed 's/:\([0-9]\+\.\?\([0-9]\+\)\?\)//g' {output.lamlTree} > {output.lamlTreeNoBranchLengths}

        # remove origin from tree
        newick=$(sed 's/):.*$//g' {params.outputdir}/{wildcards.mouse}_laml_trees.nwk) 
        echo "${{newick:1}}" > {output.lamlTreeNoOrigin}
        echo ");" >> {output.lamlTreeNoOrigin}
        """

