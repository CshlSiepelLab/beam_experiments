        python {params.cassiopeia_script} {input.expandedMatrix} {params.outputdir}
        """

rule runLAML:
    input:
        expandedMatrix = "{outdir}/beam/{mouse}/expanded_clones_matrix.tsv",
        casTree = "{outdir}/cassiopeia_greedy/{mouse}/cassiopeia_greedy_inferred.nwk"
    output:
        lamlTree = "{outdir}/laml/{mouse}/{mouse}_laml_trees.nwk",
        lamlAnnotations = "{outdir}/laml/{mouse}/{mouse}_laml_annotations.txt",
        lamlTreeNoBranchLengths = "{outdir}/laml/{mouse}/{mouse}_laml_trees_no_branch_lengths.nwk"
    params:
        outputdir = "{outdir}/laml/{mouse}",
        experimentTime = lambda wildcards: config['experimentTime'][wildcards.mouse],
    conda:
        "../../envs/laml.yaml"
    shell:
        """
        # copy matrix and replace -1 with ? for missing data
        cp {input.expandedMatrix} {outdir}/laml/{wildcards.mouse}/matrix.csv
        sed -i 's/-1/?/g; s/\t/,/g' {outdir}/laml/{wildcards.mouse}/matrix.csv

        # run laml
        run_laml -c {outdir}/laml/{wildcards.mouse}/matrix.csv -t {input.casTree} -o {params.outputdir}/{wildcards.mouse}_laml --timescale {params.experimentTime} --parallel

        # obtain newick without branch lengths
        sed 's/:\([0-9]\+\.\?\([0-9]\+\)\?\)//g' {output.lamlTree} > {output.lamlTreeNoBranchLengths}
        """

rule runBeam:
    input:
        fasta = "{outdir}/beam/{mouse}/{mouse}.fasta",
        dates = "{outdir}/beam/{mouse}/{mouse}_date_traits.csv",
        tissues = "{outdir}/beam/{mouse}/{mouse}_tip_tissues.csv",
        editRateProportions = "{outdir}/beam/{mouse}/{mouse}_edit_rate_proportions.txt",
        lamlTree = "{outdir}/laml/{mouse}/{mouse}_laml_trees.nwk"
    output:
        terminalLog = "{outdir}/beam/{mouse}/terminal_{num}.log",
        beamLog = "{outdir}/beam/{mouse}/chain_{num}.log",
        beamResult = "{outdir}/beam/{mouse}/chain_{num}.trees"
    params:
        xml = config['xml'],
        fileDir = "{outdir}/beam/{mouse}",
        experimentTime = lambda wildcards: config['experimentTime'][wildcards.mouse],
        mcmclength = config['mcmcLength'],
        primaryTissue = config['primaryTissue'],
        threads = config['threads']
    shell:
        """
        cp {params.xml} {params.fileDir}/{wildcards.num}.xml

        # calculate necessary inputs for the editing model
        initialEditRates=$(cat {input.editRateProportions} | tr '\n' ' ')
        array=($initialEditRates)
        numEditRates=${{#array[@]}}
        numEditRatesPlusTwo=$(( numEditRates + 2 ))

        # format tissue information
        unique_tissues=$(cat {input.tissues} | cut -d',' -f2 | sort | uniq)
        numTissues=$(echo $unique_tissues | tr ' ' '\n' | wc -l)

        # force the known known primary tissue at the origin for root frequencies in the likelihood calculation
        sorted_unique_tissues="{params.primaryTissue} $(echo $unique_tissues | tr ' ' '\n' | grep -v '^{params.primaryTissue}$' | tr '\n' ' ')"
        if ! echo "$unique_tissues" | grep -qw "{params.primaryTissue}"; then
            numTissues=$(( numTissues + 1 ))
        fi
        tissueRootFreqs=$(for i in $(seq 1 $numTissues); do if [[ "$i" = "1" ]]; then echo -n "1 "; else echo -n "0 "; fi; done)

        numTissueRates=$(( numTissues * (numTissues - 1) ))
        equalTissueRates=$(echo "scale=10; 1.0 / $numTissueRates" | bc -l)
        equalTissueFreqs=$(echo "scale=10; 1.0 / $numTissues" | bc -l)
        
        tissueCodeMap=""
        trailingCodeMap="? = "
        i=0
        for tissue in $sorted_unique_tissues; do
            tissueCodeMap+="${{tissue}}=${{i}},"
            trailingCodeMap+="${{i}} "
            i=$((i+1))
        done
        tissueCodeMap+="${{trailingCodeMap}}"

        # for some reason this cannot be taken in at the command line, likely because the = signs are problematic and not taken as a single string
        sed -i "s/\$(tissueCodeMap)/$tissueCodeMap/g" {params.fileDir}/{wildcards.num}.xml
        sed -i "s/\$(initialEditRates)/$initialEditRates/g" {params.fileDir}/{wildcards.num}.xml
        sed -i "s/\$(tissueRootFreqs)/$tissueRootFreqs/g" {params.fileDir}/{wildcards.num}.xml

        # use LAML starting tree
        # remove node names from newick and the origin node
        newick=$(cat {input.lamlTree} | sed 's/node[0-9]*:/:/g' | sed 's/^.//' | sed 's/..$//')

        beast \
        -threads {params.threads} \
        -overwrite \
        -working \
        -D inName={wildcards.mouse} \
        -D fileDir={params.fileDir} \
        -D newick=\"$newick\" \
        -D generations={params.experimentTime} \
        -D numEditRates=\"$numEditRates\" \
        -D numEditRatesPlusTwo=\"$numEditRatesPlusTwo\" \
        -D numTissueRates=\"$numTissueRates\" \
        -D numTissues=\"$numTissues\" \
        -D equalTissueFreqs=\"$equalTissueFreqs\" \
        -D mcmclength={params.mcmclength} \
        -D outname=chain_{wildcards.num} \
        {params.fileDir}/{wildcards.num}.xml > {output.terminalLog}
        """

rule combineBeamChains:
    input:
        terminalLog = lambda wildcards: expand("{outdir}/beam/{mouse}/terminal_{num}.log", num=range(1, config['numChains']+1), mouse=wildcards.mouse, outdir=wildcards.outdir),
        beamLogs = lambda wildcards: expand("{outdir}/beam/{mouse}/chain_{num}.log", num=range(1, config['numChains']+1), mouse=wildcards.mouse, outdir=wildcards.outdir),
        beamResults = lambda wildcards: expand("{outdir}/beam/{mouse}/chain_{num}.trees", num=range(1, config['numChains']+1), mouse=wildcards.mouse, outdir=wildcards.outdir),
    output:
        combinedLog = "{outdir}/beam/{mouse}/combined.log",
        combinedTrees = "{outdir}/beam/{mouse}/combined.trees",
    params:
        logcombiner = config['logcombiner'],
        essCutoff = config['essCutoff'],
        treeannotator = config['treeannotator'],
        threads = config['threads']
    shell:
        """
        # find chains that have converged based on ess threshold specified
        log_files=""
        trees_files=""
        ess_convergences=()
        for file in {input.beamLogs}; do
            terminal_log=$(echo $file | sed 's/chain_/terminal_/')

            # only use mcmc chains that have converged since many appear to get lost in the search space
            ess_convergence=$(grep "Msamples" $terminal_log | tail -n 1 | sed 's/^ *//;s/ *$//' | tr -s ' ' | cut -d' ' -f3)
            if (( $(echo "$ess_convergence > {params.essCutoff}" | bc -l) )); then
                log_files+="-log $file "
                trees_file=$(echo $file | sed 's/\.log$/.trees/')
                trees_files+="-log $trees_file "
            else
                echo "$file did not converge, so not including it in the final output"
            fi
        done

        # combine logs and trees that passed
        if [ -z "$log_files" ]; then
            echo "No chains have converged based on the ESS threshold."
            touch {output.combinedLog}
            touch {output.combinedTrees}
        else
            {params.logcombiner} $log_files -o {output.combinedLog}
            {params.logcombiner} $trees_files -o {output.combinedTrees}
        fi
        """
    
rule convertTreePosteriorToGraphPosterior:
    input:
        combinedTrees = "{outdir}/beam/{mouse}/combined.trees",
        combinedLog = "{outdir}/beam/{mouse}/combined.log"
    output:
        graphPosterior = "{outdir}/beam/{mouse}/posterior_prob_graph.csv",
        probabilityPlot = "{outdir}/beam/{mouse}/probability_migration_graph.pdf"
    params:
        scripts = config['scripts'],
        primaryTissue = config['primaryTissue'],
        outprefix_thresholded = "{outdir}/beam/{mouse}/thresholded_migration_graph_",
        threads = 5,
        mem = "1G"
    shell:
        """
        # work around until beam visualization is pip installable
        source ~/miniconda3/etc/profile.d/conda.sh 
        conda activate beam_visualization

        if [ ! -s {input.combinedTrees} ]; then
            echo "Combined trees file is empty. Exiting."
            touch {output.graphPosterior}
        else
            thresholds="0.4,0.5,0.6,0.7,0.8,0.9,0.95,0.99"
            python {params.scripts}/formatting/convert_tree_posterior_to_consensus_posterior_prob_graph.py {input.combinedTrees} {input.combinedLog} {params.primaryTissue} {output.graphPosterior} {params.threads} {output.probabilityPlot} $thresholds {params.outprefix_thresholded}
        fi
        """
