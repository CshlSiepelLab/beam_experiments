
import os
import sys
import glob

# get mouse ids and fastq files from input fastq dir
mice = []
mouse_fastqs = {}
for file in glob.glob(os.path.join(config['fastqPath'], "*.fastq.gz")):
    mouse = os.path.basename(file).split("_")[0]
    if mouse not in mice:
        mice.append(mouse)
    if mouse not in mouse_fastqs:
        mouse_fastqs[mouse] = []
    mouse_fastqs[mouse].append(file)


def get_elements_from_file(path):
    filename = f"{path}/cp_list.txt"
    with open(filename) as f:
        return [line.strip() for line in f]


rule all:
    input:
        expand("{outdir}/evotracer/{mouse}/asv_analysis/character_matrix.csv", outdir=config['outdir'], mouse=mice),
        expand("{outdir}/metastabayes/{mouse}/cp_list.txt", outdir=config['outdir'], mouse=mice),
        [expand("{outdir}/cassiopeia_greedy/{mouse}/{cp}/cassiopeia_greedy_inferred.nwk", outdir=config['outdir'], 
               cp=get_elements_from_file(f"{config['outdir']}/metastabayes/{m}"), mouse=m) for m in mice],
        [expand("{outdir}/laml/{mouse}/{cp}/laml_trees.nwk", outdir=config['outdir'],
                cp=get_elements_from_file(f"{config['outdir']}/metastabayes/{m}"), mouse=m) for m in mice],
        [expand("{outdir}/metastabayes/{mouse}/{cp}/terminal_{num}.log", outdir=config['outdir'],
                cp=get_elements_from_file(f"{config['outdir']}/metastabayes/{m}"), num=range(1, config['numChains']+1), mouse=m) for m in mice],
        [expand("{outdir}/metastabayes/{mouse}/{cp}/combined.log", outdir=config['outdir'],
                cp=get_elements_from_file(f"{config['outdir']}/metastabayes/{m}"), mouse=m) for m in mice],
        [expand("{outdir}/metastabayes/{mouse}/{cp}/probability_migration_graph.pdf", outdir=config['outdir'],
                cp=get_elements_from_file(f"{config['outdir']}/metastabayes/{m}"), mouse=m) for m in mice],
        [expand("{outdir}/machina/{mouse}/{cp}/migration_graph.pdf", outdir=config['outdir'],
                cp=get_elements_from_file(f"{config['outdir']}/metastabayes/{m}"), mouse=m) for m in mice],
        [expand("{outdir}/metient/{mouse}/{cp}/{mouse}_{cp}_{primaryTissue}_migration_graphs.txt", outdir=config['outdir'],
                cp=get_elements_from_file(f"{config['outdir']}/metastabayes/{m}"), mouse=m, primaryTissue=config['primaryTissue'][m],) for m in mice]
                

rule runEvotracer:
    input:
        fastqFiles = lambda wildcards: mouse_fastqs[wildcards.mouse]
    output:
        char_matrix = "{outdir}/evotracer/{mouse}/asv_analysis/character_matrix.csv",
        asv_stat = "{outdir}/evotracer/{mouse}/phylogeny_analysis/phylogeny_del_ins/asv_stat.csv",
        mut_dict = "{outdir}/evotracer/{mouse}/asv_analysis/mutation_profile_map.csv",
    params:
        evoOutDir = "{outdir}/evotracer/{mouse}",
        scripts = config['scripts'],
        threads = 10
    singularity:
        '../../envs/evotracer.sif'
    shell:
        """
        # make mouse specific temp dir with fastqs
        tempDir={wildcards.outdir}/{wildcards.mouse}_fastq_temp
        mkdir -p $tempDir
        cp {input.fastqFiles} $tempDir/

        # evotracer needs fastqs to be unzipped
        gunzip $tempDir/*

        Rscript {params.scripts}/evotracer/evotracer.R $tempDir {params.evoOutDir}

        # remove temp dir
        rm -r $tempDir
        """

rule prepMetastabayesInputs:
    input:
        char_matrix = "{outdir}/evotracer/{mouse}/asv_analysis/character_matrix.csv",
        mut_dict = "{outdir}/evotracer/{mouse}/asv_analysis/mutation_profile_map.csv",
        asv_stat = "{outdir}/evotracer/{mouse}/phylogeny_analysis/phylogeny_del_ins/asv_stat.csv"
    output:
        cpList = "{outdir}/metastabayes/{mouse}/cp_list.txt"
    params:
        outdir = "{outdir}/metastabayes/{mouse}",
        scripts = config['scripts'],
        experimentTime = lambda wildcards: config['experimentTime'][wildcards.mouse],
        modelDropouts = config['modelDropouts'],
        threads = 1,
        downsampleThreshold = config['downsampleThreshold']
    conda:
        "../../envs/networkx.yaml"
    shell:
        """
        # prep mutation dictionary
        sed 's/\",/\\t/g' {input.mut_dict} | sed 's/\"//g' > {params.outdir}/mutation_dict.tsv

        # get CPs from asv stat file
        cps=$(tail -n +2 {input.asv_stat} | cut -d',' -f30 | sort | uniq | tr '\\n' ' ')

        # split mutation matrix and tissues for each cp into cp specific files
        for cp in $cps; do
            cpOutdir={params.outdir}/${{cp}}
            mkdir -p $cpOutdir

            # get ASVs for the cp
            asvs=$(tail -n +2 {input.asv_stat} | grep -w "$cp" | cut -d',' -f1 | sort | uniq | tr '\\n' ' ')

            # setup temp matrix and tissue per cp
            tempMatrix=$cpOutdir/temp_matrix.tsv
            head -n 1 {input.char_matrix} | sed 's/,/\t/g' | sed 's/\"//g' > $tempMatrix
            tempTissues=$cpOutdir/temp_tissues.tsv
            echo -e "group_name\ttissues" > $tempTissues

            # make cp specific temp files
            for asv in $asvs; do
                sed 's/,/\t/g' {input.char_matrix} | sed 's/\"//g' | grep -w "$asv" >> $tempMatrix
                tail -n +2 {input.asv_stat} | cut -d',' -f1-2 | grep -w "$asv" | awk -F',' '{{if (!seen[$1","$2]++) a[$1]=a[$1]","$2}} END {{for (i in a) {{split(a[i], b, ","); delete seen; c=""; for (j in b) if (b[j] != "" && !seen[b[j]]++) c=(c == "" ? b[j] : c","b[j]); print i"\t"c}}}}' >> ${{tempTissues}}
            done

            # downsample data if specified
            if [ "{params.downsampleThreshold}" != "0.0" ]; then
                python {params.scripts}/formatting/downsample.py $tempMatrix $tempTissues {params.downsampleThreshold} {params.threads} $cpOutdir/downsampled
                downsampledMatrix=$cpOutdir/downsampled_char_matrix.tsv
                downsampledTissues=$cpOutdir/downsampled_tissue_labels.tsv
            else
                downsampledMatrix=$tempMatrix
                downsampledTissues=$tempTissues
            fi

            # make mutations successive for each matrix and provide an updated dictionary of int to mutations
            python {params.scripts}/formatting/matrix_to_successive_matrix.py $downsampledMatrix {params.outdir}/mutation_dict.tsv $cpOutdir

            # expand clones found in multiple tissues to separate entries
            python {params.scripts}/formatting/expand_clones_multiple_tissues.py $cpOutdir/successive_char_matrix.csv $downsampledTissues $cpOutdir
            matrixFile=$cpOutdir/expanded_clones_matrix.tsv
            tissuesFile=$cpOutdir/expanded_clones_tissues.tsv

            # remove temp files
            # if [ -f $tempMatrix ]; then rm $tempMatrix; fi
            # if [ -f $tempTissues ]; then rm $tempTissues; fi
            # if [ -f $downsampledMatrix ]; then rm $downsampledMatrix; fi
            # if [ -f $downsampledTissues ]; then rm $downsampledTissues; fi
            # rm $cpOutdir/successive_char_matrix.csv

            # make output files
            fasta=$cpOutdir/${{cp}}.fasta
            dates=$cpOutdir/${{cp}}_date_traits.csv
            tissues=$cpOutdir/${{cp}}_tip_tissues.csv
            editRateProportions=$cpOutdir/${{cp}}_edit_rate_proportions.txt

            # write tip traits to new csv
            tail -n +2 $tissuesFile | grep -v '^$' | cut -f1,2 | tr '\\t' ',' > $tissues

            # write date trait
            tail -n +2 $tissuesFile | grep -v '^$' | cut -f1 | paste -d',' - <(yes {params.experimentTime} | head -n $(( $(wc -l < $tissuesFile) - 1 ))) > $dates

            # get edit rate proportions for new mutation entries, relative so they all sum to 1.0
            all_muts=$(tail -n +2 $matrixFile | grep -v '^$' | cut -f2- | sed 's/-1/0/g' | tr '\\t' ' ' | tr '\\n' ' ')
            total_count=$(echo $all_muts | tr ' ' '\\n' | grep -wv "0" | wc -l)
            uniq_count=$(echo $all_muts | tr ' ' '\\n' | sort | uniq | grep -wv "0" | wc -l)
            count_sum=$( echo $all_muts | tr ' ' '\\n' | grep -wv "0" | wc -l )
            
            for element in $(seq 1 $uniq_count); do
                echo "START"
                echo "element: $element"
                if echo "$all_muts" | tr ' ' '\\n' | grep -w "$element"; then
                    echo "FOUND"
                    count=$(echo "$all_muts" | tr ' ' '\\n' | grep -wc "$element")
                    proportion=$(echo "scale=10; $count / $count_sum" | bc)
                else
                    echo "NOT FOUND"
                    count=0
                    proportion=0
                fi
                echo "count: $count"
                echo "proportion: $proportion"
                echo "$proportion" >> $editRateProportions

            done

            # Format fasta with the option to replace site dropouts with the new int representation to be modeled by an independent silencing rate, or 0 to not model dropouts and just consider them as unedited sites
            if [ "{params.modelDropouts}" == "True" ] || [ "{params.modelDropouts}" == "true" ]; then
                # to model dropouts, use the highest mutation int representation and add 1 since the dropout column is the last in the rate matrix
                dropoutMutNum=$(( uniq_count + 1 ))
                tail -n +2 $matrixFile | grep -v '^$' | sed "s/-1/$dropoutMutNum/g" | awk '{{printf ">"$1"\\n"; for (i=2; i<=NF; i++) printf (i==NF ? $i"\\n" : $i",")}}' > $fasta
            else
                # to not model dropouts
                tail -n +2 $matrixFile | grep -v '^$' | sed 's/-1/0/g' | awk '{{printf ">"$1"\\n"; for (i=2; i<=NF; i++) printf (i==NF ? $i"\\n" : $i",")}}' > $fasta
            fi

            # track all CPs as they finish pre-processing
            echo "$cp" >> {output.cpList}
        done       
        """

rule runCassiopeia:
    input:
        cpList = "{outdir}/metastabayes/{mouse}/cp_list.txt",
        matrix = "{outdir}/metastabayes/{mouse}/{cp}/expanded_clones_matrix.tsv"
    output:
        "{outdir}/cassiopeia_greedy/{mouse}/{cp}/cassiopeia_greedy_inferred.nwk"
    params:
        cassiopeia_script = os.path.join(config['scripts'], "cassiopeia/cassiopeia_greedy.py"),
        outputdir = "{outdir}/cassiopeia_greedy/{mouse}/{cp}",
        threads = 5
    singularity:
        "../../envs/simulate.sif"
    shell:
        """
        # run cassiopeia greedy
        python {params.cassiopeia_script} {input.matrix} {params.outputdir}
        """

rule runLAML:
    input:
        cpList = "{outdir}/metastabayes/{mouse}/cp_list.txt",
        expandedMatrix = "{outdir}/metastabayes/{mouse}/{cp}/expanded_clones_matrix.tsv",
        casTree = "{outdir}/cassiopeia_greedy/{mouse}/{cp}/cassiopeia_greedy_inferred.nwk"
    output:
        lamlTree = "{outdir}/laml/{mouse}/{cp}/laml_trees.nwk",
        lamlAnnotations = "{outdir}/laml/{mouse}/{cp}/laml_annotations.txt",
        lamlTreeNoBranchLengths = "{outdir}/laml/{mouse}/{cp}/laml_trees_no_branch_lengths.nwk"
    params:
        outputdir = "{outdir}/laml/{mouse}/{cp}",
        experimentTime = lambda wildcards: config['experimentTime'][wildcards.mouse],
        threads = 25
    conda:
        "../../envs/laml.yaml"
    shell:
        """
        # copy matrix and replace -1 with ? for missing data
        cp {input.expandedMatrix} {params.outputdir}/matrix.csv
        sed -i 's/-1/?/g; s/\t/,/g' {params.outputdir}/matrix.csv

        # run laml
        run_laml -c {params.outputdir}/matrix.csv -t {input.casTree} -o {params.outputdir}/laml --timescale {params.experimentTime} --parallel

        # obtain newick without branch lengths
        sed 's/:\([0-9]\+\.\?\([0-9]\+\)\?\)//g' {output.lamlTree} > {output.lamlTreeNoBranchLengths}
        """

rule runMetastabayes:
    input:
        cpList = "{outdir}/metastabayes/{mouse}/cp_list.txt",
        fasta = "{outdir}/metastabayes/{mouse}/{cp}/{cp}.fasta",
        dates = "{outdir}/metastabayes/{mouse}/{cp}/{cp}_date_traits.csv",
        tissues = "{outdir}/metastabayes/{mouse}/{cp}/{cp}_tip_tissues.csv",
        editRateProportions = "{outdir}/metastabayes/{mouse}/{cp}/{cp}_edit_rate_proportions.txt",
        lamlTree = "{outdir}/laml/{mouse}/{cp}/laml_trees.nwk"
    output:
        terminalLog = "{outdir}/metastabayes/{mouse}/{cp}/terminal_{num}.log",
        metastabayesLog = "{outdir}/metastabayes/{mouse}/{cp}/chain_{num}.log",
        metastabayesResult = "{outdir}/metastabayes/{mouse}/{cp}/chain_{num}.trees"
    params:
        xml = config['xml'],
        fileDir = "{outdir}/metastabayes/{mouse}/{cp}",
        metastabayesJar = config['metastabayesJar'],
        experimentTime = lambda wildcards: config['experimentTime'][wildcards.mouse],
        primaryTissue = lambda wildcards: config['primaryTissue'][wildcards.mouse],
        threads = 5,
        mcmclength = config['mcmcLength']
    shell:
        """
        cp {params.xml} {params.fileDir}/{wildcards.num}.xml

        # calculate necessary inputs for the editing model
        initialEditRates=$(cat {input.editRateProportions} | tr '\n' ' ')
        array=($initialEditRates)
        numEditRates=${{#array[@]}}
        numEditRatesPlusTwo=$(( numEditRates + 2 ))

        # format tissue information
        unique_tissues=$(cat {input.tissues} | cut -d',' -f2 | sort | uniq)
        numTissues=$(echo $unique_tissues | tr ' ' '\n' | wc -l)

        # if numTissues is 1, then the model will not run, so we need to add a dummy tissue
        if [[ $numTissues -eq 1 ]]; then
            # if the primary already exists then add a dummy
            if echo "$unique_tissues" | grep -w "{params.primaryTissue}"; then
                unique_tissues="$unique_tissues dummy"
            # if not, then add the primary as the dummy
            else
                unique_tissues="{params.primaryTissue} $unique_tissues"
            fi
            numTissues=$(( numTissues + 1 ))
        fi

        # force the known known primary tissue at the origin for root frequencies in the likelihood calculation
        sorted_unique_tissues="{params.primaryTissue} $(echo $unique_tissues | tr ' ' '\n' | grep -v '^{params.primaryTissue}$' | tr '\n' ' ')"
        if ! echo "$unique_tissues" | grep -qw "{params.primaryTissue}"; then
            numTissues=$(( numTissues + 1 ))
        fi
        tissueRootFreqs=$(for i in $(seq 1 $numTissues); do if [[ "$i" = "1" ]]; then echo -n "1 "; else echo -n "0 "; fi; done)

        numTissueRates=$(( numTissues * (numTissues - 1) ))
        equalTissueRates=$(echo "scale=10; 1.0 / $numTissueRates" | bc -l)
        equalTissueFreqs=$(echo "scale=10; 1.0 / $numTissues" | bc -l)

        tissueCodeMap=""
        trailingCodeMap="? = "
        i=0
        for tissue in $sorted_unique_tissues; do
            tissueCodeMap+="$tissue=$i,"
            trailingCodeMap+="$i "
            i=$((i+1))
        done
        tissueCodeMap+="${{trailingCodeMap}}"

        # for some reason this cannot be taken in at the command line, likely because the = signs are problematic and not taken as a single string
        sed -i "s/\$(tissueCodeMap)/$tissueCodeMap/g" {params.fileDir}/{wildcards.num}.xml

        # use LAML starting tree
        # remove node names from newick and the origin node
        newick=$(cat {input.lamlTree} | sed 's/node[0-9]*:/:/g' | sed 's/^.//' | sed 's/..$//')

        java -Xmx10g -jar {params.metastabayesJar} \
        -threads {params.threads} \
        -overwrite \
        -working \
        -D inName={wildcards.cp} \
        -D fileDir={params.fileDir} \
        -D newick=\"$newick\" \
        -D generations={params.experimentTime} \
        -D numEditRates=\"$numEditRates\" \
        -D numEditRatesPlusTwo=\"$numEditRatesPlusTwo\" \
        -D initialEditRates=\"$initialEditRates\" \
        -D numTissueRates=\"$numTissueRates\" \
        -D numTissues=\"$numTissues\" \
        -D equalTissueFreqs=\"$equalTissueFreqs\" \
        -D tissueRootFreqs=\"$tissueRootFreqs\" \
        -D mcmclength={params.mcmclength} \
        -D outname=chain_{wildcards.num} \
        {params.fileDir}/{wildcards.num}.xml > {output.terminalLog}
        """

rule combineMetastabayesChains:
    input:
        terminalLog = lambda wildcards: expand("{outdir}/metastabayes/{mouse}/{cp}/terminal_{num}.log", num=range(1, config['numChains']+1), cp=wildcards.cp, mouse=wildcards.mouse, outdir=wildcards.outdir),
        metastabayesLogs = lambda wildcards: expand("{outdir}/metastabayes/{mouse}/{cp}/chain_{num}.log", num=range(1, config['numChains']+1), cp=wildcards.cp, mouse=wildcards.mouse, outdir=wildcards.outdir),
        metastabayesResults = lambda wildcards: expand("{outdir}/metastabayes/{mouse}/{cp}/chain_{num}.trees", num=range(1, config['numChains']+1), cp=wildcards.cp, mouse=wildcards.mouse, outdir=wildcards.outdir),
    output:
        combinedLog = "{outdir}/metastabayes/{mouse}/{cp}/combined.log",
        combinedTrees = "{outdir}/metastabayes/{mouse}/{cp}/combined.trees",
    params:
        logcombiner = config['logcombiner'],
        essCutoff = config['essCutoff'],
        threads = 1
    shell:
        """
        # find chains that have converged based on ess threshold specified
        log_files=""
        trees_files=""
        ess_convergences=()
        for file in {input.metastabayesLogs}; do
            terminal_log=$(echo $file | sed 's/chain_/terminal_/')
            
            # only use mcmc chains that have converged since many appear to get lost in the search space
            ess_convergence=$(grep "Msamples" $terminal_log | tail -n 1 | sed 's/^ *//;s/ *$//' | tr -s ' ' | cut -d' ' -f3)
            if (( $(echo "$ess_convergence > {params.essCutoff}" | bc -l) )); then
                log_files+="-log $file "
                trees_file=$(echo $file | sed 's/\.log$/.trees/')
                trees_files+="-log $trees_file "
            else
                echo "$file did not converge, so not including it in the final output"
            fi
        done
        # combine logs and trees that passed
        {params.logcombiner} $log_files -o {output.combinedLog}
        {params.logcombiner} $trees_files -o {output.combinedTrees}
        """

rule convertTreePosteriorToGraphPosterior:
    input:
        combinedTrees = "{outdir}/metastabayes/{mouse}/{cp}/combined.trees"
    output:
        graphPosterior = "{outdir}/metastabayes/{mouse}/{cp}/posterior_prob_graph.csv"
    params:
        scripts = config['scripts'],
        primaryTissue = lambda wildcards: config['primaryTissue'][wildcards.mouse],
        outdir = "{outdir}/metastabayes/{mouse}/{cp}",
        threads = 1
    conda:
        "../../envs/networkx.yaml"
    shell:
        """
        if [ ! -s {input.combinedTrees} ]; then
            echo "Combined trees file is empty. Exiting."
            touch {output.graphPosterior}
        else
            python {params.scripts}/formatting/convert_tree_posterior_to_consensus_posterior_prob_graph.py {input.combinedTrees} {params.primaryTissue} {output.graphPosterior} {params.threads}
        fi
        """

rule plotGraphPosterior:
    input:
        graphPosterior = "{outdir}/metastabayes/{mouse}/{cp}/posterior_prob_graph.csv"
    output:
        probabilityPlot = "{outdir}/metastabayes/{mouse}/{cp}/probability_migration_graph.pdf",
        thresholdPlot = "{outdir}/metastabayes/{mouse}/{cp}/threshold_70_migration_graph.pdf"
    params:
        scripts = config['scripts'],
        primaryTissue = lambda wildcards: config['primaryTissue'][wildcards.mouse],
        outdir = "{outdir}/metastabayes/{mouse}/{cp}",
        threads = 1
    conda:
        "../../envs/networkx.yaml"
    shell:
        """
        if [ ! -s {input.graphPosterior} ]; then
            echo "Graph posterior file is empty. Exiting."
            touch {output.probabilityPlot}
            touch {output.thresholdPlot}
        else
            python {params.scripts}/plotting/plot_consensus_prob_migration_graph.py {input.graphPosterior} {params.primaryTissue} {params.outdir}
        fi
        """

rule prepMachina:
    input:
        lamlTreeNoBranchLengths = "{outdir}/laml/{mouse}/{cp}/laml_trees_no_branch_lengths.nwk",
        tissues = "{outdir}/metastabayes/{mouse}/{cp}/{cp}_tip_tissues.csv"
    output:
        tissuesTsv = "{outdir}/machina/{mouse}/{cp}/leaf_tissues.tsv",
        labeling = "{outdir}/machina/{mouse}/{cp}/laml_trees_no_branch_lengths.labeling",
        colors = "{outdir}/machina/{mouse}/{cp}/laml_trees_no_branch_lengths_colors.txt",
        tree = "{outdir}/machina/{mouse}/{cp}/laml_trees_no_branch_lengths.tree",
    params:
        scripts = config['scripts'],
        outputdir = "{outdir}/machina/{mouse}/{cp}",
        primaryTissue = lambda wildcards: config['primaryTissue'][wildcards.mouse],
        threads = 1
    singularity:
        '../../envs/simulate.sif'
    shell:
        """
        # convert csv to tsv for leaf labels
        sed 's/,/\\t/g' {input.tissues} > {output.tissuesTsv}

        # prep machina inputs
        python {params.scripts}/machina/prep_machina.py {input.lamlTreeNoBranchLengths} {params.outputdir} {params.primaryTissue} {output.tissuesTsv}
        """

rule runMachina:
    input:
        tissuesTsv = "{outdir}/machina/{mouse}/{cp}/leaf_tissues.tsv",
        labeling = "{outdir}/machina/{mouse}/{cp}/laml_trees_no_branch_lengths.labeling",
        colors = "{outdir}/machina/{mouse}/{cp}/laml_trees_no_branch_lengths_colors.txt",
        tree = "{outdir}/machina/{mouse}/{cp}/laml_trees_no_branch_lengths.tree",
    output:
        machinaResults = "{outdir}/machina/{mouse}/{cp}/machina_results.txt",
        dotFile = "{outdir}/machina/{mouse}/{cp}/" + f"{config['primaryTissue'][mouse]}-G-{config['primaryTissue'][mouse]}-R.dot",
        machinaEdgeFile = "{outdir}/machina/{mouse}/{cp}/" + f"{config['primaryTissue'][mouse]}-G-{config['primaryTissue'][mouse]}-R.tree"
    params:
        scripts = config['scripts'],
        outputdir = "{outdir}/machina/{mouse}/{cp}",
        primaryTissue = lambda wildcards: config['primaryTissue'][wildcards.mouse],
        threads = 100
    conda:
        "../../envs/machina.yaml"
    shell:
        """
        # load Gurobi license (specific to CSHL HPC; will need to be modified on other systems)
        module load EBModules
        module load Gurobi

        # run machina
        {params.scripts}/machina/run_machina_tr.sh --threads {params.threads} --edges {input.tree} --labels {input.labeling} --colors {input.colors} --primary-tissue {params.primaryTissue} --outdir {params.outputdir}
        """

rule plotMachinaMigrationGraphs:
    input:
        dotFile = "{outdir}/machina/{mouse}/{cp}/" + f"{config['primaryTissue'][mouse]}-G-{config['primaryTissue'][mouse]}-R.dot"
    output:
        migrationGraph = "{outdir}/machina/{mouse}/{cp}/migration_graph.pdf"
    params:
        outputdir = "{outdir}/machina/{mouse}/{cp}",
        primaryTissue = lambda wildcards: config['primaryTissue'][wildcards.mouse],
        scripts = config['scripts'],
        threads = 1
    conda:
        "../../envs/networkx.yaml"
    shell:
        """
        # if machina did not run due to no primary tissue, then create an empty file to satisfy snakemake
        if [ ! -s {input.dotFile} ]; then
            touch {output.migrationGraph}
        else
            python {params.scripts}/plotting/plot_migration_graph_from_dot.py {input.dotFile} {params.outputdir}/migration_graph.pdf
        fi
        """

rule prepMetient:
    input:
        lamlTree = "{outdir}/laml/{mouse}/{cp}/laml_trees.nwk",
        tissues = "{outdir}/metastabayes/{mouse}/{cp}/{cp}_tip_tissues.csv"
    output:
        lamlTreeNoOrigin = "{outdir}/metient/{mouse}/{cp}/laml_tree_no_origin.txt",
        metientTree = "{outdir}/metient/{mouse}/{cp}/tree.txt",
        metientTsv = "{outdir}/metient/{mouse}/{cp}/metadata.tsv"
    params:
        primaryTissue = lambda wildcards: config['primaryTissue'][wildcards.mouse],
        scripts = config['scripts'],
        outputdir = "{outdir}/metient/{mouse}/{cp}",
        threads = 1
    conda:
        "../../envs/compare_trees.yaml"
    shell:
        """
        # remove fake root from tree
        fixed_newick=$(sed "s/);//g" {input.lamlTree})
        fixed_newick="${{fixed_newick:1}});"
        last_branch=$(echo "$fixed_newick" | grep -oP ':[0-9]+\.[0-9]+(?=\)\;)' | tail -1 | tr -d ':')
        second_last_branch=$(echo "$fixed_newick" | grep -oP ':[0-9]+\.[0-9]+(?=\))' | tail -2 | head -1 | tr -d ':')
        new_branch=$(echo "$last_branch + $second_last_branch" | bc)
        modified_newick=$(echo "$fixed_newick" | sed -r "s/$second_last_branch\):$last_branch/0$new_branch/g")
        echo "$modified_newick" > {output.lamlTreeNoOrigin}

        # format tsv file and edge list
        python {params.scripts}/metient/format_metient.py {output.lamlTreeNoOrigin} {input.tissues} {params.primaryTissue} {params.outputdir}
        """

rule runMetient:
    input:
        metientTree = "{outdir}/metient/{mouse}/{cp}/tree.txt",
        metientTsv = "{outdir}/metient/{mouse}/{cp}/metadata.tsv"
    output:
        metientResults = "{outdir}/metient/{mouse}/{cp}/{mouse}_{cp}_{primaryTissue}_migration_graphs.txt",
    params:
        scripts = config['scripts'],
        outputdir = "{outdir}/metient/{mouse}/{cp}",
        threads = 100
    singularity:
        "../../envs/metient.sif"
    shell:
        """
        # check to make sure there is atleast one metastasis site in the CP
        sites=$(tail -n +2 {input.metientTsv} | cut -f6 | sort | uniq | tr '\\n' ' ')
        if echo "$sites" | grep -qw "metastasis"; then
            python {params.scripts}/metient/run_metient.py {input.metientTsv} {input.metientTree} {wildcards.mouse}_{wildcards.cp} {wildcards.primaryTissue} {params.outputdir}
        else
            echo "No metastasis site, so not running metient"
            touch {output.metientResults}
        fi
        """

rule callMigrationComigrationCounts:
    input:
        graphPosterior = "{outdir}/metastabayes/{mouse}/{cp}/posterior_prob_graph.csv",
        machinaEdgeFile = "{outdir}/machina/{mouse}/{cp}/" + f"{config['primaryTissue'][mouse]}-G-{config['primaryTissue'][mouse]}-R.tree",
        metientResults = "{outdir}/metient/{mouse}/{cp}/{mouse}_{cp}_{primaryTissue}_migration_graphs.txt"
    output:
        migrationCountCsv = "{outdir}/compare_migration_counts/{mouse}_{cp}_migration_counts.csv",
        migrationTopologyCsv = "{outdir}/compare_migration_counts/{mouse}_{cp}_topology_classifications.csv"
    params:
        outdir = "{outdir}/compare_migration_counts",
        name = "{mouse}_{cp}",
        primaryTissue = lambda wildcards: config['primaryTissue'][wildcards.mouse],
    conda:
        "../../envs/compare_trees.yaml"
    shell:
        """
        python {config['scripts']}/formatting/call_migration_counts_machian_metient_metastabayes.py {input.machinaEdgeFile} {input.metientResults} {input.graphPosterior} {params.primaryTissue} {params.outdir} {params.name}
        """

rule aggregateMigrationCounts:
    input:
        migrationCountCsvs = [expand("{outdir}/compare_migration_counts/{mouse}_{cp}_migration_counts.csv", mouse=m, cp=get_elements_from_file(f"{config['outdir']}/metastabayes/{m}"), outdir=config['outdir']) for m in mice]
    output:
        aggregatedMigrationCounts = "{outdir}/compare_migration_counts/migration_counts_all.csv",
    shell:
        """
        # write header to output file
        echo "name,machina_migrations,machina_comigrations,metient_migrations,metient_comigrations,metastabayes_migrations,metastabayes_comigrations" > {output.aggregatedMigrationCounts}

        # Loop through each input file and append the second line to the output file
        for file in {input.migrationCountCsvs}; do
            sed -n '2p' $file >> {output.aggregatedMigrationCounts}
            echo "" >> {output.aggregatedMigrationCounts}
        done
        """

rule plotMigrationCounts:
    input:
        aggregatedMigrationCounts = "{outdir}/compare_migration_counts/migration_counts_all.csv"
    output:
        migrationCountPlot = "{outdir}/compare_migration_counts/migration_counts_all.pdf"
    conda:
        "../../envs/matplotlib.yaml"
    shell:
        """
        python {config['scripts']}/plotting/plot_migrations_comigrations_boxplot.py {input.aggregatedMigrationCounts}
        """

rule aggregateTopologyClassifications:
    input:
        migrationTopologyCsvs = expand("{outdir}/compare_migration_counts/{mouse}_{cp}_topology_classifications.csv", mouse=mice, cp=get_elements_from_file(f"{config['outdir']}/metastabayes/{m}"), outdir=config['outdir'])
    output:
        aggregatedTopologyClassifications = "{outdir}/compare_migration_counts/topology_classifications_all.csv",
    shell:
        """
        # write header to output file
        echo "name,machina_met_to_met,machina_reseeding,metient_met_to_met,metient_reseeding,metastabayes_met_to_met,metastabayes_reseeding" > {output.aggregatedMigrationCounts}

        # Loop through each input file and append the second line to the output file
        for file in {input.migrationTopologyCsvs}; do
            sed -n '2p' $file >> {output.aggregatedTopologyClassifications}
            echo "" >> {output.aggregatedTopologyClassifications}
        done
        """

rule plotTopologyClassifications:
