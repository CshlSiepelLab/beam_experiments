
import os
import sys
import glob

# get mouse ids and fastq files from input fastq dir
mice = []
mouse_fastqs = {}
for file in glob.glob(os.path.join(config['fastqPath'], "*.fastq.gz")):
    mouse = os.path.basename(file).split("_")[0]
    if mouse not in mice:
        mice.append(mouse)
    if mouse not in mouse_fastqs:
        mouse_fastqs[mouse] = []
    mouse_fastqs[mouse].append(file)


def get_elements_from_file(path):
    filename = f"{path}/cp_list.txt"
    with open(filename) as f:
        return [line.strip() for line in f if set(list(line.strip().replace("CP", ""))) != set('0')]

rule all:
    input:
        expand("{outdir}/evotracer/{mouse}/asv_analysis/character_matrix.csv", outdir=config['outdir'], mouse=mice),
        # expand("{outdir}/evotracer/{mouse}/hist_freq_indels.pdf", outdir=config['outdir'], mouse=mice),
        expand("{outdir}/beam/{mouse}/cp_list.txt", outdir=config['outdir'], mouse=mice),
        expand("{outdir}/asv_counts_per_cp_boxplot.pdf", outdir=config['outdir']),
        [expand("{outdir}/cassiopeia_greedy/{mouse}/{cp}/cassiopeia_greedy_inferred.nwk", outdir=config['outdir'], 
               cp=get_elements_from_file(f"{config['outdir']}/beam/{m}"), mouse=m) for m in mice],
        [expand("{outdir}/laml/{mouse}/{cp}/laml_trees.nwk", outdir=config['outdir'],
                cp=get_elements_from_file(f"{config['outdir']}/beam/{m}"), mouse=m) for m in mice],
        [expand("{outdir}/beam/{mouse}/{cp}/terminal_{num}.log", outdir=config['outdir'],
                cp=get_elements_from_file(f"{config['outdir']}/beam/{m}"), num=range(1, config['numChains']+1), mouse=m) for m in mice],
        [expand("{outdir}/beam/{mouse}/{cp}/combined.log", outdir=config['outdir'],
                cp=get_elements_from_file(f"{config['outdir']}/beam/{m}"), mouse=m) for m in mice],
        [expand("{outdir}/beam/{mouse}/{cp}/probability_migration_graph.pdf", outdir=config['outdir'],
                cp=get_elements_from_file(f"{config['outdir']}/beam/{m}"), mouse=m) for m in mice],
        [expand("{outdir}/beam/{mouse}/{cp}/combined_migration_graph_1.pdf", outdir=config['outdir'],
                cp=get_elements_from_file(f"{config['outdir']}/beam/{m}"), mouse=m) for m in mice],
        [expand("{outdir}/beam/{mouse}/{cp}/posterior_expected_over_parsimony/posterior_expected_migration_counts_over_parsimony.csv", outdir=config['outdir'],
                    cp=get_elements_from_file(f"{config['outdir']}/beam/{m}"), mouse=m) for m in mice],
        [expand("{outdir}/machina/{mouse}/{cp}/migration_graph.pdf", outdir=config['outdir'],
                cp=get_elements_from_file(f"{config['outdir']}/beam/{m}"), mouse=m) for m in mice],
        # expand("{outdir}/machina/{mouse}/plots/machina_migration_plots/trans_mx_all.pdf", outdir=config['outdir'], mouse=mice),
        [expand("{outdir}/metient/{mouse}/{cp}/{mouse}_{cp}_{primaryTissue}_migration_graphs.txt", outdir=config['outdir'],
                cp=get_elements_from_file(f"{config['outdir']}/beam/{m}"), mouse=m, primaryTissue=config['primaryTissue'][m],) for m in mice],
        [expand("{outdir}/parsimony_tissue_inference/{mouse}/{cp}/parsimony_tissues_random.pdf", outdir=config['outdir'],
