rule prepMachina:
    input:
        lamlTreeNoBranchLengths = "{outdir}/laml/{mouse}/{cp}/laml_trees_no_branch_lengths.nwk",
        tissues = "{outdir}/beam/{mouse}/{cp}/{cp}_tip_tissues.csv"
    output:
        tissuesTsv = "{outdir}/machina/{mouse}/{cp}/leaf_tissues.tsv",
        labeling = "{outdir}/machina/{mouse}/{cp}/laml_trees_no_branch_lengths.labeling",
        colors = "{outdir}/machina/{mouse}/{cp}/laml_trees_no_branch_lengths_colors.txt",
        tree = "{outdir}/machina/{mouse}/{cp}/laml_trees_no_branch_lengths.tree",
    params:
        scripts = config['scripts'],
        outputdir = "{outdir}/machina/{mouse}/{cp}",
        primaryTissue = lambda wildcards: config['primaryTissue'][wildcards.mouse],
        threads = 1
    singularity:
        '../../envs/simulate.sif'
    shell:
        """
        # convert csv to tsv for leaf labels
        sed 's/,/\\t/g' {input.tissues} > {output.tissuesTsv}

        # prep machina inputs
        python {params.scripts}/machina/prep_machina.py {input.lamlTreeNoBranchLengths} {params.outputdir} {params.primaryTissue} {output.tissuesTsv}
        """

rule runMachina:
    input:
        tissuesTsv = "{outdir}/machina/{mouse}/{cp}/leaf_tissues.tsv",
        labeling = "{outdir}/machina/{mouse}/{cp}/laml_trees_no_branch_lengths.labeling",
        colors = "{outdir}/machina/{mouse}/{cp}/laml_trees_no_branch_lengths_colors.txt",
        tree = "{outdir}/machina/{mouse}/{cp}/laml_trees_no_branch_lengths.tree",
    output:
        machinaResults = "{outdir}/machina/{mouse}/{cp}/machina_results.txt",
        dotFile = "{outdir}/machina/{mouse}/{cp}/" + f"{config['primaryTissue'][mouse]}-G-{config['primaryTissue'][mouse]}-R.dot",
        machinaEdgeFile = "{outdir}/machina/{mouse}/{cp}/" + f"{config['primaryTissue'][mouse]}-G-{config['primaryTissue'][mouse]}-R.tree"
    params:
        scripts = config['scripts'],
        outputdir = "{outdir}/machina/{mouse}/{cp}",
        primaryTissue = lambda wildcards: config['primaryTissue'][wildcards.mouse],
        threads = 25
    conda:
        "../../envs/machina.yaml"
    shell:
        """
        # load Gurobi license (specific to CSHL HPC; will need to be modified on other systems)
        module load EBModules
        module load Gurobi
        
        unique_tissues=$(cut -f2 {input.labeling} | sort | uniq)
        num_unique_tissues=$(echo "$unique_tissues" | wc -l)

        if [ "$num_unique_tissues" -gt 1 ]; then

            # check if primary tissue is in the labeling file
            if grep -q "{params.primaryTissue}" {input.labeling}; then
                {params.scripts}/machina/run_machina_tr.sh --threads {params.threads} --edges {input.tree} --labels {input.labeling} --colors {input.colors} --primary-tissue {params.primaryTissue} --outdir {params.outputdir}
                
                # move the dot and edge file to the primary tissue output to satisfy the snakemake since the file label might be different
                cp {params.outputdir}/{params.primaryTissue}-G-{params.primaryTissue}-R.dot {output.dotFile}
                cp {params.outputdir}/{params.primaryTissue}-G-{params.primaryTissue}-R.tree {output.machinaEdgeFile}
            else
                most_common_tissue=$(cut -f2 {input.labeling} | sort | uniq -c | sort -nr | head -n 1 | awk '{{print $2}}')
                echo "The {params.primaryTissue} is not in the tissue labels. Using the most common tissue $most_common_tissue as the primary tissue."
                {params.scripts}/machina/run_machina_tr.sh --threads {params.threads} --edges {input.tree} --labels {input.labeling} --colors {input.colors} --primary-tissue $most_common_tissue --outdir {params.outputdir}

                # move the dot and edge file to the primary tissue output to satisfy the snakemake since the file label will be different due to the different primary tissue
                cp {params.outputdir}/$most_common_tissue-G-$most_common_tissue-R.dot {output.dotFile}
                cp {params.outputdir}/$most_common_tissue-G-$most_common_tissue-R.tree {output.machinaEdgeFile}
            fi
        else
            echo "Only one unique tissue found in the labeling file, so not enough to run Machina. Exiting."
            touch {output.machinaEdgeFile}
            touch {output.dotFile}
            touch {output.machinaResults}
        fi
        """

rule summarizeMachina:
    input:
        # comment out below to not wait for all machina results to be generated before running this rule, which is the default behavior
        machinaResults = lambda wildcards: ["{outdir}/machina/{mouse}/{cp}/machina_results.txt".format(outdir=config['outdir'], mouse=wildcards.mouse, cp=cp) for cp in get_elements_from_file(f"{config['outdir']}/beam/{wildcards.mouse}")],
        asv_stat = "{outdir}/evotracer/{mouse}/phylogeny_analysis/phylogeny_del_ins/asv_stat.csv",
        cp_list = "{outdir}/beam/{mouse}/cp_list.txt"
    output:
        resultsMachina = "{outdir}/machina/{mouse}/all_results.txt",
        extendedMachina = "{outdir}/machina/{mouse}/all_results_extended.txt",
        migrationMachina = "{outdir}/machina/{mouse}/migration.txt",
        seedingMachina = "{outdir}/machina/{mouse}/seeding_topology.txt"
    params:
        threads = 1,
        scripts = config['scripts'],
        outdir = "{outdir}/machina/{mouse}",
        primary_tissue = lambda wildcards: config['primaryTissue'][wildcards.mouse],
    conda:
        "../../envs/machina.yaml"
    shell:
        """
        while read CP; do 
            cp_dir="{params.outdir}/${{CP}}"

            # Check if machina converged for this CP
            if [ ! -f "${{cp_dir}}/{params.primary_tissue}-G-{params.primary_tissue}-R.dot" ] || [ ! -f "${{cp_dir}}/machina_results.txt" ] || [ ! -s "${{cp_dir}}/machina_results.txt" ]; then
                continue
            fi

            # Consider when the primary tissue is not an option for the CP, so machina uses the most common tissue in the CP tip labels
            cp_primary_tissue=$(find "${{cp_dir}}" -type f -name "*R.txt" | rev | cut -d'/' -f1 | rev | cut -d'-' -f1)

            cat ${{cp_dir}}/laml_trees_no_branch_lengths_colors.txt| tr '\\t' ' ' | sed "s/^/${{CP}} color /"
            best=`grep "PS" "${{cp_dir}}/machina_results.txt" | tail -1|cut -f6| sed 's/[a-z]//g'`
            best_full=`grep "PS" "${{cp_dir}}/machina_results.txt" | tail -1|cut -f6`

            echo "${{CP}} model ${{best_full}} NA"
            cat ${{cp_dir}}/${{cp_primary_tissue}}-G-${{cp_primary_tissue}}-R.tree | sed "s/^/${{CP}} migration /" | tr '\\t' ' '
            grep label ${{cp_dir}}/${{cp_primary_tissue}}-T-${{cp_primary_tissue}}-R.dot | sed 's/.*color=//' | sed 's/,label="/ /' | sed 's/".*//' | cut -d'\\' -f1 | sed "s/^/${{CP}} label /" | tr '\\t' ' ' | awk 'NF==4'
            
            tail -n +2 ${{cp_dir}}/${{cp_primary_tissue}}-T-${{cp_primary_tissue}}-R.tree | awk '{{$1=$1; print}}' | awk '{{if (NF==1) $0="0 "$0}}1' > ${{cp_dir}}/modified_tree.txt
            cat ${{cp_dir}}/modified_tree.txt | sed "s/^/${{CP}} tree /" | tr '\\t' ' '
            rm ${{cp_dir}}/modified_tree.txt
        done < {input.cp_list} | tr '\\t' ' ' >> {output.resultsMachina}

        sed -i 's/\\t/ /g' {output.resultsMachina}

        python {params.scripts}/machina/print_seeding_topology.py {output.resultsMachina} {params.primary_tissue} > {output.seedingMachina}

        python {params.scripts}/machina/count_migrations.py {output.resultsMachina} > {output.migrationMachina}

        python {params.scripts}/machina/add_freq_prob_to_results.py {output.migrationMachina} {input.asv_stat} {output.resultsMachina} > {output.extendedMachina}
        """

rule plotMachina:
    input:
        extendedMachina = "{outdir}/machina/{mouse}/all_results_extended.txt",
        migrationMachina = "{outdir}/machina/{mouse}/migration.txt",
        seedingMachina = "{outdir}/machina/{mouse}/seeding_topology.txt"
    output:
        machinaRateMatrix = "{outdir}/machina/{mouse}/plots/machina_migration_plots/trans_mx_all.pdf",
        machinaSeedingTopology = "{outdir}/machina/{mouse}/plots/machina_seeding_topology/seed_topology_pie_per_cp_all.pdf",
    params:
