rule splitCPs:
    input:
        char_matrix = "{outdir}/evotracer/{mouse}/asv_analysis/character_matrix.csv",
        asv_stat = "{outdir}/evotracer/{mouse}/phylogeny_analysis/phylogeny_del_ins/asv_stat.csv",
        mut_dict = "{outdir}/evotracer/{mouse}/asv_analysis/mutation_profile_map.csv",
    output:
        cpList = "{outdir}/beam/{mouse}/cp_list.txt",
        mutation_dict = "{outdir}/beam/{mouse}/mutation_dict.tsv",
    params:
        outdir = "{outdir}/beam/{mouse}",
        scripts = config['scripts'],
        threads = 1
    shell:
        """
        # prep mutation dictionary for the mouse overall
        sed 's/\",/\\t/g' {input.mut_dict} | sed 's/\"//g' > {params.outdir}/mutation_dict.tsv

        cps=$(tail -n +2 {input.asv_stat} | cut -d',' -f30 | sort | uniq | tr '\\n' ' ')
        for cp in $cps; do

            # make cp dir
            cpOutdir={params.outdir}/${{cp}}
            mkdir -p $cpOutdir

            # get ASVs for the cp
            asvs=$(tail -n +2 {input.asv_stat} | grep -w "$cp" | cut -d',' -f1 | sort | uniq | tr '\\n' ' ')

            # setup temp matrix and tissues headers
            tempMatrix=$cpOutdir/temp_matrix.tsv
            head -n 1 {input.char_matrix} | sed 's/,/\\t/g' | sed 's/\"//g' > $tempMatrix
            tempTissues=$cpOutdir/temp_tissues.tsv
            echo -e "group_name\\ttissues" > $tempTissues

            # subset matrix and tissues for each cp to only retain ASVs for that CP
            for asv in $asvs; do
                sed 's/,/\\t/g' {input.char_matrix} | sed 's/\"//g' | grep -w "$asv" >> $tempMatrix
                tail -n +2 {input.asv_stat} | cut -d',' -f1-2 | grep -w "$asv" | awk -F',' '{{if (!seen[$1","$2]++) a[$1]=a[$1]","$2}} END {{for (i in a) {{split(a[i], b, ","); delete seen; c=""; for (j in b) if (b[j] != "" && !seen[b[j]]++) c=(c == "" ? b[j] : c","b[j]); print i"\\t"c}}}}' >> ${{tempTissues}}
            done

            # track all CPs as they finish pre-processing
            echo "$cp" >> {output.cpList}
        done
        """

rule plotCpNumAsvs:
    input:
        cpLists = expand("{outdir}/beam/{mouse}/cp_list.txt", outdir=config['outdir'], mouse=mice)
    output:
        asvCountPdf = "{outdir}/asv_counts_per_cp_boxplot.pdf"
    params:
        outdir = "{outdir}",
        scripts = config['scripts'],
        threads = 1,
        max_tips = config['downsampleTipNumThreshold'],
    conda:
        "../../envs/matplotlib.yaml"
    shell:
        """
        # Count the number of ASVs in each CP for each mouse
        asv_count_csv={params.outdir}/asv_counts_per_cp.csv
        echo "mouse,cp,num_asvs" > $asv_count_csv

        files=$(find {params.outdir}/beam -type f -name "temp_tissues.tsv")

        for file in $files; do
            mouse=$(echo $file | rev | cut -d'/' -f3 | rev)
            cp=$(echo $file | rev | cut -d'/' -f2 | rev)
            num_asvs=$(($(wc -l < $file) - 1))
            echo "$mouse,$cp,$num_asvs" >> $asv_count_csv
        done

        # Plot the number of ASVs in each CP for each mouse
        python {params.scripts}/plotting/plot_nowak_data_downsampling_tip_counts.py $asv_count_csv {params.max_tips}
        """

rule downsampleInputsTree:
    input:
        cpList = "{outdir}/beam/{mouse}/cp_list.txt",
        evotracerCassiopeiaTree= "{outdir}/evotracer/{mouse}/phylogeny_analysis/phylogeny_del_ins/tree_all_clones.newick",
        temp_matrix = "{outdir}/beam/{mouse}/{cp}/temp_matrix.tsv",
        temp_tissues = "{outdir}/beam/{mouse}/{cp}/temp_tissues.tsv"
    output:
        downsampledMatrix = "{outdir}/beam/{mouse}/{cp}/downsampled_char_matrix.tsv",
        downsampledTissues = "{outdir}/beam/{mouse}/{cp}/downsampled_tissue_labels.tsv"
    params:
        outputdir = "{outdir}/beam/{mouse}/{cp}",
        scripts = config['scripts'],
        experimentTime = lambda wildcards: config['experimentTime'][wildcards.mouse],
        max_tips = config['downsampleTipNumThreshold'], # downsampling only occurs if the number of tips is greater than this
        threshold = config['downsampleDistanceThreshold'], # height of the tree for which downsampling occurs below it
        threads = 25
    conda:
        "../../envs/laml.yaml"
    shell:
        """
        # Check the number of rows in temp_tissues
        num_tips=$(tail -n +2 {input.temp_tissues} | wc -l)

        # If the number of rows is greater than 150, downsample
        if [ "$num_tips" -gt {params.max_tips} ]; then
            echo "Number of tips is greater than {params.max_tips}. Downsampling with a tree threshold of {params.threshold}."

            # subset the existing cassiopeia tree
            asv_names=$(tail -n +2 {input.temp_matrix} | cut -f1 | grep -v '^$' | tr '\n' ',' | sed 's/,$//')
            subset_cas_tree={params.outputdir}/subset_evotracer_cassiopeia_tree.nwk
            python {params.scripts}/formatting/subset_evotracer_cassiopeia_tree.py {input.evotracerCassiopeiaTree} $asv_names $subset_cas_tree

            # use the cassiopeia tree to get a laml tree for downsampling
            cp {input.temp_matrix} {params.outputdir}/matrix.csv
            sed -i 's/-1/?/g; s/\t/,/g' {params.outputdir}/matrix.csv

            run_laml -c {params.outputdir}/matrix.csv -t $subset_cas_tree -o {params.outputdir}/{wildcards.mouse}_{wildcards.cp}_laml --timescale {params.experimentTime} --parallel

            # remove origin from the laml tree
            newick=$(sed 's/):.*$//g' {params.outputdir}/{wildcards.mouse}_{wildcards.cp}_laml_trees.nwk)
            lamlTreeNoOrigin={params.outputdir}/{wildcards.mouse}_{wildcards.cp}_laml_trees_no_origin.nwk
            echo "${{newick:1}}" > $lamlTreeNoOrigin
            echo ");" >> $lamlTreeNoOrigin

            # downsample the tree
            python {params.scripts}/formatting/downsample_tree.py {input.temp_matrix} $lamlTreeNoOrigin {input.temp_tissues} {params.threshold} {params.outputdir}/downsampled

        else
            echo "Number of tips is less than {params.max_tips}. No downsampling."
            cp {input.temp_matrix} {output.downsampledMatrix}
            cp {input.temp_tissues} {output.downsampledTissues}
        fi
        """

rule prepBeamInputs:
    input:
        downsampledMatrix = "{outdir}/beam/{mouse}/{cp}/downsampled_char_matrix.tsv",
        downsampledTissues = "{outdir}/beam/{mouse}/{cp}/downsampled_tissue_labels.tsv",
        mutation_dict = "{outdir}/beam/{mouse}/mutation_dict.tsv"
    output:
        fasta = "{outdir}/beam/{mouse}/{cp}/{cp}.fasta",
        dates = "{outdir}/beam/{mouse}/{cp}/{cp}_date_traits.csv",
        tissues = "{outdir}/beam/{mouse}/{cp}/{cp}_tip_tissues.csv",
        editRateProportions = "{outdir}/beam/{mouse}/{cp}/{cp}_edit_rate_proportions.txt",
        expandedClonesMatrix = "{outdir}/beam/{mouse}/{cp}/expanded_clones_matrix.tsv",
    params:
        outdir = "{outdir}/beam/{mouse}/{cp}",
        scripts = config['scripts'],
        experimentTime = lambda wildcards: config['experimentTime'][wildcards.mouse],
        modelDropouts = config['modelDropouts'],
        threads = 1,
    conda:
        "../../envs/networkx.yaml"
    shell:
        """
        # make mutations successive for each matrix and provide an updated dictionary of int to mutations
        python {params.scripts}/formatting/matrix_to_successive_matrix.py {input.downsampledMatrix} {input.mutation_dict} {params.outdir}

        # expand clones found in multiple tissues to separate entries
        python {params.scripts}/formatting/expand_clones_multiple_tissues.py {params.outdir}/successive_char_matrix.csv {input.downsampledTissues} {params.outdir}
        matrixFile={params.outdir}/expanded_clones_matrix.tsv
        tissuesFile={params.outdir}/expanded_clones_tissues.tsv

        # make output files
        fasta={params.outdir}/{wildcards.cp}.fasta
        dates={params.outdir}/{wildcards.cp}_date_traits.csv
        tissues={params.outdir}/{wildcards.cp}_tip_tissues.csv
        editRateProportions={params.outdir}/{wildcards.cp}_edit_rate_proportions.txt

        # write tip traits to new csv
        tail -n +2 $tissuesFile | grep -v '^$' | cut -f1,2 | tr '\\t' ',' > $tissues

        # write date trait
        tail -n +2 $tissuesFile | grep -v '^$' | cut -f1 | paste -d',' - <(yes {params.experimentTime} | head -n $(( $(wc -l < $tissuesFile) - 1 ))) > $dates

        # get edit rate proportions for new mutation entries, relative so they all sum to 1.0
        all_muts=$(tail -n +2 $matrixFile | grep -v '^$' | cut -f2- | sed 's/-1/0/g' | tr '\\t' ' ' | tr '\\n' ' ')
        total_count=$(echo $all_muts | tr ' ' '\\n' | grep -wv "0" | wc -l)
        uniq_count=$(echo $all_muts | tr ' ' '\\n' | sort | uniq | grep -wv "0" | wc -l)
        count_sum=$( echo $all_muts | tr ' ' '\\n' | grep -wv "0" | wc -l )
        
        for element in $(seq 1 $uniq_count); do
            echo "START"
            echo "element: $element"
            if echo "$all_muts" | tr ' ' '\\n' | grep -w "$element"; then
                echo "FOUND"
                count=$(echo "$all_muts" | tr ' ' '\\n' | grep -wc "$element")
                proportion=$(echo "scale=10; $count / $count_sum" | bc)
            else
                echo "NOT FOUND"
                count=0
                proportion=0
            fi
            echo "count: $count"
            echo "proportion: $proportion"
            echo "$proportion" >> $editRateProportions
        done

        # Format fasta with the option to replace site dropouts with the new int representation to be modeled by an independent silencing rate, or 0 to not model dropouts and just consider them as unedited sites
        if [ "{params.modelDropouts}" == "True" ] || [ "{params.modelDropouts}" == "true" ]; then
            # to model dropouts, use the highest mutation int representation and add 1 since the dropout column is the last in the rate matrix
            dropoutMutNum=$(( uniq_count + 1 ))
            tail -n +2 $matrixFile | grep -v '^$' | sed "s/-1/$dropoutMutNum/g" | awk '{{printf ">"$1"\\n"; for (i=2; i<=NF; i++) printf (i==NF ? $i"\\n" : $i",")}}' > $fasta
        else
            # to not model dropouts
            tail -n +2 $matrixFile | grep -v '^$' | sed 's/-1/0/g' | awk '{{printf ">"$1"\\n"; for (i=2; i<=NF; i++) printf (i==NF ? $i"\\n" : $i",")}}' > $fasta
        fi     
        """

rule runCassiopeia:
    input:
        cpList = "{outdir}/beam/{mouse}/cp_list.txt",
        expandedClonesMatrix = "{outdir}/beam/{mouse}/{cp}/expanded_clones_matrix.tsv"
    output:
        "{outdir}/cassiopeia_greedy/{mouse}/{cp}/cassiopeia_greedy_inferred.nwk"
    params:
        cassiopeia_script = os.path.join(config['scripts'], "cassiopeia/cassiopeia_greedy.py"),
        outputdir = "{outdir}/cassiopeia_greedy/{mouse}/{cp}",
        threads = 5
    singularity:
        "../../envs/simulate.sif"
    shell:
        """
        # run cassiopeia greedy
        python {params.cassiopeia_script} {input.expandedClonesMatrix} {params.outputdir}
        """

rule runLAML:
    input:
        cpList = "{outdir}/beam/{mouse}/cp_list.txt",
        expandedClonesMatrix = "{outdir}/beam/{mouse}/{cp}/expanded_clones_matrix.tsv",
        casTree = "{outdir}/cassiopeia_greedy/{mouse}/{cp}/cassiopeia_greedy_inferred.nwk"
    output:
        lamlTree = "{outdir}/laml/{mouse}/{cp}/laml_trees.nwk",
        lamlAnnotations = "{outdir}/laml/{mouse}/{cp}/laml_annotations.txt",
        lamlTreeNoBranchLengths = "{outdir}/laml/{mouse}/{cp}/laml_trees_no_branch_lengths.nwk"
    params:
        outputdir = "{outdir}/laml/{mouse}/{cp}",
        experimentTime = lambda wildcards: config['experimentTime'][wildcards.mouse],
        threads = 25
    conda:
        "../../envs/laml.yaml"
    shell:
        """
        # copy matrix and replace -1 with ? for missing data
        cp {input.expandedClonesMatrix} {params.outputdir}/matrix.csv
        sed -i 's/-1/?/g; s/\t/,/g' {params.outputdir}/matrix.csv

        # run laml
        run_laml -c {params.outputdir}/matrix.csv -t {input.casTree} -o {params.outputdir}/laml --timescale {params.experimentTime} --parallel

        # obtain newick without branch lengths
        sed 's/:\([0-9]\+\.\?\([0-9]\+\)\?\)//g' {output.lamlTree} > {output.lamlTreeNoBranchLengths}
        """

rule runBeam:
    input:
        cpList = "{outdir}/beam/{mouse}/cp_list.txt",
        fasta = "{outdir}/beam/{mouse}/{cp}/{cp}.fasta",
        dates = "{outdir}/beam/{mouse}/{cp}/{cp}_date_traits.csv",
        tissues = "{outdir}/beam/{mouse}/{cp}/{cp}_tip_tissues.csv",
        editRateProportions = "{outdir}/beam/{mouse}/{cp}/{cp}_edit_rate_proportions.txt",
        lamlTree = "{outdir}/laml/{mouse}/{cp}/laml_trees.nwk"
    output:
        terminalLog = "{outdir}/beam/{mouse}/{cp}/terminal_{num}.log",
        beamLog = "{outdir}/beam/{mouse}/{cp}/chain_{num}.log",
        beamResult = "{outdir}/beam/{mouse}/{cp}/chain_{num}.trees"
    params:
        xml = config['xml'],
        fileDir = "{outdir}/beam/{mouse}/{cp}",
        beamJar = config['beamJar'],
        experimentTime = lambda wildcards: config['experimentTime'][wildcards.mouse],
        primaryTissue = lambda wildcards: config['primaryTissue'][wildcards.mouse],
        threads = 5,
        mcmclength = config['mcmcLength']
    shell:
        """
        cp {params.xml} {params.fileDir}/{wildcards.num}.xml

        # calculate necessary inputs for the editing model
        initialEditRates=$(cat {input.editRateProportions} | tr '\n' ' ')
        array=($initialEditRates)
        numEditRates=${{#array[@]}}
        numEditRatesPlusTwo=$(( numEditRates + 2 ))

        # format tissue information
        unique_tissues=$(cat {input.tissues} | cut -d',' -f2 | sort | uniq)
        numTissues=$(echo $unique_tissues | tr ' ' '\n' | wc -l)

        # set the mcmc chain length based on the number of tips in the tree
        # use a minimum of 5 million and a maximum of a user specified length
        numTips=$(grep -c '^>' {input.fasta})
        mcmclength=$(( numTips * 250000 ))
        if (( mcmclength > {params.mcmclength} )); then
            mcmclength={params.mcmclength}
        elif (( mcmclength < 5000000 )); then
            mcmclength=5000000
        fi

        # To set a fixed length temporarily
        mcmclength=200000000

        # if numTissues is 1, then the model will not run, so we need to add a dummy tissue
        if [[ $numTissues -eq 1 ]]; then
            # if the primary already exists then add a dummy
            if echo "$unique_tissues" | grep -w "{params.primaryTissue}"; then
                unique_tissues="$unique_tissues dummy"
            # if not, then add the primary as the dummy
            else
                unique_tissues="{params.primaryTissue} $unique_tissues"
            fi
            numTissues=$(( numTissues + 1 ))
        fi

        # force the known known primary tissue at the origin for root frequencies in the likelihood calculation
        sorted_unique_tissues="{params.primaryTissue} $(echo $unique_tissues | tr ' ' '\n' | grep -v '^{params.primaryTissue}$' | tr '\n' ' ')"
        if ! echo "$unique_tissues" | grep -qw "{params.primaryTissue}"; then
            numTissues=$(( numTissues + 1 ))
        fi
        tissueRootFreqs=$(for i in $(seq 1 $numTissues); do if [[ "$i" = "1" ]]; then echo -n "1 "; else echo -n "0 "; fi; done)

        numTissueRates=$(( numTissues * (numTissues - 1) ))
        equalTissueRates=$(echo "scale=10; 1.0 / $numTissueRates" | bc -l)
        equalTissueFreqs=$(echo "scale=10; 1.0 / $numTissues" | bc -l)

        tissueCodeMap=""
        trailingCodeMap="? = "
        i=0
        for tissue in $sorted_unique_tissues; do
            tissueCodeMap+="$tissue=$i,"
            trailingCodeMap+="$i "
            i=$((i+1))
        done
        tissueCodeMap+="${{trailingCodeMap}}"

        # for some reason this cannot be taken in at the command line, likely because the = signs are problematic and not taken as a single string
        sed -i "s/\$(tissueCodeMap)/$tissueCodeMap/g" {params.fileDir}/{wildcards.num}.xml

        # use LAML starting tree
        # remove node names from newick and the origin node
        newick=$(cat {input.lamlTree} | sed 's/node[0-9]*:/:/g' | sed 's/^.//' | sed 's/..$//')

        java -Xmx10g -jar {params.beamJar} \
        -threads {params.threads} \
        -overwrite \
        -working \
        -D inName={wildcards.cp} \
        -D fileDir={params.fileDir} \
        -D newick=\"$newick\" \
        -D generations={params.experimentTime} \
        -D numEditRates=\"$numEditRates\" \
        -D numEditRatesPlusTwo=\"$numEditRatesPlusTwo\" \
        -D initialEditRates=\"$initialEditRates\" \
        -D numTissueRates=\"$numTissueRates\" \
        -D numTissues=\"$numTissues\" \
        -D equalTissueFreqs=\"$equalTissueFreqs\" \
        -D tissueRootFreqs=\"$tissueRootFreqs\" \
        -D mcmclength=\"$mcmclength\" \
        -D outname=chain_{wildcards.num} \
        {params.fileDir}/{wildcards.num}.xml > {output.terminalLog}
        """

rule combineBeamChains:
    input:
        terminalLog = lambda wildcards: expand("{outdir}/beam/{mouse}/{cp}/terminal_{num}.log", num=range(1, config['numChains']+1), cp=wildcards.cp, mouse=wildcards.mouse, outdir=wildcards.outdir),
        beamLogs = lambda wildcards: expand("{outdir}/beam/{mouse}/{cp}/chain_{num}.log", num=range(1, config['numChains']+1), cp=wildcards.cp, mouse=wildcards.mouse, outdir=wildcards.outdir),
        beamResults = lambda wildcards: expand("{outdir}/beam/{mouse}/{cp}/chain_{num}.trees", num=range(1, config['numChains']+1), cp=wildcards.cp, mouse=wildcards.mouse, outdir=wildcards.outdir),
    output:
        combinedLog = "{outdir}/beam/{mouse}/{cp}/combined.log",
        combinedTrees = "{outdir}/beam/{mouse}/{cp}/combined.trees",
    params:
        logcombiner = config['logcombiner'],
        essCutoff = config['essCutoff'],
        threads = 1
    shell:
        """
        # find chains that have converged based on ess threshold specified
        log_files=""
        trees_files=""
        ess_convergences=()
        for file in {input.beamLogs}; do
            terminal_log=$(echo $file | sed 's/chain_/terminal_/')
            
            # only use mcmc chains that have converged since many appear to get lost in the search space
            ess_convergence=$(grep "Msamples" $terminal_log | tail -n 1 | sed 's/^ *//;s/ *$//' | tr -s ' ' | cut -d' ' -f3)
            if (( $(echo "$ess_convergence > {params.essCutoff}" | bc -l) )); then
                log_files+="-log $file "
                trees_file=$(echo $file | sed 's/\.log$/.trees/')
                trees_files+="-log $trees_file "
            else
                echo "$file did not converge, so not including it in the final output"
            fi
        done
        # combine logs and trees that passed
        {params.logcombiner} $log_files -o {output.combinedLog}
        {params.logcombiner} $trees_files -o {output.combinedTrees}
        """

rule convertTreePosteriorToGraphPosterior:
    input:
        combinedTrees = "{outdir}/beam/{mouse}/{cp}/combined.trees"
    output:
        graphPosterior = "{outdir}/beam/{mouse}/{cp}/posterior_prob_graph.csv"
    params:
        scripts = config['scripts'],
        primaryTissue = lambda wildcards: config['primaryTissue'][wildcards.mouse],
        outdir = "{outdir}/beam/{mouse}/{cp}",
        threads = 1
    conda:
        "../../envs/networkx.yaml"
    shell:
        """
        if [ ! -s {input.combinedTrees} ]; then
            echo "Combined trees file is empty. Exiting."
            touch {output.graphPosterior}
        else
            python {params.scripts}/formatting/convert_tree_posterior_to_consensus_posterior_prob_graph.py {input.combinedTrees} {params.primaryTissue} {output.graphPosterior} {params.threads}
        fi
        """

rule plotGraphPosterior:
    input:
        combinedTrees = "{outdir}/beam/{mouse}/{cp}/combined.trees",
        graphPosterior = "{outdir}/beam/{mouse}/{cp}/posterior_prob_graph.csv"
    output:
        probabilityPlot = "{outdir}/beam/{mouse}/{cp}/probability_migration_graph.pdf",
    params:
        scripts = config['scripts'],
        primaryTissue = lambda wildcards: config['primaryTissue'][wildcards.mouse],
        outdir = "{outdir}/beam/{mouse}/{cp}",
        threads = 1,
        minThreshold = 0.4,
        maxThreshold = 0.9,
    conda:
        "../../envs/networkx.yaml"
    shell:
        """
        if [ ! -s {input.combinedTrees} ] && [ ! -s {input.graphPosterior} ]; then
            echo "Combined trees and graph posterior files are empty. Convergence likely not reached. Exiting."
            # touch {output.probabilityPlot}
        elif [ ! -s {input.graphPosterior} ]; then
            echo "Graph posterior file is empty. Is there expected to be more than one tissue in the graph? Exiting."
            touch {output.probabilityPlot}
        else
            # output a consensus plot for several thresholds from the specified min and max thresholds
            for threshold in $(seq {params.minThreshold} 0.1 {params.maxThreshold}); do
                python {params.scripts}/plotting/plot_consensus_prob_migration_graph.py {input.graphPosterior} {params.primaryTissue} {params.outdir} $threshold
            done
        fi
        """

