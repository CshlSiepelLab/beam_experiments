import os
import sys
import glob

# get sample ids and fastq files from input fastq dir
samples = []
sample_fastqs = {}
for file in glob.glob(os.path.join(config['fastqPath'], "*.fastq.gz")):
    sample = os.path.basename(file).split("_")[0]
    if sample not in samples:
        samples.append(sample)
    if sample not in sample_fastqs:
        sample_fastqs[sample] = []
    sample_fastqs[sample].append(file)


# print("Samples:", samples)
# print("\nSample Fastqs:")
# for sample, fastqs in sample_fastqs.items():
#     print(f"{sample}:")
#     for fastq in fastqs:
#         print(f"    {fastq}")

def get_elements_from_file(path):
    # to get all cps
    filename = f"{path}/cp_list.txt"
    with open(filename) as f:
        cps = [line.strip() for line in f if set(list(line.strip().replace("CP", ""))) != set('0')]

    # cps with phylogenetic information
    informative_cps = ['CP001', 'CP002', 'CP003', 'CP004', 'CP005', 'CP006', 'CP007', 'CP008', 'CP009', 'CP010', 'CP011', 'CP012', 'CP013', 'CP014', 'CP015', 'CP016', 'CP017', 'CP018', 'CP019', 'CP020', 'CP021', 'CP022', 'CP023', 'CP024', 'CP025', 'CP026', 'CP027', 'CP028', 'CP029', 'CP030', 'CP031', 'CP032', 'CP033', 'CP034', 'CP035', 'CP036', 'CP037', 'CP038', 'CP040', 'CP045', 'CP054', 'CP055', 'CP061', 'CP065', 'CP093', 'CP121', 'CP190']
    cps = [cp for cp in cps if cp in informative_cps]

    cps = [cp for cp in cps if int(cp.replace("CP", "")) > 10]    # exclude these CPs due to computational burden

    return cps


rule all:
    input:
        expand("{outdir}/evotracer/{sample}/asv_analysis/character_matrix.csv", outdir=config['outdir'], sample=samples),
        expand("{outdir}/cp_split/{sample}/cp_list.txt", outdir=config['outdir'], sample=samples),
        [expand("{outdir}/mach2_{num}/{sample}/{cp}/consensus_graph.txt", outdir=config['outdir'], num=n, sample=samples, cp=get_elements_from_file(f"{config['outdir']}/cp_split/{sample}")) for n in range(1,4) for sample in samples],
        [expand("{outdir}/beam_gtr{num}/{sample}/{cp}/terminal_{numChain}.log", outdir=config['outdir'], num=n, numChain=c, sample=samples, cp=get_elements_from_file(f"{config['outdir']}/cp_split/{sample}")) for n in range(1,4) for sample in samples for c in range(1,config['numChains']+1)],
        expand("{outdir}/beam_gtr{num}/{sample}/{cp}/combined.log", outdir=config['outdir'], num=range(1,4), sample=samples, cp=get_elements_from_file(f"{config['outdir']}/cp_split/{sample}")),
        [expand("{outdir}/beam_gtr{num}/{sample}/{cp}/posterior_prob_graph.csv", outdir=config['outdir'], num=range(1,4), sample=sample, cp=get_elements_from_file(f"{config['outdir']}/cp_split/{sample}")) for sample in samples],
        [expand("{outdir}/performance{num}/{sample}/{cp}/beam_performance.csv", outdir=config['outdir'], num=range(1,4), sample=samples, cp=get_elements_from_file(f"{config['outdir']}/cp_split/{sample}")) for sample in samples],
        [expand("{outdir}/performance{num}/{sample}/{cp}/mach2_performance.csv", outdir=config['outdir'], num=range(1,4), sample=samples, cp=get_elements_from_file(f"{config['outdir']}/cp_split/{sample}")) for sample in samples],
        expand("{outdir}/combined_performance_metrics.csv", outdir=config['outdir'])

rule runEvotracer:
    input:
        fastqFiles = lambda wildcards: sample_fastqs[wildcards.sample]
    output:
        char_matrix = "{outdir}/evotracer/{sample}/asv_analysis/character_matrix.csv",
        asv_stat = "{outdir}/evotracer/{sample}/phylogeny_analysis/phylogeny_del_ins/asv_stat.csv",
        mut_dict = "{outdir}/evotracer/{sample}/asv_analysis/mutation_profile_map.csv",
        evotracerCassiopeiaTree= "{outdir}/evotracer/{sample}/phylogeny_analysis/phylogeny_del_ins/tree_all_clones.newick",
    params:
        evoOutDir = "{outdir}/evotracer/{sample}",
        scripts = config['scripts'],
        asvThreshold = config['asvThreshold'],
        barcode_version = "BC10v2",
        threads = 10,
        mem = '40G',
    singularity:
        '../../envs/evotracer.sif'
    shell:
        """
        # make sample specific temp dir with fastqs
        tempDir={wildcards.outdir}/{wildcards.sample}_fastq_temp
        mkdir -p $tempDir
        cp {input.fastqFiles} $tempDir/

        # evotracer needs fastqs to be unzipped
        gunzip $tempDir/*

        Rscript {params.scripts}/evotracer/evotracer.R $tempDir {params.evoOutDir} {params.asvThreshold} {params.barcode_version} {params.threads}

        # remove temp dir
        rm -r $tempDir
        """

rule splitCPs:
    input:
        char_matrix = "{outdir}/evotracer/{sample}/asv_analysis/character_matrix.csv",
        asv_stat = "{outdir}/evotracer/{sample}/phylogeny_analysis/phylogeny_del_ins/asv_stat.csv",
        mut_dict = "{outdir}/evotracer/{sample}/asv_analysis/mutation_profile_map.csv",
    output:
        cpList = "{outdir}/cp_split/{sample}/cp_list.txt",
        mutation_dict = "{outdir}/cp_split/{sample}/mutation_dict.tsv",
    params:
        outdir = "{outdir}/cp_split/{sample}",
        scripts = config['scripts'],
        threads = 1,
        mem = '5G'
    shell:
        """
        # prep mutation dictionary for the sample overall
        sed 's/\",/\\t/g' {input.mut_dict} | sed 's/\"//g' > {params.outdir}/mutation_dict.tsv

        cps=$(tail -n +2 {input.asv_stat} | cut -d',' -f30 | sort | uniq | tr '\\n' ' ')
        for cp in $cps; do

            # make cp dir
            cpOutdir={params.outdir}/${{cp}}
            mkdir -p $cpOutdir

            # get ASVs for the cp
            asvs=$(tail -n +2 {input.asv_stat} | grep -w "$cp" | cut -d',' -f1 | sort | uniq | tr '\\n' ' ')

            # setup temp matrix and tissues headers
            tempMatrix=$cpOutdir/temp_matrix.tsv
            head -n 1 {input.char_matrix} | sed 's/,/\\t/g' | sed 's/\"//g' > $tempMatrix
            tempTissues=$cpOutdir/temp_tissues.tsv
            echo -e "group_name\\ttissues" > $tempTissues

            # subset matrix and tissues for each cp to only retain ASVs for that CP
            for asv in $asvs; do
                sed 's/,/\\t/g' {input.char_matrix} | sed 's/\"//g' | grep -w "$asv" >> $tempMatrix
                tail -n +2 {input.asv_stat} | cut -d',' -f1-2 | grep -w "$asv" | awk -F',' '{{if (!seen[$1","$2]++) a[$1]=a[$1]","$2}} END {{for (i in a) {{split(a[i], b, ","); delete seen; c=""; for (j in b) if (b[j] != "" && !seen[b[j]]++) c=(c == "" ? b[j] : c","b[j]); print i"\\t"c}}}}' >> ${{tempTissues}}
            done

            # track all CPs as they finish pre-processing
            echo "$cp" >> {output.cpList}
        done
        """

rule filterForTissueScenarios:
    input:
        cpList = "{outdir}/cp_split/{sample}/cp_list.txt",
        temp_matrix = "{outdir}/cp_split/{sample}/{cp}/temp_matrix.tsv",
        temp_tissues = "{outdir}/cp_split/{sample}/{cp}/temp_tissues.tsv",
    output:
        matrix1 = "{outdir}/scenario1/{sample}/{cp}/matrix.tsv",
        tissues1 = "{outdir}/scenario1/{sample}/{cp}/tissues.tsv",
        matrix2 = "{outdir}/scenario2/{sample}/{cp}/matrix.tsv",
        tissues2 = "{outdir}/scenario2/{sample}/{cp}/tissues.tsv",
        matrix3 = "{outdir}/scenario3/{sample}/{cp}/matrix.tsv",
        tissues3 = "{outdir}/scenario3/{sample}/{cp}/tissues.tsv",
    params:
        outdir1 = "{outdir}/scenario1/{sample}/{cp}",
        outdir2 = "{outdir}/scenario2/{sample}/{cp}",
        outdir3 = "{outdir}/scenario3/{sample}/{cp}",
        ignore_tissues1 = "Pd3,MetReSeedMet5.3to5,PReSeedMet3",
        ignore_tissues2 = "Pd3,Pd24,Met5",
        ignore_tissues3 = "Pd3",
        scripts = config['scripts'],
        threads = 1,
        mem = '5G'
    shell:
        """
        # filter for scenario 1 and rename Pd24 to P
        python {params.scripts}/formatting/filter_for_tissue_scenarios.py {input.temp_matrix} {input.temp_tissues} {params.ignore_tissues1} {params.outdir1}
        sed -i 's/Pd24/P/g' {output.tissues1}

        # filter for scenario 2 and rename reseeding tissues to P and Met5
        python {params.scripts}/formatting/filter_for_tissue_scenarios.py {input.temp_matrix} {input.temp_tissues} {params.ignore_tissues2} {params.outdir2}
        sed -i 's/MetReSeedMet5.3to5/Met5/g' {output.tissues2}
        sed -i 's/PReSeedMet3/P/g' {output.tissues2}
        
        # filter for scenario 3 and rename Pd24 to P
        python {params.scripts}/formatting/filter_for_tissue_scenarios.py {input.temp_matrix} {input.temp_tissues} {params.ignore_tissues3} {params.outdir3}
        sed -i 's/Pd24/P/g' {output.tissues3}
        """

rule prepBeamInputsAllScenarios:
    input:
        cpList = "{outdir}/cp_split/{sample}/cp_list.txt",
        matrix = "{outdir}/scenario{num}/{sample}/{cp}/matrix.tsv",
        tissues = "{outdir}/scenario{num}/{sample}/{cp}/tissues.tsv",
        mutation_dict = "{outdir}/cp_split/{sample}/mutation_dict.tsv",
    output:
        fasta = "{outdir}/beam_prep{num}/{sample}/{cp}/{cp}.fasta",
        tissues = "{outdir}/beam_prep{num}/{sample}/{cp}/{cp}_tip_tissues.csv",
        editRateProportions = "{outdir}/beam_prep{num}/{sample}/{cp}/{cp}_edit_rate_proportions.txt",
        expandedClonesMatrix = "{outdir}/beam_prep{num}/{sample}/{cp}/expanded_clones_matrix.tsv",
    params:
        outdir = "{outdir}",
        scripts = config['scripts'],
        experimentTime = config['experimentTime'],
        threads = 1,
        mem = '5G'
    conda:
        "../../envs/networkx.yaml"
    shell:
        """
        scenario={wildcards.num}

        indirScenario={params.outdir}/scenario${{scenario}}/{wildcards.sample}/{wildcards.cp}
        inMatrixFile=$indirScenario/matrix.tsv
        inTissuesFile=$indirScenario/tissues.tsv

        outdirScenario={params.outdir}/beam_prep${{scenario}}/{wildcards.sample}/{wildcards.cp}
        mkdir -p $outdirScenario

        fasta=$outdirScenario/{wildcards.cp}.fasta
        tissues=$outdirScenario/{wildcards.cp}_tip_tissues.csv
        editRateProportions=$outdirScenario/{wildcards.cp}_edit_rate_proportions.txt
        matrixFile=$outdirScenario/expanded_clones_matrix.tsv
        tissuesFile=$outdirScenario/expanded_clones_tissues.tsv

        # Check if matrix file has more than 1 line (header only)
        if [ $(wc -l < $inMatrixFile) -le 1 ]; then
            touch $fasta $tissues $editRateProportions $matrixFile $tissuesFile
            continue
        fi

        # make mutations successive for each matrix and provide an updated dictionary of int to mutations
        python {params.scripts}/formatting/matrix_to_successive_matrix.py $inMatrixFile {input.mutation_dict} $outdirScenario

        # expand clones found in multiple tissues to separate entries
        python {params.scripts}/formatting/expand_clones_multiple_tissues.py $outdirScenario/successive_char_matrix.csv $inTissuesFile $outdirScenario

        # write tip traits to new csv
        tail -n +2 $tissuesFile | grep -v '^$' | cut -f1,2 | tr '\\t' ',' > $tissues

        # get edit rate proportions for new mutation entries, relative so they all sum to 1.0
        all_muts=$(tail -n +2 $matrixFile | grep -v '^$' | cut -f2- | sed 's/-1/0/g' | tr '\\t' ' ' | tr '\\n' ' ')
        total_count=$(echo $all_muts | tr ' ' '\\n' | grep -wv "0" | wc -l)
        uniq_count=$(echo $all_muts | tr ' ' '\\n' | sort | uniq | grep -wv "0" | wc -l)
        count_sum=$( echo $all_muts | tr ' ' '\\n' | grep -wv "0" | wc -l )
        
        for element in $(seq 1 $uniq_count); do
            echo "START"
            echo "element: $element"
            if echo "$all_muts" | tr ' ' '\\n' | grep -w "$element"; then
                echo "FOUND"
                count=$(echo "$all_muts" | tr ' ' '\\n' | grep -wc "$element")
                proportion=$(echo "scale=10; $count / $count_sum" | bc)
            else
                echo "NOT FOUND"
                count=0
                proportion=0
            fi
            echo "count: $count"
            echo "proportion: $proportion"
            echo "$proportion" >> $editRateProportions
        done

        # Format fasta with the option to replace site dropouts with the new int representation to be modeled by an independent silencing rate
        # to model dropouts, use the highest mutation int representation and add 1 since the dropout column is the last in the rate matrix
        dropoutMutNum=$(( uniq_count + 1 ))
        tail -n +2 $matrixFile | grep -v '^$' | sed "s/-1/$dropoutMutNum/g" | awk '{{printf ">"$1"\\n"; for (i=2; i<=NF; i++) printf (i==NF ? $i"\\n" : $i",")}}' > $fasta    
        """

rule runCassiopeia:
    input:
        expandedClonesMatrix = "{outdir}/beam_prep{num}/{sample}/{cp}/expanded_clones_matrix.tsv"
    output:
        casTree = "{outdir}/cassiopeia_greedy{num}/{sample}/{cp}/cassiopeia_greedy_inferred.nwk"
    params:
        cassiopeia_script = os.path.join(config['scripts'], "cassiopeia/cassiopeia_greedy.py"),
        outputdir = "{outdir}/cassiopeia_greedy{num}/{sample}/{cp}",
        threads = 5,
        mem = '5G'
    singularity:
        "../../envs/simulate.sif"
    shell:
        """
        # Check if matrix file has more than 1 line (header only)
        if [ $(wc -l < {input.expandedClonesMatrix}) -le 2 ]; then
            touch {output}
        else
            # run cassiopeia greedy
            python {params.cassiopeia_script} {input.expandedClonesMatrix} {params.outputdir}
        fi
        """

rule runLAML:
    input:
        expandedClonesMatrix = "{outdir}/beam_prep{num}/{sample}/{cp}/expanded_clones_matrix.tsv",
        editRateProportions = "{outdir}/beam_prep{num}/{sample}/{cp}/{cp}_edit_rate_proportions.txt",
        casTree = "{outdir}/cassiopeia_greedy{num}/{sample}/{cp}/cassiopeia_greedy_inferred.nwk"
    output:
        lamlTree = "{outdir}/laml{num}/{sample}/{cp}/laml_trees.nwk",
        lamlAnnotations = "{outdir}/laml{num}/{sample}/{cp}/laml_annotations.txt",
        lamlTreeNoBranchLengths = "{outdir}/laml{num}/{sample}/{cp}/laml_trees_no_branch_lengths.nwk"
    params:
        scripts = config['scripts'],
        outputdir = "{outdir}/laml{num}/{sample}/{cp}",
        experimentTime = config['experimentTime'],
        threads = 50,
        mem = '10G'
    conda:
        "../../envs/laml.yaml"
    shell:
        """
        if [ $(wc -l < {input.expandedClonesMatrix}) -le 2 ]; then
            touch {output}
        else
            # copy matrix and replace -1 with ? for missing data
            laml_matrix={params.outputdir}/matrix.csv
            cp {input.expandedClonesMatrix} $laml_matrix
            sed -i 's/-1/?/g; s/\t/,/g' $laml_matrix

            # format mutation priors
            reformattedObservedEditRates={params.outputdir}/reformatted_edit_rate_proportions.csv
            echo "mutation_code,rate" > $reformattedObservedEditRates
            numEditRates=$(wc -l < {input.editRateProportions})
            for i in $(seq 1 $numEditRates); do
                rate=$(sed -n "${{i}}p" {input.editRateProportions})
                echo "$i,$rate" >> $reformattedObservedEditRates
            done

            mutationPriors={params.outputdir}/mutation_priors.csv
            python {params.scripts}/formatting/format_laml_mutation_priors.py $laml_matrix $reformattedObservedEditRates $mutationPriors

            # run laml
            run_laml -c $laml_matrix -t {input.casTree} -p $mutationPriors -o {params.outputdir}/laml --timescale {params.experimentTime} --parallel

            # obtain newick without branch lengths
            sed 's/:\([0-9]\+\.\?\([0-9]\+\)\?\)//g' {output.lamlTree} > {output.lamlTreeNoBranchLengths}
        fi
        """

rule runBeam:
    input:
        fasta = "{outdir}/beam_prep{num}/{sample}/{cp}/{cp}.fasta",
        tissues = "{outdir}/beam_prep{num}/{sample}/{cp}/{cp}_tip_tissues.csv",
        editRateProportions = "{outdir}/beam_prep{num}/{sample}/{cp}/{cp}_edit_rate_proportions.txt",
        lamlTree = "{outdir}/laml{num}/{sample}/{cp}/laml_trees.nwk"
    output:
        terminalLog = "{outdir}/beam_gtr{num}/{sample}/{cp}/terminal_{numChain}.log",
        beamLog = "{outdir}/beam_gtr{num}/{sample}/{cp}/chain_{numChain}.log",
        beamResult = "{outdir}/beam_gtr{num}/{sample}/{cp}/chain_{numChain}.trees"
    params:
        xml = config['gtrXml'],
        inFileDir = "{outdir}/beam_prep{num}/{sample}/{cp}",
        fileDir = "{outdir}/beam_gtr{num}/{sample}/{cp}",
        experimentTime = config['experimentTime'],
        primaryTissue = config['primaryTissue'],
        threads = 5,
        mem = '2G',
        mcmclength = config['mcmcLength']
    shell:
        """
        # Only run if there are enough cells and enough non-primary tissue cells
        primary_count=$(cat {input.tissues} | cut -d',' -f2 | sort | uniq -c | grep -w "{params.primaryTissue}" | awk '{{print $1}}')
        total_count=$(wc -l < {input.tissues})
        non_primary_count=$(( total_count - primary_count ))
        
        if [ $(wc -l < {input.fasta}) -le 4 ] || [ $non_primary_count -le 1 ]; then
            touch {output}
        else
            cp {params.xml} {params.fileDir}/{wildcards.numChain}.xml

            # calculate necessary inputs for the editing model
            initialEditRates=$(cat {input.editRateProportions} | tr '\n' ' ')
            array=($initialEditRates)
            numEditRates=${{#array[@]}}
            numEditRatesPlusTwo=$(( numEditRates + 2 ))

            # format tissue information
            unique_tissues=$(cat {input.tissues} | cut -d',' -f2 | sort | uniq)
            numTissues=$(echo $unique_tissues | tr ' ' '\n' | wc -l)

            # set the mcmc chain length based on the number of tips in the tree
            # use a minimum of 5 million and a maximum of a user specified length
            numTips=$(grep -c '^>' {input.fasta})
            mcmclength=$(( numTips * 1000000 ))
            if (( mcmclength > {params.mcmclength} )); then
                mcmclength={params.mcmclength}
            elif (( mcmclength < 50000000 )); then
                mcmclength=50000000
            fi

            # fix mcmc length to the specified number instead of dynamically calculating it based on the number of tips
            mcmclength={params.mcmclength}

            if [[ $numTissues -eq 1 ]] && echo "$unique_tissues" | grep -w "{params.primaryTissue}"; then
                touch {output}
                exit 0
            fi

            # if numTissues is 1, then the model will not run, so we need to add a dummy tissue
            if [[ $numTissues -eq 1 ]]; then
                unique_tissues="{params.primaryTissue} $unique_tissues"
                numTissues=$(( numTissues + 1 ))
            fi

            # force the known primary tissue at the origin for root frequencies in the likelihood calculation
            sorted_unique_tissues="{params.primaryTissue} $(echo $unique_tissues | tr ' ' '\n' | grep -v '^{params.primaryTissue}$' | tr '\n' ' ')"
            if ! echo "$unique_tissues" | grep -qw "{params.primaryTissue}"; then
                numTissues=$(( numTissues + 1 ))
            fi
            tissueRootFreqs=$(for i in $(seq 1 $numTissues); do if [[ "$i" = "1" ]]; then echo -n "1 "; else echo -n "0 "; fi; done)

            numTissueRates=$(( ((numTissues * numTissues) - numTissues) / 2 ))

            tissueCodeMap=""
            trailingCodeMap="? = "
            i=0
            for tissue in $sorted_unique_tissues; do
                tissueCodeMap+="$tissue=$i,"
                trailingCodeMap+="$i "
                i=$((i+1))
            done
            tissueCodeMap+="${{trailingCodeMap}}"

            # for some reason this cannot be taken in at the command line, likely because the = signs are problematic and not taken as a single string
            sed -i "s/\$(tissueCodeMap)/$tissueCodeMap/g" {params.fileDir}/{wildcards.numChain}.xml
            sed -i "s/\$(initialEditRates)/$initialEditRates/g" {params.fileDir}/{wildcards.numChain}.xml
            sed -i "s/\$(tissueRootFreqs)/$tissueRootFreqs/g" {params.fileDir}/{wildcards.numChain}.xml

            # use LAML starting tree
            # remove node names from newick and the origin node
            newick=$(cat {input.lamlTree} | sed 's/node[0-9]*:/:/g' | sed 's/^.//' | sed 's/..$//')

            beast \
            -threads {params.threads} \
            -resume \
            -working \
            -D inName={wildcards.cp} \
            -D fileDir={params.inFileDir} \
            -D newick=\"$newick\" \
            -D generations={params.experimentTime} \
            -D numEditRates=\"$numEditRates\" \
            -D numEditRatesPlusTwo=\"$numEditRatesPlusTwo\" \
            -D numTissueRates=\"$numTissueRates\" \
            -D numTissues=\"$numTissues\" \
            -D mcmclength=\"$mcmclength\" \
            -D outname=chain_{wildcards.numChain} \
            {params.fileDir}/{wildcards.numChain}.xml > {output.terminalLog}
        fi
        """

rule combineBeamChains:
    input:
        terminalLog = lambda wildcards: expand("{outdir}/beam_gtr{num}/{sample}/{cp}/terminal_{numChain}.log", numChain=range(1, config['numChains']+1), num=wildcards.num, cp=wildcards.cp, sample=wildcards.sample, outdir=wildcards.outdir),
        beamLogs = lambda wildcards: expand("{outdir}/beam_gtr{num}/{sample}/{cp}/chain_{numChain}.log", numChain=range(1, config['numChains']+1), num=wildcards.num, cp=wildcards.cp, sample=wildcards.sample, outdir=wildcards.outdir),
        beamResults = lambda wildcards: expand("{outdir}/beam_gtr{num}/{sample}/{cp}/chain_{numChain}.trees", numChain=range(1, config['numChains']+1), num=wildcards.num, cp=wildcards.cp, sample=wildcards.sample, outdir=wildcards.outdir),
    output:
        combinedLog = "{outdir}/beam_gtr{num}/{sample}/{cp}/combined.log",
        combinedTrees = "{outdir}/beam_gtr{num}/{sample}/{cp}/combined.trees",
    params:
        logcombiner = config['logcombiner'],
        essCutoff = 200,
        threads = 1,
        mem = '5G'
    shell:
        """
        if [ $(wc -l < $(echo {input.terminalLog} | cut -d' ' -f1)) -eq 0 ]; then
            touch {output}
        else
            # find chains that have converged based on ess threshold specified
            log_files=""
            trees_files=""
            ess_convergences=()
            for file in {input.beamLogs}; do
                terminal_log=$(echo $file | sed 's/chain_/terminal_/')
                
                # only use mcmc chains that have converged since many appear to get lost in the search space
                ess_convergence=$(grep "Msamples" $terminal_log | tail -n 1 | sed 's/^ *//;s/ *$//' | tr -s ' ' | cut -d' ' -f3)
                if (( $(echo "$ess_convergence > {params.essCutoff}" | bc -l) )); then
                    log_files+="-log $file "
                    trees_file=$(echo $file | sed 's/\.log$/.trees/')
                    trees_files+="-log $trees_file "
                else
                    echo "$file did not converge, so not including it in the final output"
                fi
            done

            # combine logs and trees that passed
            if [ -n "$log_files" ]; then
                {params.logcombiner} $log_files -o {output.combinedLog}
                {params.logcombiner} $trees_files -o {output.combinedTrees}
            else
                echo "No chains passed the ESS threshold of {params.essCutoff}, so not combining any chains"
            fi
        fi
        """

rule beamPostprocessing:
    input:
        combinedTrees = "{outdir}/beam_gtr{num}/{sample}/{cp}/combined.trees",
        combinedLog = "{outdir}/beam_gtr{num}/{sample}/{cp}/combined.log"
    output:
        graphPosterior = "{outdir}/beam_gtr{num}/{sample}/{cp}/posterior_prob_graph.csv",
        probabilityPlot = "{outdir}/beam_gtr{num}/{sample}/{cp}/probability_migration_graph.pdf",
        samples = "{outdir}/beam_gtr{num}/{sample}/{cp}/combined_migration_graph_1.pdf",
        migrationCountMatrix = "{outdir}/beam_gtr{num}/{sample}/{cp}/posterior_trees_migration_count_matrix.csv",
        mutualInformation = "{outdir}/beam_gtr{num}/{sample}/{cp}/posterior_trees_migration_mutual_information.txt",
    params:
        scripts = config['scripts'],
        primaryTissue = config['primaryTissue'],
        outprefix_thresholded = "{outdir}/beam_gtr{num}/{sample}/{cp}/thresholded_migration_graph",
        outprefix_samples = "{outdir}/beam_gtr{num}/{sample}/{cp}/combined",
        outprefix_metastasis_timing = "{outdir}/beam_gtr{num}/{sample}/{cp}/metastasis_timing",
        experimentTime = config['experimentTime'],
        numSamples = 10,
        consensusTimingThreshold = 0.5,
        threads = 5,
        mem = "1G"
    shell:
        """
        # work around until beam visualization is pip installable
        source ~/miniforge3/etc/profile.d/conda.sh 
        conda activate beam_visualization

        export QT_QPA_PLATFORM=offscreen;

        if [ ! -s {input.combinedTrees} ]; then
            echo "Combined trees file is empty. Exiting."
            touch {output}
        else
            thresholds="0.4,0.5,0.6,0.7,0.8,0.9,0.95,0.99"
            
            python {params.scripts}/formatting/beam_postprocessing.py \
                {input.combinedTrees} \
                {input.combinedLog} \
                {params.primaryTissue} \
                {output.graphPosterior} \
                {params.threads} \
                {output.probabilityPlot} \
                $thresholds \
                {params.outprefix_thresholded} \
                {params.outprefix_samples} \
                {params.numSamples} \
                {params.experimentTime} \
                {output.migrationCountMatrix} \
                {output.mutualInformation} \
                {params.outprefix_metastasis_timing} \
                {params.consensusTimingThreshold}
        fi
        """

rule prepMach2:
    input:
        lamlTreeNoBranchLengths = "{outdir}/laml{num}/{sample}/{cp}/laml_trees_no_branch_lengths.nwk",
        tissues = "{outdir}/beam_prep{num}/{sample}/{cp}/{cp}_tip_tissues.csv"
    output:
        labeling = "{outdir}/mach2_prep{num}/{sample}/{cp}/laml_trees_no_origin_no_branch_lengths.labeling",
        edges = "{outdir}/mach2_prep{num}/{sample}/{cp}/laml_trees_no_origin_no_branch_lengths.tree",
        colors = "{outdir}/mach2_prep{num}/{sample}/{cp}/laml_trees_no_origin_no_branch_lengths_colors.txt"
    params:
        scripts = config['scripts'],
        outputdir = "{outdir}/mach2_prep{num}/{sample}/{cp}",
        primaryTissue = config['primaryTissue'],
        threads = 1,
        mem = '1G'
    singularity:
        "../../envs/simulate.sif"
    shell:
        """
        if [ $(wc -l < {input.lamlTreeNoBranchLengths}) -eq 0 ]; then
            touch {output}
        else
            # convert csv to tsv for leaf labels
            sed 's/,/\\t/g' {input.tissues} > {params.outputdir}/leaf_tissues.tsv

            # remove node names from newick and the origin node
            newick=$(cat {input.lamlTreeNoBranchLengths} | sed 's/^.//' | sed 's/..$//')
            echo "${{newick}};" > {params.outputdir}/laml_trees_no_origin_no_branch_lengths.nwk

            # prep inputs
            python {params.scripts}/machina/prep_machina.py {params.outputdir}/laml_trees_no_origin_no_branch_lengths.nwk {params.outputdir} {params.primaryTissue} {params.outputdir}/leaf_tissues.tsv

            # for the labeling and colors file, make sure the names do not have . or - characters
            sed -i 's/\./_/g; s/-/_/g' {output.labeling}
            sed -i 's/\./_/g; s/-/_/g' {output.edges}
            sed -i 's/\./_/g; s/-/_/g' {output.colors}
        fi
        """

rule runMach2:
    input:
        labeling = "{outdir}/mach2_prep{num}/{sample}/{cp}/laml_trees_no_origin_no_branch_lengths.labeling",
        edges = "{outdir}/mach2_prep{num}/{sample}/{cp}/laml_trees_no_origin_no_branch_lengths.tree",
        colors = "{outdir}/mach2_prep{num}/{sample}/{cp}/laml_trees_no_origin_no_branch_lengths_colors.txt"
    output:
        mach2graph = "{outdir}/mach2_{num}/{sample}/{cp}/P-G-0.graph"
    params:
        scripts = config['scripts'],
        outputdir = "{outdir}/mach2_{num}/{sample}/{cp}",
        primaryTissue = config['primaryTissue'],
        threads = 50,
        mem = '8G'
    conda:
        "../../envs/mach2.yaml"
    shell:
        """
        if [ $(wc -l < {input.labeling}) -eq 0 ]; then
            touch {output}
        else
            unique_tissues=$(cut -f2 {input.labeling} | sort | uniq)
            num_unique_tissues=$(echo "$unique_tissues" | wc -l)

            if [ "$num_unique_tissues" -gt 1 ]; then
                # check if primary tissue is in the labeling file
                if grep -q "{params.primaryTissue}$" {input.labeling}; then
                    mach2 {input.edges} {input.labeling} --colormap {input.colors} -p {params.primaryTissue} --log -o {params.outputdir} -t {params.threads}

                    # Need to touch output files to satisfy output, only if output with a different name exists
                    if [ $(ls {params.outputdir}/*.graph | wc -l) -gt 0 ] && [ ! -f {output.mach2graph} ]; then
                        touch {output}
                    fi
                else
                    most_common_tissue=$(cut -f2 {input.labeling} | sort | uniq -c | sort -nr | head -n 1 | awk '{{print $2}}')
                    echo "The {params.primaryTissue} is not in the tissue labels. Using the most common tissue $most_common_tissue as the primary tissue."
                    mach2 {input.edges} {input.labeling} --colormap {input.colors} -p $most_common_tissue --log -o {params.outputdir} -t {params.threads}

                    # Need to touch output files to satisfy output, only if output with a different name exists
                    if [ $(ls {params.outputdir}/*.graph | wc -l) -gt 0 ] && [ ! -f {output.mach2graph} ]; then
                        touch {output}
                    fi
                fi
            else
                echo "Only one unique tissue found in the labeling file, so not enough to run Mach2. Exiting."
                touch {output}
            fi
        fi
        """

rule gatherMach2Results:
    input:
        mach2graph = "{outdir}/mach2_{num}/{sample}/{cp}/P-G-0.graph"
    output:
        mach2Combined = "{outdir}/mach2_{num}/{sample}/{cp}/graph_results_combined.txt",
        mach2Consensus = "{outdir}/mach2_{num}/{sample}/{cp}/consensus_graph.txt"
    params:
        scripts = config['scripts'],
        outputdir = "{outdir}/mach2_{num}/{sample}/{cp}",
        threads = 1,
        mem = '1G'
    shell:
        """
        # get all graph files
        results=$(find $(dirname {input.mach2graph}) -name "*.graph")

        # combine all results
        echo "result_num,source,target,count" > {output.mach2Combined}
        for file in $results; do
            result_num=$(basename $file | cut -d'-' -f3 | cut -d'.' -f1)
            while IFS= read -r line; do
                echo "$result_num,$(echo $line | tr ' ' ',')" >> {output.mach2Combined}
            done < "$file"
        done

        # get the probability weighted edge consensus graph
        python {params.scripts}/formatting/convert_mach2_results_to_consensus_graph.py {output.mach2Combined} {output.mach2Consensus}
        """

rule BeamPerformance:
    input:
        beamGraph = "{outdir}/beam_gtr{num}/{sample}/{cp}/posterior_prob_graph.csv",
    output:
        performance = "{outdir}/performance{num}/{sample}/{cp}/beam_performance.csv"
    params:
        scripts = config['scripts'],
        groundTruth = lambda wildcards: config['scenario'][int(wildcards.num)],
        threads = 1,
        mem = '1G'
    conda:
        "../../envs/matplotlib.yaml"
    shell:
        """
        if [ -s {input.beamGraph} ]; then
            python {params.scripts}/statistics/quantify_in_vitro_performance_beam_mach2_ground_truth.py {input.beamGraph} {params.groundTruth} {output.performance}
        else
            touch {output}
        fi
        """

