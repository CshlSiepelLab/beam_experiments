
import os
import sys
import glob

def get_sims():
    return [d for d in os.listdir(config['inputpath']) if os.path.isdir(os.path.join(config['inputpath'], d))]

sims = get_sims()

# Found all reseeding sims from the model selection reseeding path, discarding any with mut0005 or mig04 due to poor performance on previous evaluations
all_reseeding_path = "/grid/siepel/home_norepl/staklins/bayesian_phylogenetic_metastasis/results/model_selection_reseeding_no_reseeding_12_5_24_variable_rates_data_8_19_24/reseeding_sims.txt"
with open(all_reseeding_path, 'r') as f:
    all_reseeding = [line.strip() for line in f]

# Counted the number of reseeding sims that were available, noticed none of them had mig7, then found all non-reseeding sims and discarded mig4 and mut0005 and mig7, and then randomly shuffled the file and took the top n to match the number of reseeding n from above (done to prevent any class imbalance)
chosen_non_reseeding_path = "/grid/siepel/home_norepl/staklins/bayesian_phylogenetic_metastasis/results/model_selection_reseeding_no_reseeding_12_5_24_variable_rates_data_8_19_24/no_reseeding_sims_randomly_chosen.txt"
with open(chosen_non_reseeding_path, 'r') as f:
    chosen_non_reseeding = [line.strip() for line in f]

# Keep only the sims that are in the chosen reseeding and non-reseeding sims
sims = [sim for sim in sims if sim in all_reseeding or sim in chosen_non_reseeding]

outdir = config['outdir']

rule all:
    input:
        expand("{outdir}/true_labeled_trees/{sim}/tissue_labeled_tree.nwk", sim=sims, outdir=outdir),
        expand("{outdir}/true_labeled_trees/{sim}/tissue_labeled_tree.pdf", sim=sims, outdir=outdir),
        expand("{outdir}/true_reseeding_classification/{sim}/reseeding.txt", sim=sims, outdir=outdir),
        expand("{outdir}/beam_prep/{sim}/{sim}.fasta", sim=sims, outdir=outdir),
        expand("{outdir}/beam_no_reseeding/{sim}/{num}/terminal_{num}.log", sim=sims, num=range(0, config['numReps']), outdir=outdir),
        expand("{outdir}/beam_one_rate_reseeding/{sim}/{num}/terminal_{num}.log", sim=sims, num=range(0, config['numReps']), outdir=outdir),


rule labelTrueTreeWithTissues:
    input:
        true_tree = lambda wildcards : glob.glob(os.path.join(config['inputpath'], wildcards.sim, "cell_tree_seed*[0-9].nwk")),
        true_tissues = lambda wildcards : glob.glob(os.path.join(config['inputpath'], wildcards.sim, "cell_tree_seed*.vertex.labeling"))
    output:
        "{outdir}/true_labeled_trees/{sim}/tissue_labeled_tree.nwk"
    params:
        scripts = config['scripts']
    conda:
        "../../envs/compare_trees.yaml"
    shell:
        """
        # run add tissue to newick
        python {params.scripts}/formatting/format_add_tissues_to_newick.py {input.true_tree} {input.true_tissues} {output}
        """

