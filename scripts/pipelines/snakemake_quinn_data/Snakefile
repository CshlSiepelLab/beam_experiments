        """


rule prepBeamInputs:
    input:
        matrix = "{outdir}/successive_raw_data/{mouse}/{cp}_successive_character_matrix.tsv",
        mutationPriors = "{outdir}/successive_raw_data/{mouse}/{cp}_mutation_priors.txt"
    output:
        fasta = "{outdir}/beam/{mouse}/{cp}/{mouse}_{cp}.fasta",
        editRateProportions = "{outdir}/beam/{mouse}/{cp}/{mouse}_{cp}_edit_rate_proportions.txt",
        editRates = "{outdir}/beam/{mouse}/{cp}/{mouse}_{cp}_fixed_edit_rates.txt",
    params:
        scripts = config['scripts'],
        threads = 1,
        mem = "1G"
    shell:
        """
        # get all mutations, replacing -1 with 0 to get relative mutation rates amongst mutations
        all_muts=$(tail -n +2 {input.matrix} | grep -v '^$' | cut -f2- | sed 's/-1/0/g' | tr '\\t' ' ' | tr '\\n' ' ')
        echo $all_muts

        # count all mutations not 0
        total_count=$( echo $all_muts | tr ' ' '\\n' | grep -wv "0" | wc -l )
        echo $total_count

        # count all unique characters
        uniq_count=$( echo $all_muts | tr ' ' '\\n' | sort | uniq | grep -wv "0" | wc -l )

        # get the proportion of all unique character mutations out of all possible matrix sites
        for element in $(seq 1 $uniq_count); do
            count=$(echo "$all_muts" | tr ' ' '\\n' | grep -wc "$element")
            proportion=$(bc <<< "scale=10; $count / $total_count")
            echo $proportion >> {output.editRateProportions}
        done

        # format fasta, making -1 into a unique character at the next available int
        dropoutMutNum=$(( uniq_count + 1 ))
        tail -n +2 {input.matrix} | grep -v '^$' | awk -v dropoutMutNum="$dropoutMutNum" '{{printf ">"$1"\\n"; for (i=2; i<=NF; i++) printf (i==NF ? ($i == -1 ? dropoutMutNum : $i)"\\n" : ($i == -1 ? dropoutMutNum : $i) ",")}}' > {output.fasta}
        
        # format edit rates from mutation priors, assuming they are already ordered ascending by mutation code, as required by beam to match the data codes
        tail -n +2 {input.mutationPriors} | cut -d',' -f2 > {output.editRates}
        """

rule runBeamGtr:
    input:
        fasta = "{outdir}/beam/{mouse}/{cp}/{mouse}_{cp}.fasta",
        tissues = "{outdir}/beam/{mouse}/{cp}/{mouse}_{cp}_tip_tissues.csv",
        editRates = "{outdir}/beam/{mouse}/{cp}/{mouse}_{cp}_fixed_edit_rates.txt",
        lamlTree = "{outdir}/laml/{mouse}/{cp}/laml_trees.nwk"
    output:
        terminalLog = "{outdir}/beam_gtr/{mouse}/{cp}/terminal_{num}.log",
        beamLog = "{outdir}/beam_gtr/{mouse}/{cp}/chain_{num}.log",
        beamResult = "{outdir}/beam_gtr/{mouse}/{cp}/chain_{num}.trees"
    params:
        xml = config['gtrXml'],
        inFileDir = "{outdir}/beam/{mouse}/{cp}",
        fileDir = "{outdir}/beam_gtr/{mouse}/{cp}",
        beamJar = config['beamJar'],
        experimentTime = lambda wildcards: config['experimentTime'][wildcards.mouse],
        mcmclength = config['mcmcLength'],
        primaryTissue = config['primaryTissue'],
        threads = 5,
        mem = "2G"
    shell:
        """
        cp {params.xml} {params.fileDir}/{wildcards.num}.xml

        # calculate necessary inputs for the editing model
        initialEditRates=$(cat {input.editRates} | tr '\n' ' ')
        array=($initialEditRates)
        numEditRates=${{#array[@]}}
        numEditRatesPlusTwo=$(( numEditRates + 2 ))

        # format tissue information
        unique_tissues=$(cat {input.tissues} | cut -d',' -f2 | sort | uniq)
        numTissues=$(echo $unique_tissues | tr ' ' '\n' | wc -l)

        # if numTissues is 1, then the model will not run, so we need to add a dummy tissue
        if [[ $numTissues -eq 1 ]]; then
            # if the primary already exists then add a dummy
            if echo "$unique_tissues" | grep -w "{params.primaryTissue}"; then
                unique_tissues="$unique_tissues dummy"
            # if not, then add the primary as the dummy
            else
                unique_tissues="{params.primaryTissue} $unique_tissues"
            fi
            numTissues=$(( numTissues + 1 ))
        fi

        # force the known primary tissue at the origin for root frequencies in the likelihood calculation
        sorted_unique_tissues="{params.primaryTissue} $(echo $unique_tissues | tr ' ' '\n' | grep -v '^{params.primaryTissue}$' | tr '\n' ' ')"
        if ! echo "$unique_tissues" | grep -qw "{params.primaryTissue}"; then
            numTissues=$(( numTissues + 1 ))
        fi
        tissueRootFreqs=$(for i in $(seq 1 $numTissues); do if [[ "$i" = "1" ]]; then echo -n "1 "; else echo -n "0 "; fi; done)

        numTissueRates=$(( ((numTissues * numTissues) - numTissues) / 2 ))

        tissueCodeMap=""
        trailingCodeMap="? = "
        i=0
        for tissue in $sorted_unique_tissues; do
            tissueCodeMap+="$tissue=$i,"
            trailingCodeMap+="$i "
            i=$((i+1))
        done
        tissueCodeMap+="${{trailingCodeMap}}"

        # for some reason this cannot be taken in at the command line, likely because the = signs are problematic and not taken as a single string
        sed -i "s/\$(tissueCodeMap)/$tissueCodeMap/g" {params.fileDir}/{wildcards.num}.xml

        # initial edit rates are often too long to be taken in at a java command line argument for this data, so replace it here
        sed -i "s/\$(initialEditRates)/$initialEditRates/g" {params.fileDir}/{wildcards.num}.xml

        # use LAML starting tree
        # remove node names from newick and the origin node
        newick=$(cat {input.lamlTree} | sed 's/node[0-9]*:/:/g' | sed 's/^.//' | sed 's/..$//')

        # starting newick can often be too long to be taken in at a java command line argument for this data, so replace it here
        # but even bash commands have length limits, so split the newick string into manageable chunks and replace them one by one
        chunk_size=1000
        newick_length=${{#newick}}
        for ((i=0; i<newick_length; i+=chunk_size)); do
            chunk=${{newick:i:chunk_size}}
            sed -i "s/\$(newick)/$chunk\$(newick)/" {params.fileDir}/{wildcards.num}.xml
        done
        # Remove the remaining placeholder
        sed -i "s/\$(newick)//" {params.fileDir}/{wildcards.num}.xml

        java -Xmx10g -jar {params.beamJar} \
        -threads {params.threads} \
        -resume \
        -working \
        -D inName={wildcards.mouse}_{wildcards.cp} \
        -D fileDir={params.inFileDir} \
        -D generations={params.experimentTime} \
        -D numEditRates=\"$numEditRates\" \
        -D numEditRatesPlusTwo=\"$numEditRatesPlusTwo\" \
        -D numTissueRates=\"$numTissueRates\" \
        -D numTissues=\"$numTissues\" \
        -D tissueRootFreqs=\"$tissueRootFreqs\" \
        -D mcmclength={params.mcmclength} \
        -D outname=chain_{wildcards.num} \
        {params.fileDir}/{wildcards.num}.xml > {output.terminalLog}
        """

rule combineBeamChains:
    input:
        terminalLog = lambda wildcards: expand("{outdir}/beam_gtr/{mouse}/{cp}/terminal_{num}.log", num=range(1, config['numChains']+1), mouse=wildcards.mouse, cp=wildcards.cp, outdir=wildcards.outdir),
        beamLogs = lambda wildcards: expand("{outdir}/beam_gtr/{mouse}/{cp}/chain_{num}.log", num=range(1, config['numChains']+1), mouse=wildcards.mouse, cp=wildcards.cp, outdir=wildcards.outdir),
        beamResults = lambda wildcards: expand("{outdir}/beam_gtr/{mouse}/{cp}/chain_{num}.trees", num=range(1, config['numChains']+1), mouse=wildcards.mouse, cp=wildcards.cp, outdir=wildcards.outdir),
    output:
        combinedLog = "{outdir}/beam_gtr/{mouse}/{cp}/combined.log",
        combinedTrees = "{outdir}/beam_gtr/{mouse}/{cp}/combined.trees"
    params:
        logcombiner = config['logcombiner'],
        essCutoff = config['essCutoff'],
        treeannotator = config['treeannotator'],
        threads = 1,
        mem = '1G'
    shell:
        """
        # find chains that have converged based on ess threshold specified
        log_files=""
        trees_files=""
        ess_convergences=()
        for file in {input.beamLogs}; do
            terminal_log=$(echo $file | sed 's/chain_/terminal_/')
            
            ess_convergence=$(grep "Msamples" $terminal_log | tail -n 1 | sed 's/^ *//;s/ *$//' | tr -s ' ' | cut -d' ' -f3)
            if (( $(echo "$ess_convergence > {params.essCutoff}" | bc -l) )); then
                log_files+="-log $file "
                trees_file=$(echo $file | sed 's/\.log$/.trees/')
                trees_files+="-log $trees_file "
            else
                echo "$file did not converge, so not including it in the final output"
            fi
        done

        # combine logs and trees that passed
        if [ -n "$log_files" ]; then
            {params.logcombiner} $log_files -o {output.combinedLog}
            {params.logcombiner} $trees_files -o {output.combinedTrees}
        else
            echo "No chains passed the ESS threshold of {params.essCutoff}, so not combining any chains"
        fi
        """

rule convertTreePosteriorToGraphPosterior:
    input:
        combinedTrees = "{outdir}/beam_gtr/{mouse}/{cp}/combined.trees"
    output:
        graphPosterior = "{outdir}/beam_gtr/{mouse}/{cp}/posterior_prob_graph.csv"
    params:
        scripts = config['scripts'],
        primaryTissue = config['primaryTissue'],
        outdir = "{outdir}/beam/{mouse}/{cp}",
        threads = 1,
        mem = '1G'
    conda:
        "../../envs/networkx.yaml"
    shell:
        """
        if [ ! -s {input.combinedTrees} ]; then
            echo "Combined trees file is empty. Exiting."
            touch {output.graphPosterior}
        else
            python {params.scripts}/formatting/convert_tree_posterior_to_consensus_posterior_prob_graph.py {input.combinedTrees} {params.primaryTissue} {output.graphPosterior} {params.threads}
        fi
        """

rule plotGraphPosterior:
    input:
        combinedTrees = "{outdir}/beam_gtr/{mouse}/{cp}/combined.trees",
        graphPosterior = "{outdir}/beam_gtr/{mouse}/{cp}/posterior_prob_graph.csv"
    output:
        probabilityPlot = "{outdir}/beam_gtr/{mouse}/{cp}/probability_migration_graph.pdf",
    params:
        scripts = config['scripts'],
        primaryTissue = config['primaryTissue'],
        outdir = "{outdir}/beam_gtr/{mouse}/{cp}",
        minThreshold = 0.4,
        maxThreshold = 0.9,
        threads = 1,
        mem = '1G'
    conda:
        "../../envs/networkx.yaml"
    shell:
        """
        if [ ! -s {input.combinedTrees} ] && [ ! -s {input.graphPosterior} ]; then
            echo "Combined trees and graph posterior files are empty. Convergence likely not reached. Exiting."
            # touch {output.probabilityPlot}
        elif [ ! -s {input.graphPosterior} ]; then
            echo "Graph posterior file is empty. Is there expected to be more than one tissue in the graph? Exiting."
            touch {output.probabilityPlot}
        else
            # output a consensus plot for several thresholds from the specified min and max thresholds
            for threshold in $(seq {params.minThreshold} 0.1 {params.maxThreshold}); do
                python {params.scripts}/plotting/plot_consensus_prob_migration_graph.py {input.graphPosterior} {params.primaryTissue} {params.outdir} $threshold
            done
        fi
        """

rule sampleFromBeamPosteriorGraphs:
    input:
        combinedTrees = "{outdir}/beam_gtr/{mouse}/{cp}/combined.trees",
    output:
        sampledGraphs = "{outdir}/beam_gtr/{mouse}/{cp}/combined_migration_graph_1.pdf"
    params:
        scripts = config['scripts'],
        primaryTissue = config['primaryTissue'],
        experimentTime = lambda wildcards: config['experimentTime'][wildcards.mouse],
        numGraphs = 10,
        threads = 1,
        mem = '1G'
    conda:
        "../../envs/networkx.yaml"
    shell:
        """
        export QT_QPA_PLATFORM=offscreen;
