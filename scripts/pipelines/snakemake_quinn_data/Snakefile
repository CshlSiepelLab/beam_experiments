
import os
import sys
import glob

# specific to yang et al data to get the input files (character matrices and tissue labeling files)
character_matrices = glob.glob(os.path.join(config['inputpath'], "character_matrices", "*_character_matrix.alleleThresh.txt"))
mouse_ids = list(set([os.path.basename(f).split("_")[0].replace("m", "") for f in character_matrices]))

# Only use the 5k mouse for now since it is what the authors used and otherwise the metadata for each mouse is differently formatting causing pipeline complications
mouse_ids = [m for m in mouse_ids if m == "5k"]

cps_for_mouse = {}
for mouse in mouse_ids:
    mouse_matrices = [f for f in character_matrices if mouse in f]
    mouse_cps = [os.path.basename(f).split("_")[1].replace("lg", "") for f in mouse_matrices]
    cps_for_mouse[mouse] = mouse_cps


tissue_labeling_files = glob.glob(os.path.join(config['inputpath'], f"*_meta*"))

# Not clear what this file is for, but not one of the 4 mice in the study with character matrices
tissue_labeling_files.remove("/grid/siepel/home_norepl/staklins/bayesian_phylogenetic_metastasis/data/quinn_2021_real_data/GSE161363/GSM4905342_meta.LM0.tsv")

outdir = config['outdir']

# print("Character Matrices:", character_matrices)
