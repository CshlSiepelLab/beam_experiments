#     print(f"{len(value)} cps")
#     print(value)
# print("Tissue Labeling Files:", tissue_labeling_files)
# print("Output Directory:", outdir)

rule all:
    input:
        [expand("{outdir}/beam_prep/{mouse}/{cp}/{mouse}_{cp}_tip_tissues.csv", mouse=m, cp=cps_for_mouse[m], outdir=outdir) for m in mouse_ids],
        [expand("{outdir}/successive_raw_data/{mouse}/lg1_successive_character_matrix.txt", mouse=m, outdir=outdir) for m in mouse_ids]


rule formatTissues:
    input:
        matrix = config['inputpath'] + "/character_matrices/m{mouse}_lg{cp}_character_matrix.alleleThresh.txt",
        metafile = config['inputpath'] + "/GSM4905335_meta.{mouse}.tsv"
    output:
        tissues = "{outdir}/beam_prep/{mouse}/{cp}/{mouse}_{cp}_tip_tissues.csv"
    params:
        scripts = config['scripts'],
        threads = 10,
        mem = "1G"
    shell:
        """
        # get cell names from the CP specific matrix and find tissues for those cells in the metafile
        grep -Ff <(tail -n +2 {input.matrix} | cut -f1 | tr ' ' '\n') {input.metafile} | cut -f1,6 | tr '\t' ',' > {output.tissues}
        """

rule convertMatrixToSuccessive:
    input:
        alleleTable = config['inputpath'] + "/GSM4905334_alleleTable.{mouse}.txt"
    output:
        successive_matrix = "{outdir}/successive_raw_data/{mouse}/lg1_successive_character_matrix.txt"
    params:
        outdir = "{outdir}/successive_raw_data/{mouse}/",
        scripts = config['scripts'],
        threads = 1,
        mem = "1G"
    singularity:
        "../../envs/simulate.sif"
    shell:
        """
        python {params.scripts}/formatting/convert_matrix_to_successive.py {input.alleleTable} {params.outdir}
        """

