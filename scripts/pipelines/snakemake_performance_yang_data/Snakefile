
import os
import sys
import glob

# specific to yang et al data to get the input files (character matrices and tissue labeling files)
character_matrices = glob.glob(os.path.join(config['inputpath'], "*_successive_char_matrix_collapsed.txt"))
mouse_ids = ["_".join(os.path.basename(x).split("_")[0:3]) for x in character_matrices]
tissue_labeling_files = [os.path.join(config['inputpath'], f"{x}_successive_char_matrix_collapsing_dict.txt") for x in mouse_ids]

outdir = config['outdir']

rule all:
    input:
        expand("{outdir}/metastabayes/{mouse}/terminal_{num}.log", mouse=mouse_ids, num=range(1, config['numChains']+1), outdir=outdir),
        # expand("{outdir}/metastabayes/{mouse}/combined.log", mouse=mouse_ids, outdir=outdir)

rule downsampleInputs:
    input:
        matrix = os.path.join(config['inputpath'], "{mouse}_successive_char_matrix_collapsed.txt"),
        leafTissues = os.path.join(config['inputpath'], "{mouse}_successive_char_matrix_collapsing_dict.txt"),
    output:
        downsampledSimMatrix = "{outdir}/downsampled_data/{mouse}/downsampled_char_matrix.tsv",
        downsampledLeafTissues = "{outdir}/downsampled_data/{mouse}/downsampled_tissue_labels.tsv",
    params:
        outprefix = "{outdir}/downsampled_data/{mouse}/downsampled",
        scripts = config['scripts'],
        threads = config['threads'],
        threshold = config['downsample_threshold']
    conda:
        "../../envs/networkx.yaml"
    shell:
        """
        # add header to leaf tissues
        if ! grep -q "tissues" {input.leafTissues}; then
            sed -i '1i group_name\ttissues' {input.leafTissues}
        fi

        python {params.scripts}/formatting/downsample.py {input.matrix} {input.leafTissues} {params.threshold} {params.threads} {params.outprefix}
        """

rule prepMetastabayesInputs:
    input:
        downsampledSimMatrix = "{outdir}/downsampled_data/{mouse}/downsampled_char_matrix.tsv",
        downsampledLeafTissues = "{outdir}/downsampled_data/{mouse}/downsampled_tissue_labels.tsv",
    output:
        fasta = "{outdir}/metastabayes/{mouse}/{mouse}.fasta",
        dates = "{outdir}/metastabayes/{mouse}/{mouse}_date_traits.csv",
        tissues = "{outdir}/metastabayes/{mouse}/{mouse}_tip_tissues.csv",
        editRateProportions = "{outdir}/metastabayes/{mouse}/{mouse}_edit_rate_proportions.txt",
        expandedMatrix = "{outdir}/metastabayes/{mouse}/expanded_clones_matrix.tsv"
    params:
        outdir = "{outdir}/metastabayes/{mouse}",
        scripts = config['scripts'],
        experimentTime = lambda wildcards: config['experimentTime'][wildcards.mouse],
        threads = config['threads'],
        modelDropouts = config['modelDropouts'],
    conda:
        "../../envs/pandas.yaml"
    shell:
        """
        # expand clones found in multiple tissues to separate entries
        python {params.scripts}/formatting/expand_clones_multiple_tissues.py {input.downsampledSimMatrix} {input.downsampledLeafTissues} {params.outdir}
        matrixFile="{params.outdir}/expanded_clones_matrix.tsv"
        tissuesFile="{params.outdir}/expanded_clones_tissues.tsv"

        # write tip traits to new csv
        tail -n +2 $tissuesFile | grep -v '^$' | cut -f1,2 | tr '\t' ',' > {output.tissues}

        # write date trait
        tail -n +2 $tissuesFile | grep -v '^$' | cut -f1 | paste -d',' - <(yes {params.experimentTime} | head -n $(( $(wc -l < $tissuesFile) - 1 ))) > {output.dates}

        # get edit rate proportions for new mutation entries, relative to the first edit as 1.0 frequency
        all_muts=$(tail -n +2 $matrixFile | grep -v '^$' | cut -f2- | sed 's/-1/0/g' | tr '\t' ' ' | tr '\n' ' ')
        total_count=$( echo $all_muts | tr ' ' '\n' | grep -wv "0" | wc -l )
        uniq_count=$( echo $all_muts | tr ' ' '\n' | sort | uniq | grep -wv "0" | wc -l )
        count_1=$( echo $all_muts | tr ' ' '\n' | grep -wc "1" )

        for element in $(seq 1 $uniq_count); do
            count=$(echo "$all_muts" | tr ' ' '\n' | grep -wc "$element")
            proportion=$(bc <<< "scale=10; $count / $count_1")
            echo -e "$proportion\t" >> {output.editRateProportions}
        done

        # Format fasta with the option to replace site dropouts with the new int representation to be modeled by an independent silencing rate, or 0 to not model dropouts and just consider them as unedited sites
        if [ "{params.modelDropouts}" == "True" ] || [ "{params.modelDropouts}" == "true" ]; then
            # to model dropouts, use the highest mutation int representation and add 1 since the dropout column is the last in the rate matrix
            dropoutMutNum=$(( uniq_count + 1 ))
            tail -n +2 $matrixFile | grep -v '^$' | sed \"s/-1/$dropoutMutNum/g\" | awk '{{printf ">"$1"\\n"; for (i=2; i<=NF; i++) printf (i==NF ? $i"\\n" : $i",")}}' > {output.fasta}
        else
            # to not model dropouts
            tail -n +2 $matrixFile | grep -v '^$' | sed 's/-1/0/g' | awk '{{printf ">"$1"\\n"; for (i=2; i<=NF; i++) printf (i==NF ? $i"\\n" : $i",")}}' > {output.fasta}
        fi
        """

rule runCassiopeia:
    input:
        expandedMatrix = "{outdir}/metastabayes/{mouse}/expanded_clones_matrix.tsv"
    output:
        "{outdir}/cassiopeia_greedy/{mouse}/cassiopeia_greedy_inferred.nwk"
    params:
        cassiopeia_script = os.path.join(config['scripts'], "cassiopeia/cassiopeia_greedy.py"),
        outputdir = "{outdir}/cassiopeia_greedy/{mouse}"
    singularity:
        "../../envs/simulate.sif"
    shell:
        """
        # run cassiopeia greedy
        python {params.cassiopeia_script} {input.expandedMatrix} {params.outputdir}
        """

rule runLAML:
    input:
        expandedMatrix = "{outdir}/metastabayes/{mouse}/expanded_clones_matrix.tsv",
        casTree = "{outdir}/cassiopeia_greedy/{mouse}/cassiopeia_greedy_inferred.nwk"
    output:
        lamlTree = "{outdir}/laml/{mouse}/{mouse}_laml_trees.nwk",
        lamlAnnotations = "{outdir}/laml/{mouse}/{mouse}_laml_annotations.txt",
        lamlTreeNoBranchLengths = "{outdir}/laml/{mouse}/{mouse}_laml_trees_no_branch_lengths.nwk"
    params:
        outputdir = "{outdir}/laml/{mouse}",
        experimentTime = lambda wildcards: config['experimentTime'][wildcards.mouse],
    conda:
        "../../envs/laml.yaml"
    shell:
        """
        # copy matrix and replace -1 with ? for missing data
        cp {input.expandedMatrix} {outdir}/laml/{wildcards.mouse}/matrix.csv
        sed -i 's/-1/?/g; s/\t/,/g' {outdir}/laml/{wildcards.mouse}/matrix.csv

        # run laml
        run_laml -c {outdir}/laml/{wildcards.mouse}/matrix.csv -t {input.casTree} -o {params.outputdir}/{wildcards.mouse}_laml --timescale {params.experimentTime} --parallel

        # obtain newick without branch lengths
        sed 's/:\([0-9]\+\.\?\([0-9]\+\)\?\)//g' {output.lamlTree} > {output.lamlTreeNoBranchLengths}
        """

rule runMetastabayes:
    input:
        fasta = "{outdir}/metastabayes/{mouse}/{mouse}.fasta",
        dates = "{outdir}/metastabayes/{mouse}/{mouse}_date_traits.csv",
        tissues = "{outdir}/metastabayes/{mouse}/{mouse}_tip_tissues.csv",
        editRateProportions = "{outdir}/metastabayes/{mouse}/{mouse}_edit_rate_proportions.txt",
        lamlTree = "{outdir}/laml/{mouse}/{mouse}_laml_trees.nwk"
    output:
        terminalLog = "{outdir}/metastabayes/{mouse}/terminal_{num}.log",
        metastabayesLog = "{outdir}/metastabayes/{mouse}/chain_{num}.log",
        metastabayesResult = "{outdir}/metastabayes/{mouse}/chain_{num}.trees"
    params:
        xml = config['xml'],
        fileDir = "{outdir}/metastabayes/{mouse}",
        metastabayesJar = config['metastabayesJar'],
        experimentTime = lambda wildcards: config['experimentTime'][wildcards.mouse],
        mcmclength = config['mcmcLength'],
        primaryTissue = config['primaryTissue'],
        threads = config['threads']
    shell:
        """
        cp {params.xml} {params.fileDir}/{wildcards.num}.xml

        # calculate necessary inputs for the editing model
        initialEditRates=$(cat {input.editRateProportions} | tr '\n' ' ')
        array=($initialEditRates)
        numEditRates=${{#array[@]}}
        numEditRatesPlusTwo=$(( numEditRates + 2 ))

        # format tissue information
        unique_tissues=$(cat {input.tissues} | cut -d',' -f2 | sort | uniq)
        numTissues=$(echo $unique_tissues | tr ' ' '\n' | wc -l)
        numTissueRates=$(( numTissues * (numTissues - 1) ))
        equalTissueRates=$(echo "scale=10; 1.0 / $numTissueRates" | bc -l)
        equalTissueFreqs=$(echo "scale=10; 1.0 / $numTissues" | bc -l)
        tissueRootFreqs=$(for i in $(seq 1 $numTissues); do if [[ "$i" = "1" ]]; then echo -n "1 "; else echo -n "0 "; fi; done)

        # the current setup forces the known origin to be the primary if the primary is sampled in the tips, otherwise it allows for the primary to be any tissue of those sampled
        if echo "$unique_tissues" | grep -q -w "{params.primaryTissue}"; then
            sorted_unique_tissues="{params.primaryTissue} $(echo $unique_tissues | tr ' ' '\n' | grep -v '^{params.primaryTissue}$' | tr '\n' ' ')"
            tissueRootFreqs=$(for i in $(seq 1 $numTissues); do if [[ "$i" = "1" ]]; then echo -n "1 "; else echo -n "0 "; fi; done)
        else
            sorted_unique_tissues=$unique_tissues
            tissueRootFreqs=$(for i in $(seq 1 $numTissues); do echo -n "$equalTissueFreqs "; done)
        fi

        tissueCodeMap=""
        trailingCodeMap="? = "
        i=0
        for tissue in $sorted_unique_tissues; do
            tissueCodeMap+="$tissue=$i,"
            trailingCodeMap+="$i "
            i=$((i+1))
        done
        tissueCodeMap+="${{trailingCodeMap}}"

        # for some reason this cannot be taken in at the command line, likely because the = signs are problematic and not taken as a single string
        sed -i "s/\$(tissueCodeMap)/$tissueCodeMap/g" {params.fileDir}/{wildcards.num}.xml

        # use LAML starting tree
        # remove node names from newick and the origin node
        newick=$(cat {input.lamlTree} | sed 's/node[0-9]*:/:/g' | sed 's/^.//' | sed 's/..$//')

        java -Xmx10g -jar {params.metastabayesJar} \
        -threads {params.threads} \
        -overwrite \
        -working \
        -D inName={wildcards.mouse} \
        -D fileDir={params.fileDir} \
        -D newick=\"$newick\" \
        -D generations={params.experimentTime} \
        -D numEditRates=\"$numEditRates\" \
        -D numEditRatesPlusTwo=\"$numEditRatesPlusTwo\" \
        -D initialEditRates=\"$initialEditRates\" \
        -D numTissueRates=\"$numTissueRates\" \
        -D numTissues=\"$numTissues\" \
        -D equalTissueFreqs=\"$equalTissueFreqs\" \
        -D tissueRootFreqs=\"$tissueRootFreqs\" \
        -D mcmclength={params.mcmclength} \
        -D outname=chain_{wildcards.num} \
        {params.fileDir}/{wildcards.num}.xml > {output.terminalLog}
        """

