
import os
import sys
import glob

def get_sims():
    return [d for d in os.listdir(config['inputpath']) if os.path.isdir(os.path.join(config['inputpath'], d))]

sims = get_sims()

outdir = config['outdir']

rule all:
    input:
        expand("{outdir}/beam_information_content/{sim}/{num}/terminal_{num}.log", sim=sims, num=range(0, config['numReps']), outdir=outdir),
        expand("{outdir}/beam_information_content.pdf", outdir=outdir)


rule runCassiopeia:
    input:
        sim_matrix = lambda wildcards : glob.glob(os.path.join(config['inputpath'], wildcards.sim, "*_indel_character_matrix.tsv")),
    output:
        "{outdir}/cassiopeia_greedy/{sim}/cassiopeia_greedy_inferred.nwk"
    params:
        cassiopeia_script = os.path.join(config['scripts'], "cassiopeia/cassiopeia_greedy.py"),
        outputdir = "{outdir}/cassiopeia_greedy/{sim}",
    singularity:
        "../../envs/simulate.sif"
    shell:
        """
        # run cassiopeia greedy
        python {params.cassiopeia_script} {input.sim_matrix} {params.outputdir}
        """

rule runLAML:
    input:
        sim_matrix = lambda wildcards : glob.glob(os.path.join(config['inputpath'], wildcards.sim, "*_indel_character_matrix.tsv")),
        casTree = "{outdir}/cassiopeia_greedy/{sim}/cassiopeia_greedy_inferred.nwk"
    output:
        lamlTree = "{outdir}/laml/{sim}/{sim}_laml_trees.nwk",
    params:
        outputdir = "{outdir}/laml/{sim}",
        threads = 25
    conda:
        "../../envs/laml.yaml"
    shell:
        """
        # copy sim matrix and replace -1 with ? for missing data
        cp {input.sim_matrix} {outdir}/laml/{wildcards.sim}/sim_matrix.csv
        sed -i 's/-1/?/g; s/\t/,/g' {outdir}/laml/{wildcards.sim}/sim_matrix.csv

        # run laml
        run_laml -c {outdir}/laml/{wildcards.sim}/sim_matrix.csv -t {input.casTree} -o {params.outputdir}/{wildcards.sim}_laml --parallel
        """

rule prepBeamInputs:
    input:
        sim_matrix = lambda wildcards : glob.glob(os.path.join(config['inputpath'], wildcards.sim, "*_indel_character_matrix.tsv")),
        leafTissues = lambda wildcards: glob.glob(os.path.join(config['inputpath'], wildcards.sim,"cell_tree_*[0-9].labeling")),
    output:
        fasta = "{outdir}/beam_prep/{sim}/{sim}.fasta",
        dates = "{outdir}/beam_prep/{sim}/{sim}_date_traits.csv",
        tissues = "{outdir}/beam_prep/{sim}/{sim}_tip_tissues.csv",
    params:
        scripts = config['scripts'],
        generations = config['generations'],
        outputdir = "{outdir}/beam_prep/{sim}"
    conda:
        "../../envs/compare_trees.yaml"
    shell:
        """
        # write tip traits to new csv
        sed 's/ /,/g' {input.leafTissues} > {output.tissues}

        # write date trait
        sed 's/ /,/g' {input.leafTissues} | cut -d',' -f1 | paste -d',' - <(yes {params.generations} | head -n $(wc -l < {input.leafTissues})) > {output.dates}

        # format fasta, re-label mutations sequentially, and get edit rate proportions for new mutation entries
        {params.scripts}/formatting/format_beam_input_files.py {input.sim_matrix} {params.outputdir}
        """

rule runBeam:
    input:
        fasta = "{outdir}/beam_prep/{sim}/{sim}.fasta",
        dates = "{outdir}/beam_prep/{sim}/{sim}_date_traits.csv",
        tissues = "{outdir}/beam_prep/{sim}/{sim}_tip_tissues.csv",
        lamlTree = "{outdir}/laml/{sim}/{sim}_laml_trees.nwk",
    output:
        terminalLog = "{outdir}/beam_information_content/{sim}/{num}/terminal_{num}.log",
    params:
        xml = config['xmlTemplate'],
        fileDir = "{outdir}/beam_prep/{sim}",
        outDir = "{outdir}/beam_information_content/{sim}/{num}",
        beamJar = config['beamJar'],
        generations = config['generations'],
        primaryTissue = config['primaryTissue'],
        numParticles = config['numParticles'],
        threads = 5
    shell:
        """
        cp {params.xml} {params.outDir}/{wildcards.num}.xml

        # use LAML starting tree
        # remove node names from newick and the origin node
        newick=$(cat {input.lamlTree} | sed 's/node[0-9]*:/:/g' | sed 's/^.//' | sed 's/..$//')

        # calculate necessary inputs for the editing model
        initialEditRates=$(cat {wildcards.outdir}/beam_prep/{wildcards.sim}/{wildcards.sim}_edit_rate_proportions.txt)
        array=($initialEditRates)
        numEditRates=${{#array[@]}}
        numEditRatesPlusTwo=$(( numEditRates + 2 ))

        # format tissue information
        unique_tissues=$(cat {input.tissues} | cut -d',' -f2 | sort | uniq)
        numTissues=$(echo $unique_tissues | tr ' ' '\n' | wc -l)

        # force the known known primary tissue at the origin for root frequencies in the likelihood calculation
        sorted_unique_tissues="{params.primaryTissue} $(echo $unique_tissues | tr ' ' '\n' | grep -v '^{params.primaryTissue}$' | tr '\n' ' ')"
        if ! echo "$unique_tissues" | grep -qw "{params.primaryTissue}"; then
            numTissues=$(( numTissues + 1 ))
        fi
        tissueRootFreqs=$(for i in $(seq 1 $numTissues); do if [[ "$i" = "1" ]]; then echo -n "1 "; else echo -n "0 "; fi; done)

        # key to prep the correct rate matrix 
        numTissueRates=$(( numTissues * (numTissues - 1) ))

        equalTissueRates=$(echo "scale=10; 1.0 / $numTissueRates" | bc -l)
        equalTissueFreqs=$(echo "scale=10; 1.0 / $numTissues" | bc -l)

        tissueCodeMap=""
        trailingCodeMap="? = "
        i=0
        for tissue in $sorted_unique_tissues; do
            tissueCodeMap+="$tissue=$i,"
            trailingCodeMap+="$i "
            i=$((i+1))
        done
        tissueCodeMap+="${{trailingCodeMap}}"

        # for some reason this cannot be taken in at the command line, likely because the = signs are problematic and not taken as a single string
        sed -i "s/\$(tissueCodeMap)/$tissueCodeMap/g" {params.outDir}/{wildcards.num}.xml

        java -Xmx10g -jar {params.beamJar} \
        -threads {params.threads} \
        -overwrite \
        -working \
        -D inName={wildcards.sim} \
        -D fileDir={params.fileDir} \
        -D newick=\"$newick\" \
        -D generations={params.generations} \
        -D numEditRates=\"$numEditRates\" \
        -D numEditRatesPlusTwo=\"$numEditRatesPlusTwo\" \
        -D initialEditRates=\"$initialEditRates\" \
        -D numTissueRates=\"$numTissueRates\" \
        -D numTissues=\"$numTissues\" \
        -D equalTissueFreqs=\"$equalTissueFreqs\" \
        -D tissueRootFreqs=\"$tissueRootFreqs\" \
        -D numParticles={params.numParticles} \
        -D outname={wildcards.num} \
        {params.outDir}/{wildcards.num}.xml > {output.terminalLog}
        """

rule collectInformation:
    input:
        logs = expand("{outdir}/beam_information_content/{sim}/{num}/terminal_{num}.log", sim=sims, num=range(0, config['numReps']), outdir=outdir)
    output:
        csv = "{outdir}/beam_information_content.csv"
    shell:
        """
        echo "sim_name,information_content" > {output.csv}

        for file in {input.logs}; do
            sim_name=$(basename $(dirname $(dirname $file)))
            information=$(grep "Information:" $file | tail -n 1 | cut -d' ' -f2)
            echo "$sim_name,$information" >> {output.csv}
        done
        """

rule plotInformation:
    input:
        csv = "{outdir}/beam_information_content.csv"
    output:
        plot = "{outdir}/beam_information_content.pdf"
    params:
        scripts = config['scripts'],
    conda:
        "../../envs/matplotlib.yaml"
    shell:
        """
        python {params.scripts}/plotting/plot_information_from_csv.py {input.csv} {output.plot}
        """
