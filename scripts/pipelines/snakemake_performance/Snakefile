    params:
        scripts = config['scripts'],
        outputdir = "{outdir}/machina/{sim}",
        threads = 1,
        mem = '1G'
    singularity:
        "../../envs/simulate.sif"
    shell:
        """
        python {params.scripts}/machina/post_machina_tr_to_tree.py {input.machinaTree} {input.machinaTissues} {params.outputdir}
        """

rule runMach2:
    input:
        labeling = "{outdir}/machina/{sim}/{sim}_laml_trees_no_origin_no_branch_lengths.labeling",
        edges = "{outdir}/machina/{sim}/{sim}_laml_trees_no_origin_no_branch_lengths.tree",
        colors = "{outdir}/machina/{sim}/{sim}_laml_trees_no_origin_no_branch_lengths_colors.txt",
    output:
        mach2tree = "{outdir}/mach2/{sim}/P-T-0.tree",
        mach2labeling = "{outdir}/mach2/{sim}/P-T-0.labeling",
        mach2graph = "{outdir}/mach2/{sim}/P-G-0.graph",
    params:
        scripts = config['scripts'],
        outputdir = "{outdir}/mach2/{sim}",
        primaryTissue = config['primaryTissue'],
        threads = 50,
        mem = '5G'
    conda:
        "../../envs/mach2.yaml"
    shell:
        """
        # load Gurobi license (specific to CSHL HPC; will need to be modified on other systems)
        module load EBModules
        module load Gurobi

        unique_tissues=$(cut -f2 {input.labeling} | sort | uniq)
        num_unique_tissues=$(echo "$unique_tissues" | wc -l)

        if [ "$num_unique_tissues" -gt 1 ]; then
            # check if primary tissue is in the labeling file
            if grep -q "{params.primaryTissue}" {input.labeling}; then
                mach2 {input.edges} {input.labeling} --colormap {input.colors} -p {params.primaryTissue} --log -o {params.outputdir} -t {params.threads}

                # Need to touch output files to satisfy output, only if output with a different name exists
                if [ $(ls {params.outputdir}/*.graph | wc -l) -gt 0 ] && [ ! -f {output.mach2graph} ]; then
                    touch {output}
                fi
            else
                most_common_tissue=$(cut -f2 {input.labeling} | sort | uniq -c | sort -nr | head -n 1 | awk '{{print $2}}')
                echo "The {params.primaryTissue} is not in the tissue labels. Using the most common tissue $most_common_tissue as the primary tissue."
                mach2 {input.edges} {input.labeling} --colormap {input.colors} -p $most_common_tissue --log -o {params.outputdir} -t {params.threads}

                # Need to touch output files to satisfy output, only if output with a different name exists
                if [ $(ls {params.outputdir}/*.graph | wc -l) -gt 0 ] && [ ! -f {output.mach2graph} ]; then
                    touch {output}
                fi
            fi
        else
            echo "Only one unique tissue found in the labeling file, so not enough to run Machina. Exiting."
        fi
        """

rule gatherMach2Results:
    input:
        mach2graph = "{outdir}/mach2/{sim}/P-G-0.graph"
    output:
        mach2Combined = "{outdir}/mach2/{sim}/graph_results_combined.txt",
        mach2Consensus = "{outdir}/mach2/{sim}/consensus_graph.txt",
    params:
        scripts = config['scripts'],
        outputdir = "{outdir}/mach2/{sim}",
        threads = 1,
        mem = '1G'
    shell:
        """
        # get all graph files
        results=$(find $(dirname {input.mach2graph}) -name "*.graph")

        # combine all results
        echo "result_num,source,target,count" > {output.mach2Combined}
        for file in $results; do
            result_num=$(basename $file | cut -d'-' -f3 | cut -d'.' -f1)
            while IFS= read -r line; do
                echo "$result_num,$(echo $line | tr ' ' ',')" >> {output.mach2Combined}
            done < "$file"
        done

        # get the probability weighted edge consensus graph
        python {params.scripts}/formatting/convert_mach2_results_to_consensus_graph.py {output.mach2Combined} {output.mach2Consensus}
        """

rule prepMetient:
    input:
        lamlTreeNoOrigin = "{outdir}/laml/{sim}/{sim}_laml_trees_no_origin.nwk",
        leafTissues = lambda wildcards: glob.glob(os.path.join(config['inputpath'], wildcards.sim,"cell_tree_*[0-9].labeling"))
    output:
        metientTree = "{outdir}/metient/{sim}/tree.txt",
        metientTsv = "{outdir}/metient/{sim}/metadata.tsv"
    params:
        primaryTissue = config['primaryTissue'],
        scripts = config['scripts'],
        outputdir = "{outdir}/metient/{sim}",
        threads = 1,
        mem = '1G'
    conda:
        "../../envs/compare_trees.yaml"
    shell:
        """
        # format tsv file and edge list
        python {params.scripts}/metient/format_metient.py {input.lamlTreeNoOrigin} {input.leafTissues} {params.primaryTissue} {params.outputdir}
        """

rule runMetient:
