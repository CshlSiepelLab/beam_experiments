
import os
import sys
import glob

def get_sims():
    return [d for d in os.listdir(config['inputpath']) if os.path.isdir(os.path.join(config['inputpath'], d))]

sims = get_sims()
outdir = config['outdir']

rule all:
    input:
        expand("{outdir}/raw_data/{sim}/tissue_labeled_tree.nwk", sim=sims, outdir=outdir),
        expand("{outdir}/machina/{sim}/machina_tree_all_tissue_labels.nwk", sim=sims, outdir=outdir),
        expand("{outdir}/metastabayes/{sim}/terminal_{num}.log", sim=sims, num=range(1, config['numChains']+1), outdir=outdir),
        expand("{outdir}/metastabayes/{sim}/combined.log", sim=sims, outdir=outdir),
        expand("{outdir}/random_consensus_tissue_inference/{sim}/random_tissues.nwk", sim=sims, outdir=outdir),
        f"{outdir}/precision_recall_curve/precision_recall.pdf",
        expand("{outdir}/metient/{sim}/{sim}_{primaryTissue}_migration_graphs.txt", sim=sims, outdir=outdir, primaryTissue=config['primaryTissue']),
        expand("{outdir}/pathfinder/{sim}/clone_aln_all_output_counts.txt", sim=sims, outdir=outdir)

rule copyDataToOutDir:
    input:
        lambda wildcards: os.path.join(config['inputpath'], wildcards.sim)
    output:
        os.path.join(outdir, "raw_data/{sim}", "done")
    shell:
        """
        outdir=$(dirname $(dirname {output}))
        cp -r {input} $outdir
        touch {output}
        """

rule prepMetastabayesInputs:
    input:
        os.path.join(outdir, "raw_data/{sim}", "done"),
        sim_matrix = lambda wildcards : glob.glob(os.path.join(wildcards.outdir, "raw_data", wildcards.sim, "*_indel_character_matrix.tsv")),
        leafTissues = lambda wildcards: glob.glob(os.path.join(wildcards.outdir, "raw_data", wildcards.sim,"cell_tree_*[0-9].labeling")),
    output:
        fasta = "{outdir}/metastabayes/{sim}/{sim}.fasta",
        dates = "{outdir}/metastabayes/{sim}/{sim}_date_traits.csv",
        tissues = "{outdir}/metastabayes/{sim}/{sim}_tip_tissues.csv",
    params:
        scripts = config['scripts'],
        generations = config['generations'],
        outputdir = "{outdir}/metastabayes/{sim}"
    conda:
        "envs/compare_trees.yaml"
    shell:
        """
        # write tip traits to new csv
        sed 's/ /,/g' {input.leafTissues} > {output.tissues}

        # write date trait
        sed 's/ /,/g' {input.leafTissues} | cut -d',' -f1 | paste -d',' - <(yes {params.generations} | head -n $(wc -l < {input.leafTissues})) > {output.dates}

        # format fasta, re-label mutations sequentially, and get edit rate proportions for new mutation entries
        {params.scripts}/formatting/format_metastabayes_input_files.py {input.sim_matrix} {params.outputdir}
        """

rule runMetastabayes:
    input:
        fasta = "{outdir}/metastabayes/{sim}/{sim}.fasta",
        dates = "{outdir}/metastabayes/{sim}/{sim}_date_traits.csv",
        tissues = "{outdir}/metastabayes/{sim}/{sim}_tip_tissues.csv",
    output:
        terminalLog = "{outdir}/metastabayes/{sim}/terminal_{num}.log",
        metastabayesLog = "{outdir}/metastabayes/{sim}/chain_{num}.log",
        metastabayesResult = "{outdir}/metastabayes/{sim}/chain_{num}.trees"
    params:
        xml = config['xml'],
        fileDir = "{outdir}/metastabayes/{sim}",
        metastabayesJar = config['metastabayesJar'],
        generations = config['generations'],
        mcmclength = config['mcmcLength'],
        primaryTissue = config['primaryTissue'],
        threads = config['threads']
    shell:
        """
        cp {params.xml} {params.fileDir}/{wildcards.num}.xml

        # calculate necessary inputs for the editing model
        initialEditRates=$(cat {wildcards.outdir}/metastabayes/{wildcards.sim}/{wildcards.sim}_edit_rate_proportions.txt)
        array=($initialEditRates)
        numEditRates=${{#array[@]}}
        numEditRatesPlusTwo=$(( numEditRates + 2 ))

        # format tissue information
        unique_tissues=$(cat {input.tissues} | cut -d',' -f2 | sort | uniq)
        numTissues=$(echo $unique_tissues | tr ' ' '\n' | wc -l)
        numTissueRates=$(( numTissues * (numTissues - 1) ))
        equalTissueRates=$(echo "scale=10; 1.0 / $numTissueRates" | bc -l)
        equalTissueFreqs=$(echo "scale=10; 1.0 / $numTissues" | bc -l)
        tissueRootFreqs=$(for i in $(seq 1 $numTissues); do if [[ "$i" = "1" ]]; then echo -n "1 "; else echo -n "0 "; fi; done)

        if echo "$unique_tissues" | grep -q -w "{params.primaryTissue}"; then
            sorted_unique_tissues="{params.primaryTissue} $(echo $unique_tissues | tr ' ' '\n' | grep -v '^{params.primaryTissue}$' | tr '\n' ' ')"
            tissueRootFreqs=$(for i in $(seq 1 $numTissues); do if [[ "$i" = "1" ]]; then echo -n "1 "; else echo -n "0 "; fi; done)
        else
            sorted_unique_tissues=$unique_tissues
            tissueRootFreqs=$(for i in $(seq 1 $numTissues); do echo -n "$equalTissueFreqs "; done)
        fi

        tissueCodeMap=""
        trailingCodeMap="? = "
        i=0
        for tissue in $sorted_unique_tissues; do
            tissueCodeMap+="$tissue=$i,"
            trailingCodeMap+="$i "
            i=$((i+1))
        done
        tissueCodeMap+="${{trailingCodeMap}}"

        # for some reason this cannot be taken in at the command line, likely because the = signs are problematic and not taken as a single string
        sed -i "s/\$(tissueCodeMap)/$tissueCodeMap/g" {params.fileDir}/{wildcards.num}.xml

        java -Xmx10g -jar {params.metastabayesJar} \
        -threads {params.threads} \
        -overwrite \
        -working \
        -D inName={wildcards.sim} \
        -D fileDir={params.fileDir} \
        -D generations={params.generations} \
        -D numEditRates=\"$numEditRates\" \
        -D numEditRatesPlusTwo=\"$numEditRatesPlusTwo\" \
        -D initialEditRates=\"$initialEditRates\" \
        -D numTissueRates=\"$numTissueRates\" \
        -D numTissues=\"$numTissues\" \
        -D equalTissueFreqs=\"$equalTissueFreqs\" \
        -D tissueRootFreqs=\"$tissueRootFreqs\" \
        -D mcmclength={params.mcmclength} \
        -D outname=chain_{wildcards.num} \
        {params.fileDir}/{wildcards.num}.xml > {output.terminalLog}
        """

rule combineMetastabayesChains:
    input:
        terminalLog = lambda wildcards: expand("{outdir}/metastabayes/{sim}/terminal_{num}.log", num=range(1, config['numChains']+1), sim=wildcards.sim, outdir=wildcards.outdir),
        metastabayesLogs = lambda wildcards: glob.glob(os.path.join(wildcards.outdir, "metastabayes", wildcards.sim, "chain_*.log")),
        metastabayesResults = lambda wildcards: glob.glob(os.path.join(wildcards.outdir, "metastabayes", wildcards.sim, "*.trees"))
    output:
        combinedLog = "{outdir}/metastabayes/{sim}/combined.log",
        combinedTrees = "{outdir}/metastabayes/{sim}/combined.trees",
        combinedMCC = "{outdir}/metastabayes/{sim}/combined.mcc.tree"
    params:
        logcombiner = config['logcombiner'],
        essCutoff = config['essCutoff'],
        treeannotator = config['treeannotator']
    shell:
        """
        # find chains that have converged based on ess threshold specified
        log_files=""
        trees_files=""
        ess_convergences=()
        for file in {input.metastabayesLogs}; do
            terminal_log=$(echo $file | sed 's/chain_/terminal_/')
            ess_convergence=$(awk '/Operator/ {{ found=1; next }} {{ if (!found) print }}' "$terminal_log" | awk '{{if (NF > 0) print}}' | tail -n 1 | awk '{{print int($3 + 0.5)}}')
            
            # only use mcmc chains that have converged since many appear to get lost in the search space
            if [[ $ess_convergence -gt {params.essCutoff} ]]; then
                log_files+="-log $file "
                trees_file=$(echo $file | sed 's/\.log$/.trees/')
                trees_files+="-log $trees_file "
            else
                echo "$file did not converge, so not including it in the final output"
            fi
        done

        # combine logs and trees that passed
        {params.logcombiner} $log_files -o {output.combinedLog}
        {params.logcombiner} $trees_files -o {output.combinedTrees}

        # get MCC tree from the combined trees file
        {params.treeannotator} -lowMem true -burnin 10 -topology CCD0 -height mean {output.combinedTrees} {output.combinedMCC}
        """

rule runCassiopeia:
    input:
        os.path.join(outdir, "raw_data/{sim}", "done"),
        sim_matrix = lambda wildcards : glob.glob(os.path.join(wildcards.outdir, "raw_data", wildcards.sim, "*_indel_character_matrix.tsv")),
    output:
        "{outdir}/cassiopeia_greedy/{sim}/cassiopeia_greedy_inferred.nwk"
    params:
        cassiopeia_script = os.path.join(config['scripts'], "cassiopeia/cassiopeia_greedy.py"),
        outputdir = "{outdir}/cassiopeia_greedy/{sim}"
    singularity:
        "envs/simulate.sif"
    shell:
        """
        # run cassiopeia greedy
        python {params.cassiopeia_script} {input.sim_matrix} {params.outputdir}
        """

rule runLAML:
    input:
        sim_matrix = lambda wildcards : glob.glob(os.path.join(wildcards.outdir, "raw_data", wildcards.sim, "*_indel_character_matrix.tsv")),
        casTree = "{outdir}/cassiopeia_greedy/{sim}/cassiopeia_greedy_inferred.nwk"
    output:
        lamlTree = "{outdir}/laml/{sim}/{sim}_laml_trees.nwk",
        lamlAnnotations = "{outdir}/laml/{sim}/{sim}_laml_annotations.txt",
        lamlTreeNoBranchLengths = "{outdir}/laml/{sim}/{sim}_laml_trees_no_branch_lengths.nwk"
    params:
        outputdir = "{outdir}/laml/{sim}"
    conda:
        "envs/laml.yaml"
    shell:
        """
        # copy sim matrix and replace -1 with ? for missing data
        cp {input.sim_matrix} {outdir}/laml/{wildcards.sim}/sim_matrix.csv
        sed -i 's/-1/?/g; s/\t/,/g' {outdir}/laml/{wildcards.sim}/sim_matrix.csv

        # run laml
        run_laml -c {outdir}/laml/{wildcards.sim}/sim_matrix.csv -t {input.casTree} -o {params.outputdir}/{wildcards.sim}_laml

        # remove fake root from tree
        fixed_newick=$(sed "s/);//g" {output.lamlTree})
        fixed_newick="${{fixed_newick:1}});"
        last_branch=$(echo "$fixed_newick" | grep -oP ':[0-9]+\.[0-9]+(?=\)\;)' | tail -1 | tr -d ':')
        second_last_branch=$(echo "$fixed_newick" | grep -oP ':[0-9]+\.[0-9]+(?=\))' | tail -2 | head -1 | tr -d ':')
        new_branch=$(echo "$last_branch + $second_last_branch" | bc)
        modified_newick=$(echo "$fixed_newick" | sed -r "s/$second_last_branch\):$last_branch/0$new_branch/g")

        echo $modified_newick > {output.lamlTree}

        # obtain newick without branch lengths
        sed 's/:\([0-9]\+\.\?\([0-9]\+\)\?\)//g' {output.lamlTree} > {output.lamlTreeNoBranchLengths}
        """

rule runRandomAndConsensusTissueInference:
    input:
        lamlTreeNoBranchLengths = "{outdir}/laml/{sim}/{sim}_laml_trees_no_branch_lengths.nwk",
        leafTissues = lambda wildcards: glob.glob(os.path.join(wildcards.outdir, "raw_data", wildcards.sim,"cell_tree_*[0-9].labeling"))
