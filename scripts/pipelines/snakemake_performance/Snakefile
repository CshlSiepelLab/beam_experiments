
import os
import sys
import glob

def get_sims():
    return [d for d in os.listdir(config['inputpath']) if os.path.isdir(os.path.join(config['inputpath'], d))]

sims = get_sims()
outdir = config['outdir']

rule all:
    input:
        expand("{outdir}/raw_data/{sim}/tissue_labeled_tree.nwk", sim=sims, outdir=outdir),
        expand("{outdir}/raw_data/{sim}/true_tissue_migration_graph.pdf", sim=sims, outdir=outdir),
        expand("{outdir}/machina/{sim}/machina_tree_all_tissue_labels.nwk", sim=sims, outdir=outdir),
        expand("{outdir}/mach2/{sim}/P-G-0.graph", outdir=outdir, sim=sims),
        expand("{outdir}/mach2/{sim}/consensus_graph.txt", outdir=outdir, sim=sims),
        expand("{outdir}/beam_gtr/{sim}/terminal_{num}.log", sim=sims, num=range(1, config['numChains']+1), outdir=outdir),
        expand("{outdir}/beam_gtr/{sim}/combined.log", sim=sims, outdir=outdir),
        # expand("{outdir}/beam_gtr/incomplete.txt", outdir=outdir),
        expand("{outdir}/gtr_beam_mutual_information.csv", outdir=outdir),
        expand("{outdir}/beam_gtr/{sim}/probability_migration_graph.pdf", sim=sims, outdir=outdir),
        expand("{outdir}/beam_gtr/{sim}/combined_migration_graph_1.pdf", sim=sims, outdir=outdir),
        expand("{outdir}/random_consensus_parsimony_tissue_inference/{sim}/random_tissues.nwk", sim=sims, outdir=outdir),
        expand("{outdir}/cassiopeia_fitch_count/{sim}/cassiopeia_fitch_hartigan_result.nwk", sim=sims, outdir=outdir),
        f"{outdir}/precision_recall_curve/precision_recall.pdf",
        expand("{outdir}/metient/{sim}/{sim}_{primaryTissue}_migration_graphs.txt", sim=sims, outdir=outdir, primaryTissue=config['primaryTissue']),
        # expand("{outdir}/beam_gtr_ns/{sim}/terminal_{num}.log", sim=sims, num=range(1, 11), outdir=outdir),
        # expand("{outdir}/beam_random_ns/{sim}/terminal_{num}.log", sim=sims, num=range(1, 11), outdir=outdir),


rule runCassiopeia:
    input:
        sim_matrix = lambda wildcards : glob.glob(os.path.join(config['inputpath'], wildcards.sim, "*_indel_character_matrix.tsv")),
    output:
        "{outdir}/cassiopeia_greedy/{sim}/cassiopeia_greedy_inferred.nwk"
    params:
        cassiopeia_script = os.path.join(config['scripts'], "cassiopeia/cassiopeia_greedy.py"),
        outputdir = "{outdir}/cassiopeia_greedy/{sim}",
        threads = 1,
        mem = '1G'
    singularity:
        "../../envs/simulate.sif"
    shell:
        """
        # run cassiopeia greedy
        python {params.cassiopeia_script} {input.sim_matrix} {params.outputdir}
        """

rule runLAML:
    input:
        sim_matrix = lambda wildcards : glob.glob(os.path.join(config['inputpath'], wildcards.sim, "*_indel_character_matrix.tsv")),
        casTree = "{outdir}/cassiopeia_greedy/{sim}/cassiopeia_greedy_inferred.nwk",
        mutationPriors = config['mutationPriors']
    output:
        lamlTreeOriginal = "{outdir}/laml/{sim}/{sim}_laml_trees.nwk",
        lamlTreeNoOrigin = "{outdir}/laml/{sim}/{sim}_laml_trees_no_origin.nwk",
        lamlAnnotations = "{outdir}/laml/{sim}/{sim}_laml_annotations.txt",
        lamlTreeNoBranchLengths = "{outdir}/laml/{sim}/{sim}_laml_trees_no_origin_no_branch_lengths.nwk"
    params:
        scripts = config['scripts'],
        outputdir = "{outdir}/laml/{sim}",
        experimentTime = config['generations'],
        threads = 50,
        mem = '1G'
    conda:
        "../../envs/laml.yaml"
    shell:
        """
        # copy sim matrix and replace -1 with ? for missing data
        laml_sim_matrix={outdir}/laml/{wildcards.sim}/sim_matrix.csv
        cp {input.sim_matrix} $laml_sim_matrix
        sed -i 's/-1/?/g; s/\t/,/g' $laml_sim_matrix

        # setup the Q matrix mutation priors for the mutations found in the sim matrix
        # laml requires a site specific format, so this is just a reformatting step of the input priors
        mutationPriors={params.outputdir}/mutation_priors.csv
        python {params.scripts}/formatting/format_laml_mutation_priors.py $laml_sim_matrix {input.mutationPriors} $mutationPriors

        # run laml
        run_laml -c $laml_sim_matrix -t {input.casTree} -p $mutationPriors -o {params.outputdir}/{wildcards.sim}_laml --timescale {params.experimentTime} --parallel

        # remove fake root from tree
        fixed_newick=$(sed "s/);//g" {output.lamlTreeOriginal})
        fixed_newick="${{fixed_newick:1}});"
        last_branch=$(echo "$fixed_newick" | grep -oP ':[0-9]+\.[0-9]+(?=\)\;)' | tail -1 | tr -d ':')
        second_last_branch=$(echo "$fixed_newick" | grep -oP ':[0-9]+\.[0-9]+(?=\))' | tail -2 | head -1 | tr -d ':')
        new_branch=$(echo "$last_branch + $second_last_branch" | bc)
        modified_newick=$(echo "$fixed_newick" | sed -r "s/$second_last_branch\):$last_branch/0$new_branch/g")

        echo $modified_newick > {output.lamlTreeNoOrigin}

        # obtain newick without branch lengths
        sed 's/:\([0-9]\+\.\?\([0-9]\+\)\?\)//g' {output.lamlTreeNoOrigin} > {output.lamlTreeNoBranchLengths}
        """

rule prepBeamInputs:
    input:
        sim_matrix = lambda wildcards : glob.glob(os.path.join(config['inputpath'], wildcards.sim, "*_indel_character_matrix.tsv")),
        leafTissues = lambda wildcards: glob.glob(os.path.join(config['inputpath'], wildcards.sim,"cell_tree_*[0-9].labeling")),
    output:
        fasta = "{outdir}/beam/{sim}/{sim}.fasta",
        tissues = "{outdir}/beam/{sim}/{sim}_tip_tissues.csv",
        editRateProportions = "{outdir}/beam/{sim}/{sim}_edit_rate_proportions.txt",
    params:
        scripts = config['scripts'],
        generations = config['generations'],
        outputdir = "{outdir}/beam/{sim}",
        threads = 1,
        mem = '1G'
    conda:
        "../../envs/compare_trees.yaml"
    shell:
        """
        # write tip traits to new csv
        sed 's/ /,/g' {input.leafTissues} > {output.tissues}

        # format fasta, re-label mutations sequentially, and get edit rate proportions for new mutation entries
        {params.scripts}/formatting/format_beam_input_files.py {input.sim_matrix} {params.outputdir}
        """

rule runBeam:
    input:
        fasta = "{outdir}/beam/{sim}/{sim}.fasta",
        tissues = "{outdir}/beam/{sim}/{sim}_tip_tissues.csv",
        editRateProportions = "{outdir}/beam/{sim}/{sim}_edit_rate_proportions.txt",
        lamlTreeOriginal = "{outdir}/laml/{sim}/{sim}_laml_trees.nwk",
    output:
        terminalLog = "{outdir}/beam_gtr/{sim}/terminal_{num}.log",
        beamLog = "{outdir}/beam_gtr/{sim}/chain_{num}.log",
        beamResult = "{outdir}/beam_gtr/{sim}/chain_{num}.trees"
    params:
        xml = config['gtrXml'],
        inFileDir = "{outdir}/beam/{sim}",
        fileDir = "{outdir}/beam_gtr/{sim}",
        beamJar = config['beamJar'],
        generations = config['generations'],
        mcmclength = config['mcmcLength'],
        primaryTissue = config['primaryTissue'],
        threads = 5,
        mem= '2G'
    shell:
        """
        cp {params.xml} {params.fileDir}/{wildcards.num}.xml

        # calculate necessary inputs for the editing model
        initialEditRates=$(cat {input.editRateProportions} | tr '\\n' ' ')
        array=($initialEditRates)
        numEditRates=${{#array[@]}}
        numEditRatesPlusTwo=$(( numEditRates + 2 ))

        # format tissue information
        unique_tissues=$(cat {input.tissues} | cut -d',' -f2 | sort | uniq)
        numTissues=$(echo $unique_tissues | tr ' ' '\n' | wc -l)

        # force the known known primary tissue at the origin for root frequencies in the likelihood calculation
        sorted_unique_tissues="{params.primaryTissue} $(echo $unique_tissues | tr ' ' '\n' | grep -v '^{params.primaryTissue}$' | tr '\n' ' ')"
        if ! echo "$unique_tissues" | grep -qw "{params.primaryTissue}"; then
            numTissues=$(( numTissues + 1 ))
        fi
        tissueRootFreqs=$(for i in $(seq 1 $numTissues); do if [[ "$i" = "1" ]]; then echo -n "1 "; else echo -n "0 "; fi; done)

        numTissueRates=$(( ((numTissues * numTissues) - numTissues) / 2 ))

        tissueCodeMap=""
        trailingCodeMap="? = "
        i=0
        for tissue in $sorted_unique_tissues; do
            tissueCodeMap+="$tissue=$i,"
            trailingCodeMap+="$i "
            i=$((i+1))
        done
        tissueCodeMap+="${{trailingCodeMap}}"

        # for some reason this cannot be taken in at the command line, likely because the = signs are problematic and not taken as a single string
        sed -i "s/\$(tissueCodeMap)/$tissueCodeMap/g" {params.fileDir}/{wildcards.num}.xml

        # use LAML starting tree
        # remove node names from newick and the origin node
        newick=$(cat {input.lamlTreeOriginal} | sed 's/node[0-9]*:/:/g' | sed 's/^.//' | sed 's/..$//')

        java -Xmx10g -jar {params.beamJar} \
        -threads {params.threads} \
        -resume \
        -working \
        -D inName={wildcards.sim} \
        -D fileDir={params.inFileDir} \
        -D newick=\"$newick\" \
        -D generations={params.generations} \
        -D numEditRates=\"$numEditRates\" \
        -D numEditRatesPlusTwo=\"$numEditRatesPlusTwo\" \
        -D initialEditRates=\"$initialEditRates\" \
        -D numTissueRates=\"$numTissueRates\" \
        -D numTissues=\"$numTissues\" \
        -D tissueRootFreqs=\"$tissueRootFreqs\" \
        -D mcmclength={params.mcmclength} \
        -D outname=chain_{wildcards.num} \
        {params.fileDir}/{wildcards.num}.xml > {output.terminalLog}
        """

rule combineBeamChains:
    input:
        terminalLog = lambda wildcards: expand("{outdir}/beam_gtr/{sim}/terminal_{num}.log", num=range(1, config['numChains']+1), sim=wildcards.sim, outdir=wildcards.outdir),
        beamLogs = lambda wildcards: expand("{outdir}/beam_gtr/{sim}/chain_{num}.log", num=range(1, config['numChains']+1), sim=wildcards.sim, outdir=wildcards.outdir),
        beamResults = lambda wildcards: expand("{outdir}/beam_gtr/{sim}/chain_{num}.trees", num=range(1, config['numChains']+1), sim=wildcards.sim, outdir=wildcards.outdir),
    output:
        combinedLog = "{outdir}/beam_gtr/{sim}/combined.log",
        combinedTrees = "{outdir}/beam_gtr/{sim}/combined.trees"
    params:
        logcombiner = config['logcombiner'],
        essCutoff = config['essCutoff'],
        treeannotator = config['treeannotator'],
        threads = 1,
        mem = '1G'
    shell:
        """
        # find chains that have converged based on ess threshold specified
        log_files=""
        trees_files=""
        ess_convergences=()
        for file in {input.beamLogs}; do
            terminal_log=$(echo $file | sed 's/chain_/terminal_/')
            
            ess_convergence=$(grep "Msamples" $terminal_log | tail -n 1 | sed 's/^ *//;s/ *$//' | tr -s ' ' | cut -d' ' -f3)
            if (( $(echo "$ess_convergence > {params.essCutoff}" | bc -l) )); then
                log_files+="-log $file "
                trees_file=$(echo $file | sed 's/\.log$/.trees/')
                trees_files+="-log $trees_file "
            else
                echo "$file did not converge, so not including it in the final output"z
            fi
        done

        # combine logs and trees that passed
        if [ -n "$log_files" ]; then
            {params.logcombiner} $log_files -o {output.combinedLog}
            {params.logcombiner} $trees_files -o {output.combinedTrees}
        else
            echo "No chains passed the ESS threshold of {params.essCutoff}, so not combining any chains"
        fi
        """

