
import os
import sys
import glob

def get_sims():
    return [d for d in os.listdir(config['inputpath']) if os.path.isdir(os.path.join(config['inputpath'], d))]

sims = get_sims()
outdir = config['outdir']

rule all:
    input:
        expand("{outdir}/raw_data/{sim}/done", sim=sims, outdir=outdir),
        expand("{outdir}/raw_data/{sim}/tissue_labeled_tree.nwk", sim=sims, outdir=outdir),
        expand("{outdir}/cassiopeia_greedy/{sim}/cassiopeia_greedy_inferred.nwk", sim=sims, outdir=outdir),
        expand("{outdir}/machina/{sim}/machina_tree_all_tissue_labels.nwk", sim=sims, outdir=outdir),
        expand("{outdir}/metastabayes/{sim}/{sim}.fasta", sim=sims, outdir=outdir),
        expand("{outdir}/metastabayes/{sim}/terminal_{num}.log", sim=sims, num=range(1, config['numChains']+1), outdir=outdir),
        expand("{outdir}/metastabayes/{sim}/combined.log", sim=sims, outdir=outdir)

rule copyDataToOutDir:
    input:
        lambda wildcards: os.path.join(config['inputpath'], wildcards.sim)
    output:
        os.path.join(outdir, "raw_data/{sim}", "done")
    shell:
        """
        outdir=$(dirname $(dirname {output}))
        cp -r {input} $outdir
        touch {output}
        """

rule labelTrueTreeWithTissues:
    input:
        true_tree = lambda wildcards : glob.glob(os.path.join(wildcards.outdir, "raw_data", wildcards.sim, "cell_tree_seed*[0-9].nwk")),
        true_tissues = lambda wildcards : glob.glob(os.path.join(wildcards.outdir, "raw_data", wildcards.sim, "cell_tree_seed*.vertex.labeling"))
    output:
        "{outdir}/raw_data/{sim}/tissue_labeled_tree.nwk"
    params:
        scripts = config['scripts']
    conda:
        "envs/compare_trees.yaml"
    shell:
        """
        # run add tissue to newick
        python {params.scripts}/format_add_tissues_to_newick.py {input.true_tree} {input.true_tissues}
        """

rule runCassiopeia:
    input:
        sim_matrix = lambda wildcards : glob.glob(os.path.join(wildcards.outdir, "raw_data", wildcards.sim, "*_indel_character_matrix.tsv")),
    output:
        "{outdir}/cassiopeia_greedy/{sim}/cassiopeia_greedy_inferred.nwk"
    params:
        cassiopeia_script = os.path.join(config['scripts'], "cassiopeia/cassiopeia_greedy.py"),
        outputdir = "{outdir}/cassiopeia_greedy/{sim}"
    singularity:
        "envs/simulate.sif"
    shell:
        """
        # run cassiopeia greedy
        python {params.cassiopeia_script} {input.sim_matrix} {params.outputdir}
        """

rule runMachina:
    input:
        casTree = "{outdir}/cassiopeia_greedy/{sim}/cassiopeia_greedy_inferred.nwk",
        leafTissues = lambda wildcards: glob.glob(os.path.join(wildcards.outdir, "raw_data", wildcards.sim,"cell_tree_*[0-9].labeling"))
    output:
        machinaResults = "{outdir}/machina/{sim}/machina_results.txt",
        machinaTree = "{outdir}/machina/{sim}/P-T-P-R.tree",
        machinaTissues = "{outdir}/machina/{sim}/P-T-P-R.labeling"
    params:
        scripts = config['scripts'],
        outputdir = "{outdir}/machina/{sim}",
        primaryTissue = config['primaryTissue'],
        threads = config['threads']
    conda:
        "envs/machina.yaml"
    shell:
        """
        echo {input.leafTissues}
        # prep machina inputs
        python {params.scripts}/machina/prep_machina.py {input.casTree} {params.outputdir} {params.primaryTissue} {input.leafTissues}

        # load Gurobi license (specific to CSHL HPC; will need to be modified on other systems)
        module load EBModules
        module load Gurobi

        # run machina
        {params.scripts}/machina/run_machina_tr.sh --threads {params.threads} --edges {params.outputdir}/*.tree --labels {params.outputdir}/*.labeling --colors {params.outputdir}/*_colors.txt --primary-tissue P --outdir {params.outputdir}
        """

rule processMachinaResults:
    input:
        machinaTree = "{outdir}/machina/{sim}/P-T-P-R.tree",
        machinaTissues = "{outdir}/machina/{sim}/P-T-P-R.labeling"
    output:
        machinaTissueTree = "{outdir}/machina/{sim}/machina_tree_all_tissue_labels.nwk",
    params:
        scripts = config['scripts'],
        outputdir = "{outdir}/machina/{sim}"
    singularity:
        "envs/simulate.sif"
    shell:
        """
        python {params.scripts}/machina/post_machina_tr_to_tree.py {input.machinaTree} {input.machinaTissues} {params.outputdir}
        """

rule prepMetastabayesInputs:
    input:
        sim_matrix = lambda wildcards : glob.glob(os.path.join(wildcards.outdir, "raw_data", wildcards.sim, "*_indel_character_matrix.tsv")),
        leafTissues = lambda wildcards: glob.glob(os.path.join(wildcards.outdir, "raw_data", wildcards.sim,"cell_tree_*[0-9].labeling"))
    output:
        fasta = "{outdir}/metastabayes/{sim}/{sim}.fasta",
        dates = "{outdir}/metastabayes/{sim}/{sim}_date_traits.csv",
        tissues = "{outdir}/metastabayes/{sim}/{sim}_tip_tissues.csv",
    params:
        scripts = config['scripts'],
        generations = config['generations'],
        outputdir = "{outdir}/metastabayes/{sim}"
    shell:
        """
        {params.scripts}/format_metastabayes_input_files.sh {input.sim_matrix} {input.leafTissues} {params.generations} {params.outputdir}
        """

rule runMetastabayes:
    input:
        fasta = "{outdir}/metastabayes/{sim}/{sim}.fasta",
        dates = "{outdir}/metastabayes/{sim}/{sim}_date_traits.csv",
        tissues = "{outdir}/metastabayes/{sim}/{sim}_tip_tissues.csv",
    output:
        terminalLog = "{outdir}/metastabayes/{sim}/terminal_{num}.log",
        metastabayesLog = "{outdir}/metastabayes/{sim}/chain_{num}.log",
        metastabayesResult = "{outdir}/metastabayes/{sim}/chain_{num}.trees"
    params:
        xml = config['xml'],
        fileDir = "{outdir}/metastabayes/{sim}",
        metastabayesJar = config['metastabayesJar'],
        matrixStructure = config['matrixStructure'],
        numRates = config['numRates'],
        generations = config['generations'],
        mcmclength = config['mcmcLength'],
        threads = config['threads']
    shell:
        """
        cp {params.xml} {params.fileDir}/submit.xml

        java -Xmx5g -jar {params.metastabayesJar} \
        -threads {params.threads} \
        -overwrite \
        -working \
        -D inputNames={wildcards.sim} \
        -D fileDir={params.fileDir} \
        -D matrixStructure='{params.matrixStructure}' \
        -D numRates={params.numRates} \
        -D generations={params.generations} \
        -D mcmclength={params.mcmclength} \
        -D outname=chain_{wildcards.num} \
        {params.fileDir}/submit.xml > {output.terminalLog}
        """

rule combineMetastabayesChains:
    input:
        terminalLog = "{outdir}/metastabayes/{sim}/terminal_1.log", # necessary to ensure runMetastabayes has finished first
        metastabayesLogs = lambda wildcards: glob.glob(os.path.join(wildcards.outdir, "metastabayes", wildcards.sim, "chain_*.log")),
        metastabayesResults = lambda wildcards: glob.glob(os.path.join(wildcards.outdir, "metastabayes", wildcards.sim, "chain_*.trees"))
    output:
        combinedLog = "{outdir}/metastabayes/{sim}/combined.log",
        combinedTrees = "{outdir}/metastabayes/{sim}/combined.trees"
    params:
        logcombiner = config['logcombiner'],
        essCutoff = config['essCutoff']
    shell:
        """
        log_files=""
        trees_files=""
        ess_convergences=()
        for file in {input.metastabayesLogs}; do
            terminal_log=$(echo $file | sed 's/chain_/terminal_/')
            ess_convergence=$(awk '/Operator/ {{ found=1; next }} {{ if (!found) print }}' "$terminal_log" | awk '{{if (NF > 0) print}}' | tail -n 1 | awk '{{print int($3 + 0.5)}}')
            
            # only use mcmc chains that have converged since many appear to get lost in the search space
            if [[ $ess_convergence -gt {params.essCutoff} ]]; then
                log_files+="-log $file "
                trees_file=$(echo $file | sed 's/\.log$/.trees/')
                trees_files+="-log $trees_file "
            else
                echo "$file did not converge, so not including it in the final output"
            fi
        done

        {params.logcombiner} $log_files -o {output.combinedLog}
        {params.logcombiner} $trees_files -o {output.combinedTrees}
        """

