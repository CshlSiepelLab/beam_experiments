rule runMachina:
    input:
        lamlTreeNoBranchLengths = "{outdir}/laml/{sim}/{sim}_laml_trees_no_origin_no_branch_lengths.nwk",
        leafTissues = lambda wildcards: glob.glob(os.path.join(config['inputpath'], wildcards.sim,"cell_tree_*[0-9].labeling"))
    output:
        machinaResults = "{outdir}/machina/{sim}/machina_results.txt",
        machinaTree = "{outdir}/machina/{sim}/P-T-P-R.tree",
        machinaTissues = "{outdir}/machina/{sim}/P-T-P-R.labeling"
    params:
        scripts = config['scripts'],
        outputdir = "{outdir}/machina/{sim}",
        primaryTissue = config['primaryTissue'],
        threads = 50
    conda:
        "../../envs/machina.yaml"
    shell:
        """
        echo {input.leafTissues}
        # prep machina inputs
        python {params.scripts}/machina/prep_machina.py {input.lamlTreeNoBranchLengths} {params.outputdir} {params.primaryTissue} {input.leafTissues}

        # load Gurobi license (specific to CSHL HPC; will need to be modified on other systems)
        module load EBModules
        module load Gurobi

        labeling={params.outputdir}/*.labeling
        unique_tissues=$(cut -f2 $labeling | sort | uniq)
        num_unique_tissues=$(echo "$unique_tissues" | wc -l)

        if [ "$num_unique_tissues" -gt 1 ]; then

            # check if primary tissue is in the labeling file
            if grep -q "{params.primaryTissue}" $labeling; then
                # run machina
                {params.scripts}/machina/run_machina_tr.sh --threads {params.threads} --edges {params.outputdir}/*.tree --labels {params.outputdir}/*.labeling --colors {params.outputdir}/*_colors.txt --primary-tissue {params.primaryTissue} --outdir {params.outputdir}
                
                # move the dot and edge file to the primary tissue output to satisfy the snakemake since the file label might be different
                cp {params.outputdir}/{params.primaryTissue}-T-{params.primaryTissue}-R.dot {output.machinaTree}
                cp {params.outputdir}/{params.primaryTissue}-T-{params.primaryTissue}-R.tree {output.machinaTissues}
            else
                most_common_tissue=$(cut -f2 $labeling | sort | uniq -c | sort -nr | head -n 1 | awk '{{print $2}}')
                echo "The {params.primaryTissue} is not in the tissue labels. Using the most common tissue $most_common_tissue as the primary tissue."
                {params.scripts}/machina/run_machina_tr.sh --threads {params.threads} --edges {params.outputdir}/*.tree --labels {params.outputdir}/*.labeling--colors {params.outputdir}/*_colors.txt --primary-tissue $most_common_tissue --outdir {params.outputdir}

                # move the dot and edge file to the primary tissue output to satisfy the snakemake since the file label will be different due to the different primary tissue
                cp {params.outputdir}/$most_common_tissue-T-$most_common_tissue-R.dot {output.machinaTree}
                cp {params.outputdir}/$most_common_tissue-T-$most_common_tissue-R.tree {output.machinaTissues}
            fi
        else
            echo "Only one unique tissue found in the labeling file, so not enough to run Machina. Exiting."
            touch {output.machinaTissues}
            touch {output.machinaTree}
            touch {output.machinaResults}
        fi
        """

