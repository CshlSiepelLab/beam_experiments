        """

rule downsampleInputsTree:
    input:
        cpList = "{outdir}/beam/{mouse}/cp_list.txt",
        evotracerCassiopeiaTree= "{outdir}/evotracer/{mouse}/phylogeny_analysis/phylogeny_del_ins/tree_all_clones.newick",
        temp_matrix = "{outdir}/beam/{mouse}/{cp}/temp_matrix.tsv",
        temp_tissues = "{outdir}/beam/{mouse}/{cp}/temp_tissues.tsv"
    output:
        downsampledMatrix = "{outdir}/beam/{mouse}/{cp}/downsampled_char_matrix.tsv",
        downsampledTissues = "{outdir}/beam/{mouse}/{cp}/downsampled_tissue_labels.tsv"
    params:
        outputdir = "{outdir}/beam/{mouse}/{cp}",
        scripts = config['scripts'],
        experimentTime = lambda wildcards: config['experimentTime'][wildcards.mouse],
        max_tips = config['downsampleTipNumThreshold'], # downsampling only occurs if the number of tips is greater than this
        threshold = config['downsampleDistanceThreshold'], # height of the tree for which downsampling occurs below it
        threads = 25,
        mem = '5G'
    conda:
        "../../envs/laml.yaml"
    shell:
        """
        # Check the number of rows in temp_tissues
        num_tips=$(tail -n +2 {input.temp_tissues} | wc -l)

        # If the number of rows is greater than 150, downsample
        if [ "$num_tips" -gt {params.max_tips} ]; then
            echo "Number of tips is greater than {params.max_tips}. Downsampling with a tree threshold of {params.threshold}."

            # subset the existing cassiopeia tree
            asv_names=$(tail -n +2 {input.temp_matrix} | cut -f1 | grep -v '^$' | tr '\n' ',' | sed 's/,$//')
            subset_cas_tree={params.outputdir}/subset_evotracer_cassiopeia_tree.nwk
            python {params.scripts}/formatting/subset_evotracer_cassiopeia_tree.py {input.evotracerCassiopeiaTree} $asv_names $subset_cas_tree

            # use the cassiopeia tree to get a laml tree for downsampling
            cp {input.temp_matrix} {params.outputdir}/matrix.csv
            sed -i 's/-1/?/g; s/\t/,/g' {params.outputdir}/matrix.csv

            run_laml -c {params.outputdir}/matrix.csv -t $subset_cas_tree -o {params.outputdir}/{wildcards.mouse}_{wildcards.cp}_laml --timescale {params.experimentTime} --parallel

            # remove origin from the laml tree
            newick=$(sed 's/):.*$//g' {params.outputdir}/{wildcards.mouse}_{wildcards.cp}_laml_trees.nwk)
            lamlTreeNoOrigin={params.outputdir}/{wildcards.mouse}_{wildcards.cp}_laml_trees_no_origin.nwk
            echo "${{newick:1}}" > $lamlTreeNoOrigin
            echo ");" >> $lamlTreeNoOrigin

            # downsample the tree
            python {params.scripts}/formatting/downsample_tree.py {input.temp_matrix} $lamlTreeNoOrigin {input.temp_tissues} {params.threshold} {params.outputdir}/downsampled

        else
            echo "Number of tips is less than {params.max_tips}. No downsampling."
            cp {input.temp_matrix} {output.downsampledMatrix}
            cp {input.temp_tissues} {output.downsampledTissues}
        fi
        """

rule prepBeamInputs:
    input:
        downsampledMatrix = "{outdir}/beam/{mouse}/{cp}/downsampled_char_matrix.tsv",
        downsampledTissues = "{outdir}/beam/{mouse}/{cp}/downsampled_tissue_labels.tsv",
        mutation_dict = "{outdir}/beam/{mouse}/mutation_dict.tsv"
    output:
        fasta = "{outdir}/beam/{mouse}/{cp}/{cp}.fasta",
        tissues = "{outdir}/beam/{mouse}/{cp}/{cp}_tip_tissues.csv",
        editRateProportions = "{outdir}/beam/{mouse}/{cp}/{cp}_edit_rate_proportions.txt",
        expandedClonesMatrix = "{outdir}/beam/{mouse}/{cp}/expanded_clones_matrix.tsv",
    params:
        outdir = "{outdir}/beam/{mouse}/{cp}",
        scripts = config['scripts'],
        experimentTime = lambda wildcards: config['experimentTime'][wildcards.mouse],
        threads = 1,
        mem = '5G'
    conda:
        "../../envs/networkx.yaml"
    shell:
        """
        # make mutations successive for each matrix and provide an updated dictionary of int to mutations
        python {params.scripts}/formatting/matrix_to_successive_matrix.py {input.downsampledMatrix} {input.mutation_dict} {params.outdir}

        # expand clones found in multiple tissues to separate entries
        python {params.scripts}/formatting/expand_clones_multiple_tissues.py {params.outdir}/successive_char_matrix.csv {input.downsampledTissues} {params.outdir}
        matrixFile={params.outdir}/expanded_clones_matrix.tsv
        tissuesFile={params.outdir}/expanded_clones_tissues.tsv

        # make output files
        fasta={params.outdir}/{wildcards.cp}.fasta
        tissues={params.outdir}/{wildcards.cp}_tip_tissues.csv
        editRateProportions={params.outdir}/{wildcards.cp}_edit_rate_proportions.txt

        # write tip traits to new csv
        tail -n +2 $tissuesFile | grep -v '^$' | cut -f1,2 | tr '\\t' ',' > $tissues

        # get edit rate proportions for new mutation entries, relative so they all sum to 1.0
        all_muts=$(tail -n +2 $matrixFile | grep -v '^$' | cut -f2- | sed 's/-1/0/g' | tr '\\t' ' ' | tr '\\n' ' ')
        total_count=$(echo $all_muts | tr ' ' '\\n' | grep -wv "0" | wc -l)
        uniq_count=$(echo $all_muts | tr ' ' '\\n' | sort | uniq | grep -wv "0" | wc -l)
        count_sum=$( echo $all_muts | tr ' ' '\\n' | grep -wv "0" | wc -l )
        
        for element in $(seq 1 $uniq_count); do
            echo "START"
            echo "element: $element"
            if echo "$all_muts" | tr ' ' '\\n' | grep -w "$element"; then
                echo "FOUND"
                count=$(echo "$all_muts" | tr ' ' '\\n' | grep -wc "$element")
                proportion=$(echo "scale=10; $count / $count_sum" | bc)
            else
                echo "NOT FOUND"
                count=0
                proportion=0
            fi
            echo "count: $count"
            echo "proportion: $proportion"
            echo "$proportion" >> $editRateProportions
        done

        # Format fasta with the option to replace site dropouts with the new int representation to be modeled by an independent silencing rate
        # to model dropouts, use the highest mutation int representation and add 1 since the dropout column is the last in the rate matrix
        dropoutMutNum=$(( uniq_count + 1 ))
        tail -n +2 $matrixFile | grep -v '^$' | sed "s/-1/$dropoutMutNum/g" | awk '{{printf ">"$1"\\n"; for (i=2; i<=NF; i++) printf (i==NF ? $i"\\n" : $i",")}}' > $fasta    
        """

