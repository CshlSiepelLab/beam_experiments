import os
import sys
import glob

# get mouse ids and fastq files from input fastq dir
mice = []
mouse_fastqs = {}
for file in glob.glob(os.path.join(config['fastqPath'], "*.fastq.gz")):
    mouse = os.path.basename(file).split("_")[0]
    if mouse not in mice:
        mice.append(mouse)
    if mouse not in mouse_fastqs:
        mouse_fastqs[mouse] = []
    mouse_fastqs[mouse].append(file)


def get_elements_from_file(path):
    # to get all cps
    filename = f"{path}/cp_list.txt"
    with open(filename) as f:
        cps = [line.strip() for line in f if set(list(line.strip().replace("CP", ""))) != set('0')]
    mouse = os.path.basename(path)
    if mouse == "MMUS1875" or mouse == "MMUS1466":
        cps = [cp for cp in cps if cp != "CP01"]    # exclude these CPs due to computational burden with Beam analysis

    # # temp exclusions
    # exclude = ["CP01", "CP02", "CP1", "CP2", "CP001", "CP002"]
    # cps = [cp for cp in cps if cp not in exclude]

    # # Overwrite CPs for mice to not run them all for more particles
    # included_combinations = {
    #     "MMUS1469": ["CP006"],
    # }

    # if mouse in included_combinations:
    #     cps = included_combinations[mouse]
    # else:
    #     cps = []

    return cps


