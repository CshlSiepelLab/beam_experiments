    singularity:
        "../../envs/simulate.sif"
    shell:
        """
        # run cassiopeia greedy
        python {params.cassiopeia_script} {input.expandedClonesMatrix} {params.outputdir}
        """

rule runLAML:
    input:
        cpList = "{outdir}/beam/{mouse}/cp_list.txt",
        expandedClonesMatrix = "{outdir}/beam/{mouse}/{cp}/expanded_clones_matrix.tsv",
        editRateProportions = "{outdir}/beam/{mouse}/{cp}/{cp}_edit_rate_proportions.txt",
        casTree = "{outdir}/cassiopeia_greedy/{mouse}/{cp}/cassiopeia_greedy_inferred.nwk"
    output:
        lamlTree = "{outdir}/laml/{mouse}/{cp}/laml_trees.nwk",
        lamlAnnotations = "{outdir}/laml/{mouse}/{cp}/laml_annotations.txt",
        lamlTreeNoBranchLengths = "{outdir}/laml/{mouse}/{cp}/laml_trees_no_branch_lengths.nwk"
    params:
        scripts = config['scripts'],
        outputdir = "{outdir}/laml/{mouse}/{cp}",
        experimentTime = lambda wildcards: config['experimentTime'][wildcards.mouse],
        threads = 25,
        mem = '5G'
    conda:
        "../../envs/laml.yaml"
    shell:
        """
        # copy matrix and replace -1 with ? for missing data
        laml_matrix={params.outputdir}/matrix.csv
        cp {input.expandedClonesMatrix} $laml_matrix
        sed -i 's/-1/?/g; s/\t/,/g' $laml_matrix

        # format mutation priors
        reformattedObservedEditRates={params.outputdir}/reformatted_edit_rate_proportions.csv
        echo "mutation_code,rate" > $reformattedObservedEditRates
        numEditRates=$(wc -l < {input.editRateProportions})
        for i in $(seq 1 $numEditRates); do
            rate=$(sed -n "${{i}}p" {input.editRateProportions})
            echo "$i,$rate" >> $reformattedObservedEditRates
        done

        mutationPriors={params.outputdir}/mutation_priors.csv
        python {params.scripts}/formatting/format_laml_mutation_priors.py $laml_matrix $reformattedObservedEditRates $mutationPriors

        # run laml
        run_laml -c $laml_matrix -t {input.casTree} -p $mutationPriors -o {params.outputdir}/laml --timescale {params.experimentTime} --parallel

        # obtain newick without branch lengths
        sed 's/:\([0-9]\+\.\?\([0-9]\+\)\?\)//g' {output.lamlTree} > {output.lamlTreeNoBranchLengths}
        """

rule runBeam:
    input:
        cpList = "{outdir}/beam/{mouse}/cp_list.txt",
        fasta = "{outdir}/beam/{mouse}/{cp}/{cp}.fasta",
        tissues = "{outdir}/beam/{mouse}/{cp}/{cp}_tip_tissues.csv",
        editRateProportions = "{outdir}/beam/{mouse}/{cp}/{cp}_edit_rate_proportions.txt",
        lamlTree = "{outdir}/laml/{mouse}/{cp}/laml_trees.nwk"
    output:
        terminalLog = "{outdir}/beam_gtr/{mouse}/{cp}/terminal_{num}.log",
        beamLog = "{outdir}/beam_gtr/{mouse}/{cp}/chain_{num}.log",
        beamResult = "{outdir}/beam_gtr/{mouse}/{cp}/chain_{num}.trees"
    params:
        xml = config['gtrXml'],
        inFileDir = "{outdir}/beam/{mouse}/{cp}",
        fileDir = "{outdir}/beam_gtr/{mouse}/{cp}",
        experimentTime = lambda wildcards: config['experimentTime'][wildcards.mouse],
        primaryTissue = lambda wildcards: config['primaryTissue'][wildcards.mouse],
        threads = 5,
        mem = '5G',
        mcmclength = config['mcmcLength']
    shell:
        """
        cp {params.xml} {params.fileDir}/{wildcards.num}.xml

        # calculate necessary inputs for the editing model
        initialEditRates=$(cat {input.editRateProportions} | tr '\n' ' ')
        array=($initialEditRates)
        numEditRates=${{#array[@]}}
        numEditRatesPlusTwo=$(( numEditRates + 2 ))

        # format tissue information
        unique_tissues=$(cat {input.tissues} | cut -d',' -f2 | sort | uniq)
        numTissues=$(echo $unique_tissues | tr ' ' '\n' | wc -l)

        # set the mcmc chain length based on the number of tips in the tree
        # use a minimum of 5 million and a maximum of a user specified length
        numTips=$(grep -c '^>' {input.fasta})
        mcmclength=$(( numTips * 1000000 ))
        if (( mcmclength > {params.mcmclength} )); then
            mcmclength={params.mcmclength}
        elif (( mcmclength < 50000000 )); then
            mcmclength=50000000
        fi

        # fix mcmc length to the specified number instead of dynamically calculating it based on the number of tips
        mcmclength={params.mcmclength}

        # if numTissues is 1, then the model will not run, so we need to add a dummy tissue
        if [[ $numTissues -eq 1 ]]; then
            # if the primary already exists then add a dummy
            if echo "$unique_tissues" | grep -w "{params.primaryTissue}"; then
                unique_tissues="$unique_tissues dummy"
            # if not, then add the primary as the dummy
            else
                unique_tissues="{params.primaryTissue} $unique_tissues"
            fi
            numTissues=$(( numTissues + 1 ))
        fi

        # force the known primary tissue at the origin for root frequencies in the likelihood calculation
        sorted_unique_tissues="{params.primaryTissue} $(echo $unique_tissues | tr ' ' '\n' | grep -v '^{params.primaryTissue}$' | tr '\n' ' ')"
        if ! echo "$unique_tissues" | grep -qw "{params.primaryTissue}"; then
            numTissues=$(( numTissues + 1 ))
        fi
        tissueRootFreqs=$(for i in $(seq 1 $numTissues); do if [[ "$i" = "1" ]]; then echo -n "1 "; else echo -n "0 "; fi; done)

        numTissueRates=$(( ((numTissues * numTissues) - numTissues) / 2 ))

        tissueCodeMap=""
        trailingCodeMap="? = "
        i=0
        for tissue in $sorted_unique_tissues; do
            tissueCodeMap+="$tissue=$i,"
            trailingCodeMap+="$i "
            i=$((i+1))
        done
        tissueCodeMap+="${{trailingCodeMap}}"

        # for some reason this cannot be taken in at the command line, likely because the = signs are problematic and not taken as a single string
        sed -i "s/\$(tissueCodeMap)/$tissueCodeMap/g" {params.fileDir}/{wildcards.num}.xml
        sed -i "s/\$(initialEditRates)/$initialEditRates/g" {params.fileDir}/{wildcards.num}.xml
        sed -i "s/\$(tissueRootFreqs)/$tissueRootFreqs/g" {params.fileDir}/{wildcards.num}.xml

        # use LAML starting tree
        # remove node names from newick and the origin node
        newick=$(cat {input.lamlTree} | sed 's/node[0-9]*:/:/g' | sed 's/^.//' | sed 's/..$//')

        beast \
        -threads {params.threads} \
        -resume \
        -working \
        -D inName={wildcards.cp} \
        -D fileDir={params.inFileDir} \
        -D newick=\"$newick\" \
        -D generations={params.experimentTime} \
        -D numEditRates=\"$numEditRates\" \
        -D numEditRatesPlusTwo=\"$numEditRatesPlusTwo\" \
        -D numTissueRates=\"$numTissueRates\" \
        -D numTissues=\"$numTissues\" \
        -D mcmclength=\"$mcmclength\" \
        -D outname=chain_{wildcards.num} \
        {params.fileDir}/{wildcards.num}.xml > {output.terminalLog}
        """

rule combineBeamChains:
    input:
        terminalLog = lambda wildcards: expand("{outdir}/beam_gtr/{mouse}/{cp}/terminal_{num}.log", num=range(1, config['numChains']+1), cp=wildcards.cp, mouse=wildcards.mouse, outdir=wildcards.outdir),
        beamLogs = lambda wildcards: expand("{outdir}/beam_gtr/{mouse}/{cp}/chain_{num}.log", num=range(1, config['numChains']+1), cp=wildcards.cp, mouse=wildcards.mouse, outdir=wildcards.outdir),
        beamResults = lambda wildcards: expand("{outdir}/beam_gtr/{mouse}/{cp}/chain_{num}.trees", num=range(1, config['numChains']+1), cp=wildcards.cp, mouse=wildcards.mouse, outdir=wildcards.outdir),
    output:
        combinedLog = "{outdir}/beam_gtr/{mouse}/{cp}/combined.log",
        combinedTrees = "{outdir}/beam_gtr/{mouse}/{cp}/combined.trees",
    params:
        logcombiner = config['logcombiner'],
        essCutoff = config['essCutoff'],
        threads = 1,
        mem = '5G'
    shell:
        """
        # find chains that have converged based on ess threshold specified
        log_files=""
        trees_files=""
        ess_convergences=()
        for file in {input.beamLogs}; do
            terminal_log=$(echo $file | sed 's/chain_/terminal_/')
            
            # only use mcmc chains that have converged since many appear to get lost in the search space
            ess_convergence=$(grep "Msamples" $terminal_log | tail -n 1 | sed 's/^ *//;s/ *$//' | tr -s ' ' | cut -d' ' -f3)
            if (( $(echo "$ess_convergence > {params.essCutoff}" | bc -l) )); then
                log_files+="-log $file "
                trees_file=$(echo $file | sed 's/\.log$/.trees/')
                trees_files+="-log $trees_file "
            else
                echo "$file did not converge, so not including it in the final output"
            fi
        done

        # combine logs and trees that passed
        if [ -n "$log_files" ]; then
            {params.logcombiner} $log_files -o {output.combinedLog}
            {params.logcombiner} $trees_files -o {output.combinedTrees}
        else
            echo "No chains passed the ESS threshold of {params.essCutoff}, so not combining any chains"
        fi
        """

rule beamPostprocessing:
    input:
        combinedTrees = "{outdir}/beam_gtr/{mouse}/{cp}/combined.trees",
        combinedLog = "{outdir}/beam_gtr/{mouse}/{cp}/combined.log"
    output:
        graphPosterior = "{outdir}/beam_gtr/{mouse}/{cp}/posterior_prob_graph.csv",
        probabilityPlot = "{outdir}/beam_gtr/{mouse}/{cp}/probability_migration_graph.pdf",
        samples = "{outdir}/beam_gtr/{mouse}/{cp}/combined_migration_graph_1.pdf",
        migrationCountMatrix = "{outdir}/beam_gtr/{mouse}/{cp}/posterior_trees_migration_count_matrix.csv",
        mutualInformation = "{outdir}/beam_gtr/{mouse}/{cp}/posterior_trees_migration_mutual_information.txt",
        metastasisTiming = "{outdir}/beam_gtr/{mouse}/{cp}/metastasis_timing.pkl",
        metastasisTimingPlot = "{outdir}/beam_gtr/{mouse}/{cp}/metastasis_timing_prob.pdf",
    params:
        scripts = config['scripts'],
        primaryTissue = config['primaryTissue'],
        outprefix_thresholded = "{outdir}/beam_gtr/{mouse}/{cp}/thresholded_migration_graph",
        outprefix_samples = "{outdir}/beam_gtr/{mouse}/{cp}/combined",
        outprefix_metastasis_timing = "{outdir}/beam_gtr/{mouse}/{cp}/metastasis_timing",
        experimentTime = lambda wildcards: config['experimentTime'][wildcards.mouse],
        numSamples = 10,
        consensusTimingThreshold = 0.5,
        threads = 5,
        mem = "1G"
    shell:
        """
        # work around until beam visualization is pip installable
        source ~/miniconda3/etc/profile.d/conda.sh 
        conda activate beam_visualization

        if [ ! -s {input.combinedTrees} ]; then
            echo "Combined trees file is empty. Exiting."
            touch {output.graphPosterior}
        else
            thresholds="0.4,0.5,0.6,0.7,0.8,0.9,0.95,0.99"
            
            python {params.scripts}/formatting/beam_postprocessing.py \
                {input.combinedTrees} \
                {input.combinedLog} \
                {params.primaryTissue} \
                {output.graphPosterior} \
                {params.threads} \
                {output.probabilityPlot} \
                $thresholds \
                {params.outprefix_thresholded} \
                {params.outprefix_samples} \
                {params.numSamples} \
                {params.experimentTime} \
                {output.migrationCountMatrix} \
                {output.mutualInformation} \
                {params.outprefix_metastasis_timing} \
                {params.consensusTimingThreshold}
        fi
        """

