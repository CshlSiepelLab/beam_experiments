        expand("{outdir}/beam_prep/{sim}/{sim}.fasta", sim=sims, outdir=outdir),
        # expand("{outdir}/beam_reseeding_ns/{sim}/{num}/terminal_{num}.log", sim=sims, num=range(0, 1), outdir=outdir),
        # expand("{outdir}/beam_no_reseeding_ns/{sim}/{num}/terminal_{num}.log", sim=sims, num=range(0, 1), outdir=outdir),

rule labelTrueTreeWithTissues:
    input:
        true_tree = lambda wildcards : glob.glob(os.path.join(config['inputpath'], wildcards.sim, "cell_tree_seed*[0-9].nwk")),
        true_tissues = lambda wildcards : glob.glob(os.path.join(config['inputpath'], wildcards.sim, "cell_tree_seed*.vertex.labeling"))
    output:
        "{outdir}/true_labeled_trees/{sim}/tissue_labeled_tree.nwk"
    params:
        scripts = config['scripts'],
        threads = 1,
        mem = '1G'
    conda:
        "../../envs/compare_trees.yaml"
    shell:
        """
        # run add tissue to newick
        python {params.scripts}/formatting/format_add_tissues_to_newick.py {input.true_tree} {input.true_tissues} {output}
        """

