# alternatively, can infer a tree and the downsample based on the tree
rule runCassiopeia:
    input:
        copiedData = os.path.join(outdir, "raw_data/{sim}", "done"),
        matrix = lambda wildcards : glob.glob(os.path.join(wildcards.outdir, "raw_data", wildcards.sim, "*_indel_character_matrix.tsv"))
    output:
        "{outdir}/cassiopeia_greedy/{sim}/cassiopeia_greedy_inferred.nwk"
    params:
        cassiopeia_script = os.path.join(config['scripts'], "cassiopeia/cassiopeia_greedy.py"),
        outputdir = "{outdir}/cassiopeia_greedy/{sim}",
        threads = 5
    singularity:
        "../../envs/simulate.sif"
    shell:
        """
        # run cassiopeia greedy
        python {params.cassiopeia_script} {input.matrix} {params.outputdir}
        """

rule runLAML:
    input:
        matrix = lambda wildcards : glob.glob(os.path.join(wildcards.outdir, "raw_data", wildcards.sim, "*_indel_character_matrix.tsv")),
        casTree = "{outdir}/cassiopeia_greedy/{sim}/cassiopeia_greedy_inferred.nwk"
    output:
        lamlTree = "{outdir}/laml/{sim}/laml_trees.nwk",
        lamlTreeNoOrigin = "{outdir}/laml/{sim}/laml_trees_no_origin.nwk",
    params:
        outputdir = "{outdir}/laml/{sim}",
        experimentTime = config['generations'],
        threads = 25
    conda:
        "../../envs/laml.yaml"
    shell:
        """
        # copy matrix and replace -1 with ? for missing data
        cp {input.matrix} {params.outputdir}/matrix.csv
        sed -i 's/-1/?/g; s/\t/,/g' {params.outputdir}/matrix.csv

        # run laml
        run_laml -c {params.outputdir}/matrix.csv -t {input.casTree} -o {params.outputdir}/laml --timescale {params.experimentTime} --parallel

        # remove origin from tree
        newick=$(sed 's/):.*$//g' {params.outputdir}/laml_trees.nwk) 
        echo "${{newick:1}}" > {output.lamlTreeNoOrigin}
        echo ");" >> {output.lamlTreeNoOrigin}
        """

rule downsampleInputsTree:
    input:
        matrix = lambda wildcards : glob.glob(os.path.join(wildcards.outdir, "raw_data", wildcards.sim, "*_indel_character_matrix.tsv")),
        leafTissues = lambda wildcards: glob.glob(os.path.join(wildcards.outdir, "raw_data", wildcards.sim,"cell_tree_*[0-9].labeling")),
        lamlTreeNoOrigin = "{outdir}/laml/{sim}/laml_trees_no_origin.nwk",
    output:
        downsampledSimMatrix = "{outdir}/downsampled_data/{sim}/threshold_{threshold}_char_matrix.tsv",
        downsampledLeafTissues = "{outdir}/downsampled_data/{sim}/threshold_{threshold}_tissue_labels.tsv",
        lamlTreeDownsampledNoOrigin = "{outdir}/downsampled_data/{sim}/threshold_{threshold}_downsampled_tree.nwk",
    params:
        outprefix = "{outdir}/downsampled_data/{sim}/threshold_{threshold}",
        scripts = config['scripts'],
        threads = config['threads'],
    conda:
        "../../envs/compare_trees.yaml"
    shell:
        """
        python {params.scripts}/formatting/downsample_tree.py {input.matrix} {input.lamlTreeNoOrigin} {input.leafTissues} {wildcards.threshold} {params.outprefix}
        """


rule prepBeamInputs:
    input:
        downsampledSimMatrix = "{outdir}/downsampled_data/{sim}/threshold_{threshold}_char_matrix.tsv",
        downsampledLeafTissues = "{outdir}/downsampled_data/{sim}/threshold_{threshold}_tissue_labels.tsv",
    output:
        fasta = "{outdir}/beam/{sim}_{threshold}/{sim}_{threshold}.fasta",
        dates = "{outdir}/beam/{sim}_{threshold}/{sim}_{threshold}_date_traits.csv",
        tissues = "{outdir}/beam/{sim}_{threshold}/{sim}_{threshold}_tip_tissues.csv",
        editRates = "{outdir}/beam/{sim}_{threshold}/{sim}_{threshold}_edit_rate_proportions.txt"
    params:
        scripts = config['scripts'],
        generations = config['generations'],
        outputdir = "{outdir}/beam/{sim}_{threshold}"
    conda:
        "../../envs/compare_trees.yaml"
    shell:
        """
        # write tip traits to new csv
        tail -n +2 {input.downsampledLeafTissues} | sed 's/[[:space:]]/,/g' > {output.tissues}

        # write date trait
        tail -n +2 {input.downsampledLeafTissues} | sed 's/[[:space:]]/,/g' | cut -d',' -f1 | paste -d',' - <(yes {params.generations} | head -n $(wc -l < {input.downsampledLeafTissues})) > {output.dates}

        # format fasta, re-label mutations sequentially, and get edit rate proportions for new mutation entries
        {params.scripts}/formatting/format_beam_input_files.py {input.downsampledSimMatrix} {params.outputdir}
        """

rule runBeam:
    input:
        fasta = "{outdir}/beam/{sim}_{threshold}/{sim}_{threshold}.fasta",
        dates = "{outdir}/beam/{sim}_{threshold}/{sim}_{threshold}_date_traits.csv",
        tissues = "{outdir}/beam/{sim}_{threshold}/{sim}_{threshold}_tip_tissues.csv",
        editRates = "{outdir}/beam/{sim}_{threshold}/{sim}_{threshold}_edit_rate_proportions.txt",
        lamlTreeDownsampledNoOrigin = "{outdir}/downsampled_data/{sim}/threshold_{threshold}_downsampled_tree.nwk",
    output:
        terminalLog = "{outdir}/beam/{sim}_{threshold}/terminal_{num}.log",
        beamLog = "{outdir}/beam/{sim}_{threshold}/chain_{num}.log",
        beamResult = "{outdir}/beam/{sim}_{threshold}/chain_{num}.trees"
    params:
        xml = config['xml'],
        fileDir = "{outdir}/beam/{sim}_{threshold}",
        generations = config['generations'],
        mcmclength = lambda wildcards: config['mcmcLength'][wildcards.threshold],
        primaryTissue = config['primaryTissue'],
        threads = 5
    shell:
        """
        cp {params.xml} {params.fileDir}/{wildcards.num}.xml

        # calculate necessary inputs for the editing model
        initialEditRates=$(cat {input.editRates})
        array=($initialEditRates)
        numEditRates=${{#array[@]}}
        numEditRatesPlusTwo=$(( numEditRates + 2 ))

        # format tissue information
        unique_tissues=$(cat {input.tissues} | cut -d',' -f2 | sort | uniq)
        numTissues=$(echo $unique_tissues | tr ' ' '\n' | wc -l)

        # force the known known primary tissue at the origin for root frequencies in the likelihood calculation
        sorted_unique_tissues="{params.primaryTissue} $(echo $unique_tissues | tr ' ' '\n' | grep -v '^{params.primaryTissue}$' | tr '\n' ' ')"
        if ! echo "$unique_tissues" | grep -qw "{params.primaryTissue}"; then
            numTissues=$(( numTissues + 1 ))
        fi
        tissueRootFreqs=$(for i in $(seq 1 $numTissues); do if [[ "$i" = "1" ]]; then echo -n "1 "; else echo -n "0 "; fi; done)

        numTissueRates=$(( numTissues * (numTissues - 1) ))
        equalTissueRates=$(echo "scale=10; 1.0 / $numTissueRates" | bc -l)
        equalTissueFreqs=$(echo "scale=10; 1.0 / $numTissues" | bc -l)

        tissueCodeMap=""
        trailingCodeMap="? = "
        i=0
        for tissue in $sorted_unique_tissues; do
            tissueCodeMap+="$tissue=$i,"
            trailingCodeMap+="$i "
            i=$((i+1))
        done
        tissueCodeMap+="${{trailingCodeMap}}"

        # for some reason this cannot be taken in at the command line, likely because the = signs are problematic and not taken as a single string
        sed -i "s/\$(tissueCodeMap)/$tissueCodeMap/g" {params.fileDir}/{wildcards.num}.xml
        sed -i "s/\$(initialEditRates)/$initialEditRates/g" {params.fileDir}/{wildcards.num}.xml
        sed -i "s/\$(tissueRootFreqs)/$tissueRootFreqs/g" {params.fileDir}/{wildcards.num}.xml

        # use LAML starting tree from downsampled output
        newick=$(cat {input.lamlTreeDownsampledNoOrigin} )

        beast \
        -threads {params.threads} \
        -overwrite \
        -working \
        -D inName={wildcards.sim}_{wildcards.threshold} \
        -D fileDir={params.fileDir} \
        -D newick=\"$newick\" \
        -D generations={params.generations} \
        -D numEditRates=\"$numEditRates\" \
        -D numEditRatesPlusTwo=\"$numEditRatesPlusTwo\" \
        -D numTissueRates=\"$numTissueRates\" \
        -D numTissues=\"$numTissues\" \
        -D equalTissueFreqs=\"$equalTissueFreqs\" \
        -D mcmclength={params.mcmclength} \
        -D outname=chain_{wildcards.num} \
        {params.fileDir}/{wildcards.num}.xml > {output.terminalLog}
        """

rule combineBeamChains:
    input:
        terminalLog = lambda wildcards: expand("{outdir}/beam/{sim}_{threshold}/terminal_{num}.log", num=range(1, config['numChains']+1), sim=wildcards.sim, outdir=wildcards.outdir, threshold=wildcards.threshold),
        beamLogs = lambda wildcards: expand("{outdir}/beam/{sim}_{threshold}/chain_{num}.log", num=range(1, config['numChains']+1), sim=wildcards.sim, outdir=wildcards.outdir, threshold=wildcards.threshold),
        beamResults = lambda wildcards: expand("{outdir}/beam/{sim}_{threshold}/chain_{num}.trees", num=range(1, config['numChains']+1), sim=wildcards.sim, outdir=wildcards.outdir, threshold=wildcards.threshold),
    output:
        combinedLog = "{outdir}/beam/{sim}_{threshold}/combined.log",
        combinedTrees = "{outdir}/beam/{sim}_{threshold}/combined.trees"
    params:
        logcombiner = config['logcombiner'],
        essCutoff = config['essCutoff'],
        treeannotator = config['treeannotator']
    shell:
        """
        # find chains that have converged based on ess threshold specified
        log_files=""
        trees_files=""
        ess_convergences=()
        for file in {input.beamLogs}; do
            terminal_log=$(echo $file | sed 's/chain_/terminal_/')
            
            ess_convergence=$(grep "Msamples" $terminal_log | tail -n 1 | sed 's/^ *//;s/ *$//' | tr -s ' ' | cut -d' ' -f3)
            if (( $(echo "$ess_convergence > {params.essCutoff}" | bc -l) )); then
                log_files+="-log $file "
                trees_file=$(echo $file | sed 's/\.log$/.trees/')
                trees_files+="-log $trees_file "
            else
                echo "$file did not converge, so not including it in the final output"
            fi
        done

        # combine logs and trees that passed
        {params.logcombiner} $log_files -o {output.combinedLog}
        {params.logcombiner} $trees_files -o {output.combinedTrees}
        """

rule beamPostprocessing:
    input:
        combinedTrees = "{outdir}/beam/{sim}_{threshold}/combined.trees",
        combinedLog = "{outdir}/beam/{sim}_{threshold}/combined.log"
    output:
        graphPosterior = "{outdir}/beam/{sim}_{threshold}/posterior_prob_graph.csv",
        probabilityPlot = "{outdir}/beam/{sim}_{threshold}/probability_migration_graph.pdf",
        samples = "{outdir}/beam/{sim}_{threshold}/combined_migration_graph_1.pdf",
        migrationCountMatrix = "{outdir}/beam/{sim}_{threshold}/posterior_trees_migration_count_matrix.csv",
        mutualInformation = "{outdir}/beam/{sim}_{threshold}/posterior_trees_migration_mutual_information.txt"
    params:
        scripts = config['scripts'],
        primaryTissue = config['primaryTissue'],
        outprefix_thresholded = "{outdir}/beam/{sim}_{threshold}/thresholded_migration_graph_",
        outprefix_samples = "{outdir}/beam/{sim}_{threshold}/combined_",
        experimentTime = config['generations'],
        numSamples = 10,
        threads = 5,
        mem = "1G"
    shell:
        """
        # work around until beam visualization is pip installable
        source ~/miniconda3/etc/profile.d/conda.sh 
        conda activate beam_visualization

        if [ ! -s {input.combinedTrees} ]; then
            echo "Combined trees file is empty. Exiting."
            touch {output.graphPosterior}
        else
            thresholds="0.4,0.5,0.6,0.7,0.8,0.9,0.95,0.99"
            python {params.scripts}/formatting/beam_postprocessing.py \
                {input.combinedTrees} \
                {input.combinedLog} \
                {params.primaryTissue} \
                {output.graphPosterior} \
                {params.threads} \
                {output.probabilityPlot} \
                $thresholds \
                {params.outprefix_thresholded} \
                {params.outprefix_samples} \
                {params.numSamples} \
                {params.experimentTime} \
                {output.migrationCountMatrix} \
                {output.mutualInformation}
        fi
        """
