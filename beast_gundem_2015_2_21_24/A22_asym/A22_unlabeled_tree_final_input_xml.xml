id="tissue"
spec="beastclassic.evolution.alignment.AlignmentFromTrait">
                        <traitSet id="traitSet.tissue" spec="beast.base.evolution.tree.TraitSet" taxa="@TaxonSet.1" traitname="discrete">mid-blueD=seminal-vesicle, mid-blueJ=right-pelvic-lymph-node-12, mid-blueG=bladder, redK=left-pelvic-lymph-node-5, redD=seminal-vesicle, redC=prostate, pinkA=left-humerus-bone-marrow, pinkJ=right-pelvic-lymph-node-12, orangeJ=right-pelvic-lymph-node-12, orangeG=bladder, orangeE=left-adrenal-gland, orangeA=left-humerus-bone-marrow, light-purpleE=left-adrenal-gland, dark-purpleK=left-pelvic-lymph-node-5, dark-purpleJ=right-pelvic-lymph-node-12, dark-purpleI=left-pelvic-lymph-node-8, dark-purpleH=pelvic-lymph-node-7, dark-purpleG=bladder, dark-purpleF=right-adrenal-gland, dark-purpleE=left-adrenal-gland, light-blueH=pelvic-lymph-node-7, light-blueK=left-pelvic-lymph-node-5, dark-greenK=left-pelvic-lymph-node-5, dark-greenI=left-pelvic-lymph-node-8, light-brownI=left-pelvic-lymph-node-8, yellowH=pelvic-lymph-node-7, yellowK=left-pelvic-lymph-node-5, goldF=right-adrenal-gland, mid-greenF=right-adrenal-gland, mid-greenE=left-adrenal-gland, light-greenK=left-pelvic-lymph-node-5, light-greenJ=right-pelvic-lymph-node-12, light-greenI=left-pelvic-lymph-node-8, light-greenH=pelvic-lymph-node-7, light-greenG=bladder, light-greenF=right-adrenal-gland, dark-blueD=seminal-vesicle, dark-blueJ=right-pelvic-lymph-node-12, dark-blueG=bladder, greyD=seminal-vesicle, greyC=prostate, dark-brownC=prostate </traitSet>
