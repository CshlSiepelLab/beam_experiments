    <map name="Uniform" >beast.base.inference.distribution.Uniform</map>

    <map name="Exponential" >beast.base.inference.distribution.Exponential</map>

    <map name="LogNormal" >beast.base.inference.distribution.LogNormalDistributionModel</map>

    <map name="Normal" >beast.base.inference.distribution.Normal</map>

    <map name="Beta" >beast.base.inference.distribution.Beta</map>

    <map name="Gamma" >beast.base.inference.distribution.Gamma</map>

    <map name="LaplaceDistribution" >beast.base.inference.distribution.LaplaceDistribution</map>

    <map name="prior" >beast.base.inference.distribution.Prior</map>

    <map name="InverseGamma" >beast.base.inference.distribution.InverseGamma</map>

    <map name="OneOnX" >beast.base.inference.distribution.OneOnX</map>

    <run id="mcmc" spec="MCMC" chainLength="10000000">
        <state id="state" spec="State" storeEvery="5000">
            <stateNode id="Tree.t:tree" spec="fixedtreeanalysis.evolution.tree.FixedTree" IsLabelledNewick="true" adjustTipHeights="false" newick="(((mid-blueD:1,(mid-blueJ:1,mid-blueG:1):0):1,(redK:1,redD:1,redC:1,((((pinkA:1,pinkJ:1):1,(orangeJ:1,orangeG:1,orangeE:1,orangeA:1,light-purpleE:1):0):1,(dark-purpleK:1,dark-purpleJ:1,dark-purpleI:1,dark-purpleH:1,dark-purpleG:1,dark-purpleF:1,dark-purpleE:1,((light-blueH:1,light-blueK:1):1,(dark-greenK:1,dark-greenI:1,light-brownI:1,(yellowH:1,yellowK:1):1):0):1,(goldF:1,(mid-greenF:1,mid-greenE:1):0):1):0):1,(light-greenK:1,light-greenJ:1,light-greenI:1,light-greenH:1,light-greenG:1,light-greenF:1,(dark-blueD:1,(dark-blueJ:1,dark-blueG:1):0):1):0):1):0):1,(greyD:1,greyC:1,dark-brownC:1):0)">
                <taxa idref="sim1_true"/>
                <taxonset id="TaxonSet.1" spec="TaxonSet">
                    <taxon id="mid-blueD" spec="Taxon"/> <taxon id="mid-blueJ" spec="Taxon"/> <taxon id="mid-blueG" spec="Taxon"/> <taxon id="redK" spec="Taxon"/> <taxon id="redD" spec="Taxon"/> <taxon id="redC" spec="Taxon"/> <taxon id="pinkA" spec="Taxon"/> <taxon id="pinkJ" spec="Taxon"/> <taxon id="orangeJ" spec="Taxon"/> <taxon id="orangeG" spec="Taxon"/> <taxon id="orangeE" spec="Taxon"/> <taxon id="orangeA" spec="Taxon"/> <taxon id="light-purpleE" spec="Taxon"/> <taxon id="dark-purpleK" spec="Taxon"/> <taxon id="dark-purpleJ" spec="Taxon"/> <taxon id="dark-purpleI" spec="Taxon"/> <taxon id="dark-purpleH" spec="Taxon"/> <taxon id="dark-purpleG" spec="Taxon"/> <taxon id="dark-purpleF" spec="Taxon"/> <taxon id="dark-purpleE" spec="Taxon"/> <taxon id="light-blueH" spec="Taxon"/> <taxon id="light-blueK" spec="Taxon"/> <taxon id="dark-greenK" spec="Taxon"/> <taxon id="dark-greenI" spec="Taxon"/> <taxon id="light-brownI" spec="Taxon"/> <taxon id="yellowH" spec="Taxon"/> <taxon id="yellowK" spec="Taxon"/> <taxon id="goldF" spec="Taxon"/> <taxon id="mid-greenF" spec="Taxon"/> <taxon id="mid-greenE" spec="Taxon"/> <taxon id="light-greenK" spec="Taxon"/> <taxon id="light-greenJ" spec="Taxon"/> <taxon id="light-greenI" spec="Taxon"/> <taxon id="light-greenH" spec="Taxon"/> <taxon id="light-greenG" spec="Taxon"/> <taxon id="light-greenF" spec="Taxon"/> <taxon id="dark-blueD" spec="Taxon"/> <taxon id="dark-blueJ" spec="Taxon"/> <taxon id="dark-blueG" spec="Taxon"/> <taxon id="greyD" spec="Taxon"/> <taxon id="greyC" spec="Taxon"/> <taxon id="dark-brownC" spec="Taxon"/> 
