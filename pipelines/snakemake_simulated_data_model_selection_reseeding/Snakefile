import os
import sys
import glob

def get_sims():
    return [d for d in os.listdir(config['inputpath']) if os.path.isdir(os.path.join(config['inputpath'], d))]

sims = get_sims()

# Found all reseeding sims from the model selection reseeding path, discarding any with mut0005 or mig04 due to poor performance on previous evaluations
all_reseeding_path = "/grid/siepel/home/staklins/stored_results/beam/latest_results/model_selection_reseeding_no_reseeding_5_8_25_variable_rates_data_8_19_24/reseeding_sims.txt"
with open(all_reseeding_path, 'r') as f:
    all_reseeding = [line.strip() for line in f]

# Counted the number of reseeding sims that were available, noticed none of them had mig7, then found all non-reseeding sims and discarded mig4 and mut0005 and mig7, and then randomly shuffled the file and took the top n to match the number of reseeding n from above (done to prevent any class imbalance)
chosen_non_reseeding_path = "/grid/siepel/home/staklins/stored_results/beam/latest_results/model_selection_reseeding_no_reseeding_5_8_25_variable_rates_data_8_19_24/no_reseeding_sims_randomly_chosen.txt"
with open(chosen_non_reseeding_path, 'r') as f:
    chosen_non_reseeding = [line.strip() for line in f]

# Keep only the sims that are in the chosen reseeding and non-reseeding sims
sims = [sim for sim in sims if sim in all_reseeding or sim in chosen_non_reseeding]

# specific sims that need more particles to reduce the threshold for the minimum bayes factor
sims = ['mig5_mut0025_1251', 'mig5_mut005_21812', 'mig5_mut005_23638', 'mig6_mut0025_12143', 'mig6_mut005_30294', 'mig6_mut01_23364', 'mig6_mut001_22566', 'mig5_mut01_6758', 'mig5_mut001_7848', 'mig5_mut005_2289', 'mig5_mut005_28953', 'mig5_mut001_974', 'mig5_mut01_2534', 'mig6_mut01_26589', 'mig6_mut001_22110', 'mig6_mut01_28748', 'mig6_mut005_28340', 'mig6_mut01_13401', 'mig5_mut01_6232', 'mig6_mut0025_25796', 'mig5_mut005_6169', 'mig6_mut01_32163', 'mig5_mut0025_10050', 'mig6_mut001_13259', 'mig6_mut001_18037', 'mig5_mut0025_6233', 'mig5_mut0025_2468', 'mig5_mut005_1707', 'mig6_mut005_9570', 'mig5_mut0025_32617', 'mig5_mut01_28920', 'mig6_mut005_21643', 'mig5_mut001_1688', 'mig6_mut001_30120', 'mig5_mut005_24716', 'mig5_mut005_10364', 'mig6_mut0025_1342', 'mig6_mut001_10537', 'mig5_mut005_10837', 'mig6_mut0025_17715', 'mig6_mut01_4374', 'mig6_mut001_25214', 'mig5_mut0025_19909', 'mig5_mut01_6228', 'mig6_mut005_1596', 'mig6_mut01_21493']


