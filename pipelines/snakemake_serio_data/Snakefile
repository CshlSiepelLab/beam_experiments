        echo "mouse_cp,mutual_information_normalized" > {output.combinedResults}
        
        for file in $files; do
            mouse=$(basename $(dirname $(dirname $file)))
            cp=$(basename $(dirname $file))
            mutual_information=$(head -n 1 $file | tr -d '[:space:]')
