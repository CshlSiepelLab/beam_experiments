        -D numEditRates=\"$numEditRates\" \
        -D numEditRatesPlusTwo=\"$numEditRatesPlusTwo\" \
        -D numTissueRates=\"$numTissueRates\" \
        -D numTissues=\"$numTissues\" \
        -D outname=chain_{wildcards.num} \
        {params.fileDir}/{wildcards.num}.xml > {output.terminalLog}
        """

rule prepMach2:
    input:
        lamlTreeNoBranchLengths = "{outdir}/laml/{mouse}/{cp}/laml_trees_no_branch_lengths.nwk",
        tissues = "{outdir}/beam/{mouse}/{cp}/{cp}_tip_tissues.csv"
    output:
        labeling = "{outdir}/mach2/{mouse}/{cp}/laml_trees_no_branch_lengths.labeling",
        edges = "{outdir}/mach2/{mouse}/{cp}/laml_trees_no_branch_lengths.tree",
        colors = "{outdir}/mach2/{mouse}/{cp}/laml_trees_no_branch_lengths_colors.txt"
    params:
        scripts = config['scripts'],
        outputdir = "{outdir}/mach2/{mouse}/{cp}",
        primaryTissue = lambda wildcards: config['primaryTissue'][wildcards.mouse],
        threads = 1,
        mem = '1G'
    singularity:
        f"{config['containers']}/cassiopeia.sif"
    shell:
        """
        # convert csv to tsv for leaf labels
        sed 's/,/\\t/g' {input.tissues} > {params.outputdir}/leaf_tissues.tsv

        # prep inputs
        python {params.scripts}/machina/prep_machina.py {input.lamlTreeNoBranchLengths} {params.outputdir} {params.primaryTissue} {params.outputdir}/leaf_tissues.tsv

        # for the labeling and colors file, make sure the names do not have . or - characters
        sed -i 's/\./_/g; s/-/_/g' {output.labeling}
        sed -i 's/\./_/g; s/-/_/g' {output.edges}
        """

rule runMach2:
    input:
        labeling = "{outdir}/mach2/{mouse}/{cp}/laml_trees_no_branch_lengths.labeling",
        edges = "{outdir}/mach2/{mouse}/{cp}/laml_trees_no_branch_lengths.tree",
        colors = "{outdir}/mach2/{mouse}/{cp}/laml_trees_no_branch_lengths_colors.txt"
    output:
        mach2graph = "{outdir}/mach2/{mouse}/{cp}/PRL-G-0.graph"
    params:
        scripts = config['scripts'],
        outputdir = "{outdir}/mach2/{mouse}/{cp}",
        primaryTissue = lambda wildcards: config['primaryTissue'][wildcards.mouse],
        threads = 150,
        mem = '3G'
    singularity:
        f"{config['containers']}/crispr_barcode_migration_inference.sif"
    shell:
        """
        unique_tissues=$(cut -f2 {input.labeling} | sort | uniq)
        num_unique_tissues=$(echo "$unique_tissues" | wc -l)

        if [ "$num_unique_tissues" -gt 1 ]; then
            # check if primary tissue is in the labeling file
            if grep -q "{params.primaryTissue}" {input.labeling}; then
                mach2 {input.edges} {input.labeling} --colormap {input.colors} -p {params.primaryTissue} --log -o {params.outputdir} -t {params.threads}

                # Need to touch output files to satisfy output, only if output with a different name exists
                if [ $(ls {params.outputdir}/*.graph | wc -l) -gt 0 ] && [ ! -f {output.mach2graph} ]; then
                    touch {output}
                fi
            else
                most_common_tissue=$(cut -f2 {input.labeling} | sort | uniq -c | sort -nr | head -n 1 | awk '{{print $2}}')
                echo "The {params.primaryTissue} is not in the tissue labels. Using the most common tissue $most_common_tissue as the primary tissue."
                mach2 {input.edges} {input.labeling} --colormap {input.colors} -p $most_common_tissue --log -o {params.outputdir} -t {params.threads}

                # Need to touch output files to satisfy output, only if output with a different name exists
                if [ $(ls {params.outputdir}/*.graph | wc -l) -gt 0 ] && [ ! -f {output.mach2graph} ]; then
                    touch {output}
                fi
            fi
        else
            echo "Only one unique tissue found in the labeling file, so not enough to run Mach2. Exiting."
            touch {output}
        fi
        """

rule gatherMach2Results:
    input:
        mach2graph = "{outdir}/mach2/{mouse}/{cp}/PRL-G-0.graph"
    output:
        mach2Combined = "{outdir}/mach2/{mouse}/{cp}/graph_results_combined.txt",
        mach2Consensus = "{outdir}/mach2/{mouse}/{cp}/consensus_graph.txt"
    params:
        scripts = config['scripts'],
        outputdir = "{outdir}/mach2/{mouse}/{cp}",
        threads = 1,
        mem = '1G'
    shell:
        """
        # get all graph files
        results=$(find $(dirname {input.mach2graph}) -name "*.graph")

        # combine all results
        echo "result_num,source,target,count" > {output.mach2Combined}
        for file in $results; do
            result_num=$(basename $file | cut -d'-' -f3 | cut -d'.' -f1)
            while IFS= read -r line; do
                echo "$result_num,$(echo $line | tr ' ' ',')" >> {output.mach2Combined}
            done < "$file"
        done

        # get the probability weighted edge consensus graph
        python {params.scripts}/formatting/convert_mach2_results_to_consensus_graph.py {output.mach2Combined} {output.mach2Consensus}
        """

rule getMach2Classifications:
    input:
        mach2Consensus = "{outdir}/mach2/{mouse}/{cp}/consensus_graph.txt",
    output:
        mach2Classifications = "{outdir}/mach2/{mouse}/{cp}/mach2_consensus_classifications.csv",
    params:
        primaryTissue = lambda wildcards: config['primaryTissue'][wildcards.mouse],
        consensusThresholds = [0.5, 0.6, 0.7, 0.8, 0.9, 0.95, 0.99],
        scripts = config['scripts'],
        threads = 1,
        mem = '1G',
    shell:
        """
        echo "name,threshold,met_to_met,met_to_primary" > {output.mach2Classifications}

        for consensusThreshold in {params.consensusThresholds}; do

            met_to_primary=False
            met_to_met=False

            if [ ! -s {input.mach2Consensus} ]; then
                echo "Must be false classifications since the consensus graph is empty, indicating mach2 did not run due to only one tissue in labeling input."
            else
                while IFS= read -r line; do
                    if [ "$met_to_met" = "True" ] && [ "$met_to_primary" = "True" ]; then
                        continue
                    fi

                    migration=$(echo $line | cut -d',' -f1)
                    freq=$(echo $line | cut -d',' -f2)

                    if (( $(echo "$freq > $consensusThreshold" | bc -l) )); then
                        source=$(echo $migration | cut -d'_' -f1)
                        target=$(echo $migration | cut -d'_' -f2)

                        if [ "$target" = "{params.primaryTissue}" ]; then
                            met_to_primary=True
                        fi

                        if [ "$source" != "{params.primaryTissue}" ] && [ "$target" != "{params.primaryTissue}" ]; then
                            met_to_met=True
                        fi
                    fi
                done < {input.mach2Consensus}
            fi

            echo "{wildcards.mouse}_{wildcards.cp},$consensusThreshold,$met_to_met,$met_to_primary" >> {output.mach2Classifications}
        done
        """
