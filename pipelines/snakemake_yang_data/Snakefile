rule runBeamGtrNs:
    input:
        fasta = indir + "/{clone}.fasta",
        tissues = indir + "/{clone}_expanded_collapsed_tissues.csv",
        editRates = indir + "/{clone}_successive_mut_freqs.txt",
        lamlTree = "{outdir}/laml/{clone}/laml_trees.nwk"
    output:
        terminalLog = "{outdir}/beam_gtr_ns/{clone}/terminal_{num}.log",
        beamLog = "{outdir}/beam_gtr_ns/{clone}/chain_{num}.log",
        beamResult = "{outdir}/beam_gtr_ns/{clone}/chain_{num}.trees"
    params:
        xml = config['gtrXml'],
        fileDir = "{outdir}/beam_gtr_ns/{clone}",
        experimentTime = lambda wildcards: config['experimentTime'][wildcards.clone],
        primaryTissue = config['primaryTissue'],
        threads = 5,
        mem = '2G'
    shell:
        """
        if [ ! -f {params.fileDir}/{wildcards.clone}.fasta ]; then
            cp {input.fasta} {params.fileDir}/{wildcards.clone}.fasta
        fi
        if [ ! -f {params.fileDir}/{wildcards.clone}_tip_tissues.csv ]; then
            cp {input.tissues} {params.fileDir}/{wildcards.clone}_tip_tissues.csv
        fi

        cp {params.xml} {params.fileDir}/{wildcards.num}.xml

        # calculate necessary inputs for the editing model
        initialEditRates=$(cat {input.editRates} | tr '\n' ' ')
        array=($initialEditRates)
        numEditRates=${{#array[@]}}
        numEditRatesPlusTwo=$(( numEditRates + 2 ))

        # format tissue information
        unique_tissues=$(cat {input.tissues} | cut -d',' -f2 | sort | uniq)
        numTissues=$(echo $unique_tissues | tr ' ' '\n' | wc -l)

        # force the known primary tissue at the origin for root frequencies in the likelihood calculation
        sorted_unique_tissues="{params.primaryTissue} $(echo $unique_tissues | tr ' ' '\n' | grep -v '^{params.primaryTissue}$' | tr '\n' ' ')"
        if ! echo "$unique_tissues" | grep -qw "{params.primaryTissue}"; then
            numTissues=$(( numTissues + 1 ))
        fi
        tissueRootFreqs=$(for i in $(seq 1 $numTissues); do if [[ "$i" = "1" ]]; then echo -n "1 "; else echo -n "0 "; fi; done)

        numTissueRates=$(( ((numTissues * numTissues) - numTissues) / 2 ))

        tissueCodeMap=""
        trailingCodeMap="? = "
        i=0
        for tissue in $sorted_unique_tissues; do
            tissueCodeMap+="$tissue=$i,"
            trailingCodeMap+="$i "
            i=$((i+1))
        done
        tissueCodeMap+="${{trailingCodeMap}}"

        # for some reason this cannot be taken in at the command line, likely because the = signs are problematic and not taken as a single string
        sed -i "s/\$(tissueCodeMap)/$tissueCodeMap/g" {params.fileDir}/{wildcards.num}.xml
        sed -i "s/\$(initialEditRates)/$initialEditRates/g" {params.fileDir}/{wildcards.num}.xml
        sed -i "s/\$(tissueRootFreqs)/$tissueRootFreqs/g" {params.fileDir}/{wildcards.num}.xml

        # use LAML starting tree
        # remove node names from newick and the origin node
        newick=$(cat {input.lamlTree} | sed 's/node[0-9]*:/:/g' | sed 's/^.//' | sed 's/..$//')

        # starting newick can often be too long to be taken in at a java command line argument for this data, so replace it here
        # but even bash commands have length limits, so split the newick string into manageable chunks and replace them one by one
        chunk_size=1000
        newick_length=${{#newick}}
        for ((i=0; i<newick_length; i+=chunk_size)); do
            chunk=${{newick:i:chunk_size}}
            sed -i "s/\$(newick)/$chunk\$(newick)/" {params.fileDir}/{wildcards.num}.xml
        done
        # Remove the remaining placeholder
        sed -i "s/\$(newick)//" {params.fileDir}/{wildcards.num}.xml

        # Replace mcmc specs with nested sampling specs
        mcmc_specs="<run id=\\"mcmc\\" spec=\\"MCMC\\" chainLength=\\"\\$(mcmclength)\\">"
        ns_specs="<run id=\\"mcmc\\" spec=\\"beast.gss.NS\\" chainLength=\\"100000000\\" particleCount=\\"1\\" subChainLength=\\"10000\\" epsilon=\\"1e-6\\">"
        sed -i "s/$mcmc_specs/$ns_specs/g" {params.fileDir}/{wildcards.num}.xml

        beast \
        -threads {params.threads} \
        -overwrite \
        -working \
        -D inName={wildcards.clone} \
        -D fileDir={params.fileDir} \
        -D generations={params.experimentTime} \
        -D numEditRates=\"$numEditRates\" \
        -D numEditRatesPlusTwo=\"$numEditRatesPlusTwo\" \
        -D numTissueRates=\"$numTissueRates\" \
        -D numTissues=\"$numTissues\" \
        -D outname=chain_{wildcards.num} \
        {params.fileDir}/{wildcards.num}.xml > {output.terminalLog}
        """

rule runBeamRandomNs:
    input:
        fasta = indir + "/{clone}.fasta",
        tissues = indir + "/{clone}_expanded_collapsed_tissues.csv",
        editRates = indir + "/{clone}_successive_mut_freqs.txt",
        lamlTree = "{outdir}/laml/{clone}/laml_trees.nwk"
    output:
        terminalLog = "{outdir}/beam_random_ns/{clone}/terminal_{num}.log",
        beamLog = "{outdir}/beam_random_ns/{clone}/chain_{num}.log",
        beamResult = "{outdir}/beam_random_ns/{clone}/chain_{num}.trees"
    params:
        xml = config['randomXml'],
        fileDir = "{outdir}/beam_random_ns/{clone}",
        experimentTime = lambda wildcards: config['experimentTime'][wildcards.clone],
        primaryTissue = config['primaryTissue'],
        threads = 5,
        mem = '2G'
    shell:
        """
        if [ ! -f {params.fileDir}/{wildcards.clone}.fasta ]; then
            cp {input.fasta} {params.fileDir}/{wildcards.clone}.fasta
        fi
        if [ ! -f {params.fileDir}/{wildcards.clone}_tip_tissues.csv ]; then
            cp {input.tissues} {params.fileDir}/{wildcards.clone}_tip_tissues.csv
        fi

        cp {params.xml} {params.fileDir}/{wildcards.num}.xml

        # calculate necessary inputs for the editing model
        initialEditRates=$(cat {input.editRates} | tr '\n' ' ')
        array=($initialEditRates)
        numEditRates=${{#array[@]}}
        numEditRatesPlusTwo=$(( numEditRates + 2 ))

        # format tissue information
        unique_tissues=$(cat {input.tissues} | cut -d',' -f2 | sort | uniq)
        numTissues=$(echo $unique_tissues | tr ' ' '\n' | wc -l)

        # force the known primary tissue at the origin for root frequencies in the likelihood calculation
        sorted_unique_tissues="{params.primaryTissue} $(echo $unique_tissues | tr ' ' '\n' | grep -v '^{params.primaryTissue}$' | tr '\n' ' ')"
        if ! echo "$unique_tissues" | grep -qw "{params.primaryTissue}"; then
            numTissues=$(( numTissues + 1 ))
        fi
        tissueRootFreqs=$(for i in $(seq 1 $numTissues); do if [[ "$i" = "1" ]]; then echo -n "1 "; else echo -n "0 "; fi; done)

        numTissueRates=$(( ((numTissues * numTissues) - numTissues) / 2 ))

        tissueCodeMap=""
        trailingCodeMap="? = "
        i=0
        for tissue in $sorted_unique_tissues; do
            tissueCodeMap+="$tissue=$i,"
            trailingCodeMap+="$i "
            i=$((i+1))
        done
        tissueCodeMap+="${{trailingCodeMap}}"

        # for some reason this cannot be taken in at the command line, likely because the = signs are problematic and not taken as a single string
        sed -i "s/\$(tissueCodeMap)/$tissueCodeMap/g" {params.fileDir}/{wildcards.num}.xml
        sed -i "s/\$(initialEditRates)/$initialEditRates/g" {params.fileDir}/{wildcards.num}.xml
        sed -i "s/\$(tissueRootFreqs)/$tissueRootFreqs/g" {params.fileDir}/{wildcards.num}.xml

        # use LAML starting tree
        # remove node names from newick and the origin node
        newick=$(cat {input.lamlTree} | sed 's/node[0-9]*:/:/g' | sed 's/^.//' | sed 's/..$//')

        # starting newick can often be too long to be taken in at a java command line argument for this data, so replace it here
        # but even bash commands have length limits, so split the newick string into manageable chunks and replace them one by one
        chunk_size=1000
        newick_length=${{#newick}}
        for ((i=0; i<newick_length; i+=chunk_size)); do
            chunk=${{newick:i:chunk_size}}
            sed -i "s/\$(newick)/$chunk\$(newick)/" {params.fileDir}/{wildcards.num}.xml
        done
        # Remove the remaining placeholder
        sed -i "s/\$(newick)//" {params.fileDir}/{wildcards.num}.xml

        # Replace mcmc specs with nested sampling specs
        mcmc_specs="<run id=\\"mcmc\\" spec=\\"MCMC\\" chainLength=\\"\\$(mcmclength)\\">"
        ns_specs="<run id=\\"mcmc\\" spec=\\"beast.gss.NS\\" chainLength=\\"100000000\\" particleCount=\\"1\\" subChainLength=\\"10000\\" epsilon=\\"1e-6\\">"
        sed -i "s/$mcmc_specs/$ns_specs/g" {params.fileDir}/{wildcards.num}.xml

        beast \
        -threads {params.threads} \
        -overwrite \
        -working \
        -D inName={wildcards.clone} \
        -D fileDir={params.fileDir} \
        -D generations={params.experimentTime} \
        -D numEditRates=\"$numEditRates\" \
        -D numEditRatesPlusTwo=\"$numEditRatesPlusTwo\" \
        -D numTissueRates=\"$numTissueRates\" \
        -D numTissues=\"$numTissues\" \
        -D outname=chain_{wildcards.num} \
        {params.fileDir}/{wildcards.num}.xml > {output.terminalLog}
        """
