import os
import sys
import glob
import pandas as pd

# Make sure beam_sup is availabe
import importlib.util
spec = importlib.util.find_spec("beam_sup")
if spec is None:
    print(f"The required package beam_sup is NOT installed, so the pipeline will not run. Exiting.")
    sys.exit(1)

interesting_clones_df = pd.read_csv(config['clonesToKeep'], sep='\t', index_col=0)
clones = set(interesting_clones_df.index.tolist())

indir = config['inputpath']
outdir = config['outdir']

rule all:
    input:
        expand("{outdir}/mach2/{clone}/T-G-0.graph", clone=clones, outdir=outdir),
        expand("{outdir}/beam_gtr/{clone}/terminal_{num}.log", clone=clones, outdir=outdir, num=range(1, config['numChains']+1)),
        expand("{outdir}/beam_gtr/{clone}/combined.log", clone=clones, outdir=outdir),
        expand("{outdir}/beam_gtr_ns/{clone}/terminal_{num}.log", clone=clones, num=range(1, 101), outdir=outdir),
        expand("{outdir}/beam_random_ns/{clone}/terminal_{num}.log", clone=clones, num=range(1, 101), outdir=outdir),



rule runCassiopeia:
    input:
         matrix = indir + "/{clone}_successive_character_matrix.tsv"
    output:
        "{outdir}/cassiopeia_greedy/{clone}/cassiopeia_greedy_inferred.nwk"
    params:
        scripts = config['scripts'],
        outputdir = "{outdir}/cassiopeia_greedy/{clone}/",
        threads = 1,
        mem = "1G"
    shell:
        """
        # run cassiopeia greedy
        python {params.scripts}/cassiopeia/cassiopeia_greedy.py {input.matrix} {params.outputdir}
        """

rule runLAML:
    input:
        matrix = indir + "/{clone}_successive_character_matrix.tsv",
        casTree = "{outdir}/cassiopeia_greedy/{clone}/cassiopeia_greedy_inferred.nwk",
        mutationPriors = indir + "/{clone}_successive_mut_priors.txt"
    output:
        lamlTree = "{outdir}/laml/{clone}/laml_trees.nwk",
        lamlAnnotations = "{outdir}/laml/{clone}/laml_annotations.txt",
        lamlTreeNoBranchLengths = "{outdir}/laml/{clone}/laml_trees_no_branch_lengths.nwk",
        lamlTreeNoOrigin = "{outdir}/laml/{clone}/laml_trees_no_origin.nwk"
    params:
        scripts = config['scripts'],
        outputdir = "{outdir}/laml/{clone}",
        experimentTime = lambda wildcards: config['experimentTime'][wildcards.clone],
        threads = 10,
        mem = "1G"
    singularity:
        f"{config['containers']}/crispr_barcode_migration_inference.sif"
    shell:
        """
        # copy matrix and replace -1 with ? for missing data
        laml_matrix={params.outputdir}/matrix.csv
        num_sites=$(head -n 1 {input.matrix} | awk -F'\t' '{{print NF-1}}')
        laml_header="cell"
        for i in $(seq 1 $num_sites); do
                laml_header+=",r$i"
            done
        echo $laml_header > $laml_matrix
        tail -n +2 {input.matrix} >> $laml_matrix
        sed -i 's/\t/,/g; s/,-1/,?/g' $laml_matrix

        # setup the Q matrix mutation priors for the mutations found in the sim matrix
        # laml requires a site specific format, so this is just a reformatting step of the input priors
        mutationPriors={params.outputdir}/mutation_priors.csv
        python {params.scripts}/formatting/format_laml_mutation_priors.py $laml_matrix {input.mutationPriors} $mutationPriors

        # run laml
        run_laml -c $laml_matrix -t {input.casTree} -p $mutationPriors -o {params.outputdir}/laml --timescale {params.experimentTime} --topology_search --keep_polytomies --parallel

        # remove origin from tree
        fixed_newick=$(cat {output.lamlTree} | sed 's/\[&R\]//g' | sed "s/);//g")
        fixed_newick="${{fixed_newick:1}});"
        last_branch=$(echo "$fixed_newick" | grep -oP ':[0-9]+\.[0-9]+(?=\)\;)' | tail -1 | tr -d ':')
        second_last_branch=$(echo "$fixed_newick" | grep -oP ':[0-9]+\.[0-9]+(?=\))' | tail -2 | head -1 | tr -d ':')
        new_branch=$(echo "$last_branch + $second_last_branch" | bc)
        modified_newick=$(echo "$fixed_newick" | sed -r "s/$second_last_branch\):$last_branch/0$new_branch/g")
        echo $modified_newick > {output.lamlTreeNoOrigin}

        # obtain newick without branch lengths
        sed 's/:\([0-9]\+\.\?\([0-9]\+\)\?\)//g' {output.lamlTreeNoOrigin} > {output.lamlTreeNoBranchLengths}
        """


rule runBeamGtr:
    input:
        fasta = indir + "/{clone}.fasta",
        tissues = indir + "/{clone}_expanded_collapsed_tissues.csv",
        editRates = indir + "/{clone}_successive_mut_freqs.txt",
        lamlTree = "{outdir}/laml/{clone}/laml_trees.nwk"
    output:
        terminalLog = "{outdir}/beam_gtr/{clone}/terminal_{num}.log",
        beamLog = "{outdir}/beam_gtr/{clone}/chain_{num}.log",
        beamResult = "{outdir}/beam_gtr/{clone}/chain_{num}.trees"
    params:
        xml = config['gtrXml'],
        fileDir = "{outdir}/beam_gtr/{clone}",
        experimentTime = lambda wildcards: config['experimentTime'][wildcards.clone],
        mcmclength = config['mcmcLength'],
        primaryTissue = config['primaryTissue'],
        threads = 5,
        mem = "2G"
    shell:
        """
        if [ ! -f {params.fileDir}/{wildcards.clone}.fasta ]; then
            cp {input.fasta} {params.fileDir}/{wildcards.clone}.fasta
        fi
        if [ ! -f {params.fileDir}/{wildcards.clone}_tip_tissues.csv ]; then
            cp {input.tissues} {params.fileDir}/{wildcards.clone}_tip_tissues.csv
        fi

        cp {params.xml} {params.fileDir}/{wildcards.num}.xml

        # calculate necessary inputs for the editing model
        initialEditRates=$(cat {input.editRates} | tr '\n' ' ')
        array=($initialEditRates)
        numEditRates=${{#array[@]}}
        numEditRatesPlusTwo=$(( numEditRates + 2 ))

        # format tissue information
        unique_tissues=$(cat {input.tissues} | cut -d',' -f2 | sort | uniq)
        numTissues=$(echo $unique_tissues | tr ' ' '\n' | wc -l)

        # force the known primary tissue at the origin for root frequencies in the likelihood calculation
        sorted_unique_tissues="{params.primaryTissue} $(echo $unique_tissues | tr ' ' '\n' | grep -v '^{params.primaryTissue}$' | tr '\n' ' ')"
        if ! echo "$unique_tissues" | grep -qw "{params.primaryTissue}"; then
            numTissues=$(( numTissues + 1 ))
        fi
        tissueRootFreqs=$(for i in $(seq 1 $numTissues); do if [[ "$i" = "1" ]]; then echo -n "1 "; else echo -n "0 "; fi; done)

        numTissueRates=$(( ((numTissues * numTissues) - numTissues) / 2 ))

        tissueCodeMap=""
        trailingCodeMap="? = "
        i=0
        for tissue in $sorted_unique_tissues; do
            tissueCodeMap+="$tissue=$i,"
            trailingCodeMap+="$i "
            i=$((i+1))
        done
        tissueCodeMap+="${{trailingCodeMap}}"

        # for some reason this cannot be taken in at the command line, likely because the = signs are problematic and not taken as a single string
        sed -i "s/\$(tissueCodeMap)/$tissueCodeMap/g" {params.fileDir}/{wildcards.num}.xml
        sed -i "s/\$(initialEditRates)/$initialEditRates/g" {params.fileDir}/{wildcards.num}.xml
        sed -i "s/\$(tissueRootFreqs)/$tissueRootFreqs/g" {params.fileDir}/{wildcards.num}.xml

        # use LAML starting tree
        # remove node names from newick and the origin node
        newick=$(cat {input.lamlTree} | sed 's/node[0-9]*:/:/g' | sed 's/^.//' | sed 's/..$//')

        # starting newick can often be too long to be taken in at a java command line argument for this data, so replace it here
        # but even bash commands have length limits, so split the newick string into manageable chunks and replace them one by one
        chunk_size=1000
        newick_length=${{#newick}}
        for ((i=0; i<newick_length; i+=chunk_size)); do
            chunk=${{newick:i:chunk_size}}
            sed -i "s/\$(newick)/$chunk\$(newick)/" {params.fileDir}/{wildcards.num}.xml
        done
        # Remove the remaining placeholder
        sed -i "s/\$(newick)//" {params.fileDir}/{wildcards.num}.xml

        beast \
        -threads {params.threads} \
        -resume \
        -working \
        -D inName={wildcards.clone} \
        -D fileDir={params.fileDir} \
        -D generations={params.experimentTime} \
        -D numEditRates=\"$numEditRates\" \
        -D numEditRatesPlusTwo=\"$numEditRatesPlusTwo\" \
        -D numTissueRates=\"$numTissueRates\" \
        -D numTissues=\"$numTissues\" \
        -D mcmclength={params.mcmclength} \
        -D outname=chain_{wildcards.num} \
        {params.fileDir}/{wildcards.num}.xml > {output.terminalLog}
        """

rule combineBeamChains:
    input:
        terminalLog = lambda wildcards: expand("{outdir}/beam_gtr/{clone}/terminal_{num}.log", num=range(1, config['numChains']+1), clone=wildcards.clone, outdir=wildcards.outdir),
        beamLogs = lambda wildcards: expand("{outdir}/beam_gtr/{clone}/chain_{num}.log", num=range(1, config['numChains']+1), clone=wildcards.clone, outdir=wildcards.outdir),
        beamResults = lambda wildcards: expand("{outdir}/beam_gtr/{clone}/chain_{num}.trees", num=range(1, config['numChains']+1), clone=wildcards.clone, outdir=wildcards.outdir),
    output:
        combinedLog = "{outdir}/beam_gtr/{clone}/combined.log",
        combinedTrees = "{outdir}/beam_gtr/{clone}/combined.trees"
    params:
        logcombiner = config['logcombiner'],
        essCutoff = config['essCutoff'],
        treeannotator = config['treeannotator'],
        threads = 1,
        mem = '1G'
    shell:
        """
        # find chains that have converged based on ess threshold specified
        log_files=""
        trees_files=""
        ess_convergences=()
        for file in {input.beamLogs}; do
            terminal_log=$(echo $file | sed 's/chain_/terminal_/')
            
            ess_convergence=$(grep "Msamples" $terminal_log | tail -n 1 | sed 's/^ *//;s/ *$//' | tr -s ' ' | cut -d' ' -f3)
            if (( $(echo "$ess_convergence > {params.essCutoff}" | bc -l) )); then
                log_files+="-log $file "
                trees_file=$(echo $file | sed 's/\.log$/.trees/')
                trees_files+="-log $trees_file "
            else
                echo "$file did not converge, so not including it in the final output"
            fi
        done

        # combine logs and trees that passed
        if [ -n "$log_files" ]; then
            {params.logcombiner} $log_files -o {output.combinedLog}
            {params.logcombiner} $trees_files -o {output.combinedTrees}
        else
            echo "No chains passed the ESS threshold of {params.essCutoff}, so not combining any chains"
        fi
        """

