rule getExpectedClassificationsAndTimes:
    input:
        metastasisTiming = "{outdir}/beam_gtr/{mouse}/{cp}/metastasis_timing.pkl",
    output:
        allClassifications = "{outdir}/beam_gtr/{mouse}/{cp}/all_consensus_classifications.csv",
        allTimes = "{outdir}/beam_gtr/{mouse}/{cp}/all_expected_migration_times_no_multiedge_combined.csv",
    params:
        primaryTissue = config['primaryTissue'],
        thresholds = config['thresholds'],
        outprefix = "{outdir}/beam_gtr/{mouse}/{cp}/{mouse}_{cp}",
        scripts = config['scripts'],
        threads = 1,
        mem = "1G"
    singularity:
        f"{config['containers']}/crispr_barcode_migration_inference.sif"
    shell:
        """
        echo "name,met_to_met,met_to_primary,threshold" > {output.allClassifications}
        echo "name,source,target,time,threshold" > {output.allTimes}

        for threshold in {params.thresholds}; do
            python {params.scripts}/formatting/get_consensus_times_and_classifications.py {input.metastasisTiming} {params.primaryTissue} $threshold {params.outprefix}

            formatted_threshold=$(echo "$threshold * 100" | bc | awk '{{printf "%.0f", $0}}')
            tail -n +2 {params.outprefix}_consensus_classifications_$formatted_threshold.csv | awk -v t=$threshold '{{print $0","t}}' >> {output.allClassifications}
            tail -n +2 {params.outprefix}_expected_migration_times_no_multiedge_$formatted_threshold.csv | awk -v t=$threshold '{{print $0","t}}' >> {output.allTimes}

            # clean up
            rm {params.outprefix}_consensus_classifications_$formatted_threshold.csv
            rm {params.outprefix}_expected_migration_times_no_multiedge_$formatted_threshold.csv
            rm {params.outprefix}_expected_migration_times_all_$formatted_threshold.csv
        done
        """

rule collectMouseLevelClassificationsAndTimes:
    input:
        allClassifications = lambda wildcards: expand("{outdir}/beam_gtr/{mouse}/{cp}/all_consensus_classifications.csv",
            mouse=wildcards.mouse, cp=cps_for_mouse[wildcards.mouse], outdir=wildcards.outdir),
        allTimes = lambda wildcards: expand("{outdir}/beam_gtr/{mouse}/{cp}/all_expected_migration_times_no_multiedge_combined.csv",
            mouse=wildcards.mouse, cp=cps_for_mouse[wildcards.mouse], outdir=wildcards.outdir),
    output:
        combinedClassifications = "{outdir}/beam_gtr/{mouse}/all_consensus_classifications.csv",
        combinedTimes = "{outdir}/beam_gtr/{mouse}/all_expected_migration_times_no_multiedge_combined.csv",
    params:
        threads = 1,
        mem = "1G"
    shell:
        """
        echo "name,met_to_met,met_to_primary,threshold" > {output.combinedClassifications}
        for file in {input.allClassifications}; do
            tail -n +2 $file >> {output.combinedClassifications}
        done

        echo "name,source_target,time,threshold" > {output.combinedTimes}
        for file in {input.allTimes}; do
            tail -n +2 $file >> {output.combinedTimes}
        done
        """

