rule prepMach2:
    input:
        lamlTreeNoBranchLengths = "{outdir}/laml/{mouse}/{cp}/laml_trees_no_branch_lengths.nwk",
        tissues = "{outdir}/beam/{mouse}/{cp}/{mouse}_{cp}_tip_tissues.csv"
    output:
        tissuesTsv = "{outdir}/mach2/{mouse}/{cp}/leaf_tissues.tsv",
        labeling = "{outdir}/mach2/{mouse}/{cp}/laml_trees_no_branch_lengths.labeling",
        colors = "{outdir}/mach2/{mouse}/{cp}/laml_trees_no_branch_lengths_colors.txt",
        tree = "{outdir}/mach2/{mouse}/{cp}/laml_trees_no_branch_lengths.tree",
    params:
        primaryTissue = config['primaryTissue'],
        scripts = config['scripts'],
        outputdir = "{outdir}/mach2/{mouse}/{cp}",
        threads = 1,
        mem = '1G'
    singularity:
        f"{config['containers']}/cassiopeia.sif"
    shell:
        """
        # convert csv to tsv for leaf labels
        sed 's/,/\\t/g' {input.tissues} > {output.tissuesTsv}

        # prep inputs
        python {params.scripts}/machina/prep_machina.py {input.lamlTreeNoBranchLengths} {params.outputdir} {params.primaryTissue} {output.tissuesTsv}

        # for the labeling and colors file, make sure the names do not have . or - characters
        sed -i 's/\./_/g; s/-/_/g' {output.labeling}
        sed -i 's/\./_/g; s/-/_/g' {output.tree}
        """

rule runMach2:
    input:
        labeling = "{outdir}/mach2/{mouse}/{cp}/laml_trees_no_branch_lengths.labeling",
        colors = "{outdir}/mach2/{mouse}/{cp}/laml_trees_no_branch_lengths_colors.txt",
        tree = "{outdir}/mach2/{mouse}/{cp}/laml_trees_no_branch_lengths.tree",
    output:
        mach2graph = "{outdir}/mach2/{mouse}/{cp}/LL-G-0.graph",
    params:
        scripts = config['scripts'],
        outputdir = "{outdir}/mach2/{mouse}/{cp}",
        primaryTissue = config['primaryTissue'],
        threads = 50,
        mem = '8G',
    singularity:
        f"{config['containers']}/crispr_barcode_migration_inference.sif"
    shell:
        """
        unique_tissues=$(cut -f2 {input.labeling} | sort | uniq)
        num_unique_tissues=$(echo "$unique_tissues" | wc -l)

        if [ "$num_unique_tissues" -gt 1 ]; then
            # check if primary tissue is in the labeling file
            if grep -q "{params.primaryTissue}" {input.labeling}; then
                mach2 {input.tree} {input.labeling} --colormap {input.colors} -p {params.primaryTissue} --log -o {params.outputdir} -t {params.threads}

                # Need to touch output files to satisfy output, only if output with a different name exists
                if [ $(ls {params.outputdir}/*.graph | wc -l) -gt 0 ] && [ ! -f {output.mach2graph} ]; then
                    touch {output}
                fi
            else
                most_common_tissue=$(cut -f2 {input.labeling} | sort | uniq -c | sort -nr | head -n 1 | awk '{{print $2}}')
                echo "The {params.primaryTissue} is not in the tissue labels. Using the most common tissue $most_common_tissue as the primary tissue."
                mach2 {input.tree} {input.labeling} --colormap {input.colors} -p $most_common_tissue --log -o {params.outputdir} -t {params.threads}

                # Need to touch output files to satisfy output, only if output with a different name exists
                if [ $(ls {params.outputdir}/*.graph | wc -l) -gt 0 ] && [ ! -f {output.mach2graph} ]; then
                    touch {output}
                fi
            fi
        else
            echo "Only one unique tissue found in the labeling file, so not enough to run Machina. Exiting."
            touch {output}
        fi
        """

rule gatherMach2Results:
    input:
        mach2graph = "{outdir}/mach2/{mouse}/{cp}/LL-G-0.graph"
    output:
        mach2Combined = "{outdir}/mach2/{mouse}/{cp}/graph_results_combined.txt",
        mach2Consensus = "{outdir}/mach2/{mouse}/{cp}/consensus_graph.txt",
    params:
        scripts = config['scripts'],
        outputdir = "{outdir}/mach2/{mouse}/{cp}",
        threads = 1,
        mem = '1G',
    shell:
        """
        # get all graph files
        results=$(find $(dirname {input.mach2graph}) -name "*.graph")

        # combine all results
        echo "result_num,source,target,count" > {output.mach2Combined}
        for file in $results; do
            result_num=$(basename $file | cut -d'-' -f3 | cut -d'.' -f1)
            while IFS= read -r line; do
                echo "$result_num,$(echo $line | tr ' ' ',')" >> {output.mach2Combined}
            done < "$file"
        done

        # get the probability weighted edge consensus graph
        python {params.scripts}/formatting/convert_mach2_results_to_consensus_graph.py {output.mach2Combined} {output.mach2Consensus}
        """

rule getMach2Classifications:
    input:
        mach2Consensus = "{outdir}/mach2/{mouse}/{cp}/consensus_graph.txt",
    output:
        mach2Classifications = "{outdir}/mach2/{mouse}/{cp}/mach2_consensus_classifications.csv",
    params:
        primaryTissue = config['primaryTissue'],
        consensusThresholds = [0.5, 0.6, 0.7, 0.8, 0.9, 0.95, 0.99],
        scripts = config['scripts'],
        threads = 1,
        mem = '1G',
    shell:
        """
        echo "name,threshold,met_to_met,met_to_primary" > {output.mach2Classifications}

        for consensusThreshold in {params.consensusThresholds}; do

            met_to_primary=False
            met_to_met=False

            if [ ! -s {input.mach2Consensus} ]; then
                echo "Must be false classifications since the consensus graph is empty, indicating mach2 did not run due to only one tissue in labeling input."
            else
                while IFS= read -r line; do
                    if [ "$met_to_met" = "True" ] && [ "$met_to_primary" = "True" ]; then
                        continue
                    fi

                    migration=$(echo $line | cut -d',' -f1)
                    freq=$(echo $line | cut -d',' -f2)

                    if (( $(echo "$freq > $consensusThreshold" | bc -l) )); then
                        source=$(echo $migration | cut -d'_' -f1)
                        target=$(echo $migration | cut -d'_' -f2)

                        if [ "$target" = "{params.primaryTissue}" ]; then
                            met_to_primary=True
                        fi

                        if [ "$source" != "{params.primaryTissue}" ] && [ "$target" != "{params.primaryTissue}" ]; then
                            met_to_met=True
                        fi
                    fi
                done < {input.mach2Consensus}
            fi

            echo "{wildcards.mouse}_{wildcards.cp},$consensusThreshold,$met_to_met,$met_to_primary" >> {output.mach2Classifications}
        done
        """

rule runBeamGtrNs:
    input:
        fasta = "{outdir}/beam/{mouse}/{cp}/{mouse}_{cp}.fasta",
        tissues = "{outdir}/beam/{mouse}/{cp}/{mouse}_{cp}_tip_tissues.csv",
        editRates = "{outdir}/beam/{mouse}/{cp}/{mouse}_{cp}_fixed_edit_rates.txt",
        lamlTree = "{outdir}/laml/{mouse}/{cp}/laml_trees.nwk"
    output:
        terminalLog = "{outdir}/beam_gtr_ns/{mouse}/{cp}/terminal_{num}.log",
        beamLog = "{outdir}/beam_gtr_ns/{mouse}/{cp}/chain_{num}.log",
        beamResult = "{outdir}/beam_gtr_ns/{mouse}/{cp}/chain_{num}.trees"
    params:
        xml = config['gtrXml'],
        inFileDir = "{outdir}/beam/{mouse}/{cp}",
        fileDir = "{outdir}/beam_gtr_ns/{mouse}/{cp}",
        experimentTime = lambda wildcards: config['experimentTime'][wildcards.mouse],
        primaryTissue = config['primaryTissue'],
        threads = 5,
        mem = '80G'
    shell:
        """
        cp {params.xml} {params.fileDir}/{wildcards.num}.xml

        # calculate necessary inputs for the editing model
        initialEditRates=$(cat {input.editRates} | tr '\n' ' ')
        array=($initialEditRates)
        numEditRates=${{#array[@]}}
        numEditRatesPlusTwo=$(( numEditRates + 2 ))

        # format tissue information
        unique_tissues=$(cat {input.tissues} | cut -d',' -f2 | sort | uniq)
        numTissues=$(echo $unique_tissues | tr ' ' '\n' | wc -l)

        # if numTissues is 1, then the model will not run, so we need to add a dummy tissue
        if [[ $numTissues -eq 1 ]]; then
            # if the primary already exists then add a dummy
            if echo "$unique_tissues" | grep -w "{params.primaryTissue}"; then
                unique_tissues="$unique_tissues dummy"
            # if not, then add the primary as the dummy
            else
                unique_tissues="{params.primaryTissue} $unique_tissues"
            fi
            numTissues=$(( numTissues + 1 ))
        fi

        # force the known primary tissue at the origin for root frequencies in the likelihood calculation
        sorted_unique_tissues="{params.primaryTissue} $(echo $unique_tissues | tr ' ' '\n' | grep -v '^{params.primaryTissue}$' | tr '\n' ' ')"
        if ! echo "$unique_tissues" | grep -qw "{params.primaryTissue}"; then
            numTissues=$(( numTissues + 1 ))
        fi
        tissueRootFreqs=$(for i in $(seq 1 $numTissues); do if [[ "$i" = "1" ]]; then echo -n "1 "; else echo -n "0 "; fi; done)

        numTissueRates=$(( ((numTissues * numTissues) - numTissues) / 2 ))

        tissueCodeMap=""
        trailingCodeMap="? = "
        i=0
        for tissue in $sorted_unique_tissues; do
            tissueCodeMap+="$tissue=$i,"
            trailingCodeMap+="$i "
            i=$((i+1))
        done
        tissueCodeMap+="${{trailingCodeMap}}"

        # for some reason this cannot be taken in at the command line, likely because the = signs are problematic and not taken as a single string
        sed -i "s/\$(tissueCodeMap)/$tissueCodeMap/g" {params.fileDir}/{wildcards.num}.xml
        sed -i "s/\$(initialEditRates)/$initialEditRates/g" {params.fileDir}/{wildcards.num}.xml
        sed -i "s/\$(tissueRootFreqs)/$tissueRootFreqs/g" {params.fileDir}/{wildcards.num}.xml

        # use LAML starting tree
        # remove node names from newick and the origin node
        newick=$(cat {input.lamlTree} | sed 's/node[0-9]*:/:/g' | sed 's/^.//' | sed 's/..$//')

        # starting newick can often be too long to be taken in at a java command line argument for this data, so replace it here
        # but even bash commands have length limits, so split the newick string into manageable chunks and replace them one by one
        chunk_size=1000
        newick_length=${{#newick}}
        for ((i=0; i<newick_length; i+=chunk_size)); do
            chunk=${{newick:i:chunk_size}}
            sed -i "s/\$(newick)/$chunk\$(newick)/" {params.fileDir}/{wildcards.num}.xml
        done
        # Remove the remaining placeholder
        sed -i "s/\$(newick)//" {params.fileDir}/{wildcards.num}.xml

        # Replace mcmc specs with nested sampling specs
        mcmc_specs="<run id=\\"mcmc\\" spec=\\"MCMC\\" chainLength=\\"\\$(mcmclength)\\">"
        ns_specs="<run id=\\"mcmc\\" spec=\\"beast.gss.NS\\" chainLength=\\"100000000\\" particleCount=\\"1\\" subChainLength=\\"10000\\" epsilon=\\"1e-6\\">"
        sed -i "s/$mcmc_specs/$ns_specs/g" {params.fileDir}/{wildcards.num}.xml

        beast \
        -threads {params.threads} \
        -overwrite \
        -working \
        -D inName={wildcards.mouse}_{wildcards.cp} \
        -D fileDir={params.inFileDir} \
        -D generations={params.experimentTime} \
        -D numEditRates=\"$numEditRates\" \
        -D numEditRatesPlusTwo=\"$numEditRatesPlusTwo\" \
        -D numTissueRates=\"$numTissueRates\" \
        -D numTissues=\"$numTissues\" \
        -D outname=chain_{wildcards.num} \
        {params.fileDir}/{wildcards.num}.xml > {output.terminalLog}
        """

rule runBeamRandomNs:
    input:
        fasta = "{outdir}/beam/{mouse}/{cp}/{mouse}_{cp}.fasta",
        tissues = "{outdir}/beam/{mouse}/{cp}/{mouse}_{cp}_tip_tissues.csv",
        editRates = "{outdir}/beam/{mouse}/{cp}/{mouse}_{cp}_fixed_edit_rates.txt",
        lamlTree = "{outdir}/laml/{mouse}/{cp}/laml_trees.nwk"
    output:
