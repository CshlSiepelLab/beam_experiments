rule runPathfinder:
    input:
        pathfinderTissues = "{outdir}/pathfinder/{sim}/clone_presence.txt",
        pathfinderFasta = "{outdir}/pathfinder/{sim}/clone_aln.fas"
    output:
        pathfinderResult = "{outdir}/pathfinder/{sim}/clone_aln_all_output_counts.txt"
    params:
        outputdir = "{outdir}/pathfinder/{sim}",
        primaryTissue = config['primaryTissue'],
        scripts = config['scripts'],
        threads = 1,
        mem = '25G'
    singularity:
        f"{config['containers']}/pathfinder.sif"
    shell:
        """
        # Check that the primary tissue is in the tissues file
        primaryTissue="{params.primaryTissue}"
        if ! grep -q "{params.primaryTissue}" {input.pathfinderTissues}; then
            most_common_tissue=$(awk 'NR>1 {{sum=0; for (i=2; i<=NF; i++) sum+=$i; print $1, sum}}' {input.pathfinderTissues} | sort -k2,2nr | head -n1 | awk '{{print $1}}')
            echo -e "The {params.primaryTissue} is not in the tissue labels. Using the most common tissue ${{most_common_tissue}} as the primary tissue."
            primaryTissue=${{most_common_tissue}}
        fi

        # Remove any incomplete previous runs
        rm -rf {params.outputdir}/scratch*

        python {params.scripts}/pathfinder/pathfinder.py {input.pathfinderFasta} {input.pathfinderTissues} --primary $primaryTissue -o {params.outputdir} --relax_threshold --scripts {params.scripts}/pathfinder --verbosity 4
        """


