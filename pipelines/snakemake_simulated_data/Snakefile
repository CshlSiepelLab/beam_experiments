import os
import sys
import glob

# Make sure beam_sup is availabe
import importlib.util
spec = importlib.util.find_spec("beam_sup")
if spec is None:
    print(f"The required package beam_sup is NOT installed, so the pipeline will not run. Exiting.")
    sys.exit(1)

def get_sims():
    return [d for d in os.listdir(config['inputpath']) if os.path.isdir(os.path.join(config['inputpath'], d))]

sims = get_sims()
outdir = config['outdir']

rule all:
    input:
        expand("{outdir}/true_trees/{sim}/tissue_labeled_tree.nwk", sim=sims, outdir=outdir),
        # expand("{outdir}/true_trees/{sim}/true_tissue_migration_graph.pdf", sim=sims, outdir=outdir),
        # expand("{outdir}/machina/{sim}/machina_tree_all_tissue_labels.nwk", sim=sims, outdir=outdir),
        expand("{outdir}/metient/{sim}/{sim}_{primaryTissue}_consensus_migration_graph.txt", sim=sims, outdir=outdir, primaryTissue=config['primaryTissue']),
        # expand("{outdir}/pathfinder/{sim}/clone_aln_all_output_counts.txt", sim=sims, outdir=outdir),
        expand("{outdir}/mach2/{sim}/consensus_graph.txt", outdir=outdir, sim=sims),
        expand("{outdir}/random_consensus_parsimony_tissue_inference/{sim}/random_tissues.nwk", sim=sims, outdir=outdir),
        expand("{outdir}/beam_gtr/{sim}/probability_migration_graph.pdf", sim=sims, outdir=outdir),
        f"{outdir}/precision_recall_curve/precision_recall.pdf",
        # expand("{outdir}/beam_gtr_ns/{sim}/terminal_{num}.log", sim=sims, num=range(1, 101), outdir=outdir),
        # expand("{outdir}/beam_random_ns/{sim}/terminal_{num}.log", sim=sims, num=range(1, 101), outdir=outdir),


rule runCassiopeia:
    input:
        sim_matrix = lambda wildcards : glob.glob(os.path.join(config['inputpath'], wildcards.sim, "*_indel_character_matrix.tsv")),
    output:
        "{outdir}/cassiopeia_greedy/{sim}/cassiopeia_greedy_inferred.nwk"
    params:
        cassiopeia_script = os.path.join(config['scripts'], "cassiopeia/cassiopeia_greedy.py"),
        outputdir = "{outdir}/cassiopeia_greedy/{sim}",
        threads = 1,
        mem = '1G'
    shell:
        """
        # run cassiopeia greedy
        python {params.cassiopeia_script} {input.sim_matrix} {params.outputdir}
        """

rule runLAML:
    input:
        sim_matrix = lambda wildcards : glob.glob(os.path.join(config['inputpath'], wildcards.sim, "*_indel_character_matrix.tsv")),
        casTree = "{outdir}/cassiopeia_greedy/{sim}/cassiopeia_greedy_inferred.nwk",
        mutationPriors = config['mutationPriors'],
    output:
        lamlTreeOriginal = "{outdir}/laml/{sim}/{sim}_laml_trees.nwk",
        lamlTreeNoOrigin = "{outdir}/laml/{sim}/{sim}_laml_trees_no_origin.nwk",
        lamlAnnotations = "{outdir}/laml/{sim}/{sim}_laml_annotations.txt",
        lamlTreeNoBranchLengths = "{outdir}/laml/{sim}/{sim}_laml_trees_no_origin_no_branch_lengths.nwk"
    params:
        scripts = config['scripts'],
        outputdir = "{outdir}/laml/{sim}",
        experimentTime = config['generations'],
        threads = 10,
        mem = '5G'
    singularity:
        f"{config['containers']}/crispr_barcode_migration_inference.sif"
    shell:
        """
        # copy sim matrix, replace header, and replace -1 with ? for missing data
        laml_sim_matrix={params.outputdir}/sim_matrix.csv
        num_sites=$(head -n 1 {input.sim_matrix} | awk -F'\t' '{{print NF-1}}')
        laml_header="cell"
        for i in $(seq 1 $num_sites); do
            laml_header+=",r$i"
        done
        echo $laml_header > $laml_sim_matrix
        tail -n +2 {input.sim_matrix} >> $laml_sim_matrix
        sed -i 's/-1/?/g; s/\t/,/g' $laml_sim_matrix

        # setup the Q matrix mutation priors for the mutations found in the sim matrix
        # laml requires a site specific format, so this is just a reformatting step of the input priors
        mutationPriors={params.outputdir}/mutation_priors.csv
        python {params.scripts}/formatting/format_laml_mutation_priors.py $laml_sim_matrix {input.mutationPriors} $mutationPriors

        # run laml
        run_laml -c $laml_sim_matrix -t {input.casTree} -p $mutationPriors -o {params.outputdir}/{wildcards.sim}_laml --timescale {params.experimentTime} --topology_search --keep_polytomies --parallel
        # # Manual change below for using cassiopeia tree as fixed topology and just estimating branch lengths
        # run_laml -c $laml_sim_matrix -t {input.casTree} -p $mutationPriors -o {params.outputdir}/{wildcards.sim}_laml --timescale {params.experimentTime} --keep_polytomies --parallel

        # remove origin from tree
        fixed_newick=$(cat {output.lamlTreeOriginal} | sed 's/\[&R\]//g' | sed "s/);//g")
        fixed_newick="${{fixed_newick:1}});"
        last_branch=$(echo "$fixed_newick" | grep -oP ':[0-9]+\.[0-9]+(?=\)\;)' | tail -1 | tr -d ':')
        second_last_branch=$(echo "$fixed_newick" | grep -oP ':[0-9]+\.[0-9]+(?=\))' | tail -2 | head -1 | tr -d ':')
        new_branch=$(echo "$last_branch + $second_last_branch" | bc)
        modified_newick=$(echo "$fixed_newick" | sed -r "s/$second_last_branch\):$last_branch/0$new_branch/g")
        echo $modified_newick > {output.lamlTreeNoOrigin}

        # obtain newick without branch lengths
        sed 's/:\([0-9]\+\.\?\([0-9]\+\)\?\)//g' {output.lamlTreeNoOrigin} > {output.lamlTreeNoBranchLengths}
        """

rule prepBeamInputs:
    input:
        sim_matrix = lambda wildcards : glob.glob(os.path.join(config['inputpath'], wildcards.sim, "*_indel_character_matrix.tsv")),
        leafTissues = lambda wildcards: glob.glob(os.path.join(config['inputpath'], wildcards.sim,"cell_tree_*[0-9].labeling")),
        mutationPriors = config['mutationPriors'],
    output:
        fasta = "{outdir}/beam/{sim}/{sim}.fasta",
        tissues = "{outdir}/beam/{sim}/{sim}_tip_tissues.csv",
        sequentialMutationReorderingMap = "{outdir}/beam/{sim}/{sim}_original_mut_to_edit_model_mut.csv",
        obervedEditRateProportions = "{outdir}/beam/{sim}/{sim}_edit_rate_proportions.txt",
        editRates = "{outdir}/beam/{sim}/{sim}_fixed_edit_rates.txt",
    params:
        scripts = config['scripts'],
        generations = config['generations'],
        outputdir = "{outdir}/beam/{sim}",
        threads = 1,
        mem = '1G'
    shell:
        """
        # write tip traits to new csv
        sed 's/ /,/g' {input.leafTissues} > {output.tissues}

        # format fasta, re-label mutations sequentially, and get edit rate proportions for new mutation entries
        python {params.scripts}/formatting/format_beam_input_files.py {input.sim_matrix} {params.outputdir}

        # get fixed edit rates based on the input edit rate priors filtered for the observed states
        python {params.scripts}/formatting/get_fixed_edit_rates_for_beam_sim_matrix.py {input.mutationPriors} {output.sequentialMutationReorderingMap} {output.editRates}
        """

rule runBeam:
    input:
        fasta = "{outdir}/beam/{sim}/{sim}.fasta",
        tissues = "{outdir}/beam/{sim}/{sim}_tip_tissues.csv",
        editRates = "{outdir}/beam/{sim}/{sim}_fixed_edit_rates.txt",
        lamlTreeOriginal = "{outdir}/laml/{sim}/{sim}_laml_trees.nwk",
    output:
        terminalLog = "{outdir}/beam_gtr/{sim}/terminal_{num}.log",
        beamLog = "{outdir}/beam_gtr/{sim}/chain_{num}.log",
        beamResult = "{outdir}/beam_gtr/{sim}/chain_{num}.trees"
    params:
        xml = config['gtrXml'],
        inFileDir = "{outdir}/beam/{sim}",
        fileDir = "{outdir}/beam_gtr/{sim}",
        generations = config['generations'],
        mcmclength = config['mcmcLength'],
        primaryTissue = config['primaryTissue'],
        threads = 5,
        mem= '2G'
    shell:
        """
        cp {params.xml} {params.fileDir}/{wildcards.num}.xml

        # calculate necessary inputs for the editing model
        initialEditRates=$(cat {input.editRates} | tr '\\n' ' ')
        array=($initialEditRates)
        numEditRates=${{#array[@]}}
        numEditRatesPlusTwo=$(( numEditRates + 2 ))

        # format tissue information
        unique_tissues=$(cat {input.tissues} | cut -d',' -f2 | sort | uniq)
        numTissues=$(echo $unique_tissues | tr ' ' '\n' | wc -l)

        # force the known known primary tissue at the origin for root frequencies in the likelihood calculation
        sorted_unique_tissues="{params.primaryTissue} $(echo $unique_tissues | tr ' ' '\n' | grep -v '^{params.primaryTissue}$' | tr '\n' ' ')"
        if ! echo "$unique_tissues" | grep -qw "{params.primaryTissue}"; then
            numTissues=$(( numTissues + 1 ))
        fi
        tissueRootFreqs=$(for i in $(seq 1 $numTissues); do if [[ "$i" = "1" ]]; then echo -n "1 "; else echo -n "0 "; fi; done)

        numTissueRates=$(( ((numTissues * numTissues) - numTissues) / 2 ))

        tissueCodeMap=""
        trailingCodeMap="? = "
        i=0
        for tissue in $sorted_unique_tissues; do
            tissueCodeMap+="$tissue=$i,"
            trailingCodeMap+="$i "
            i=$((i+1))
        done
        tissueCodeMap+="${{trailingCodeMap}}"

        # for some reason this cannot be taken in at the command line, likely because the = signs are problematic and not taken as a single string
        sed -i "s/\$(tissueCodeMap)/$tissueCodeMap/g" {params.fileDir}/{wildcards.num}.xml
        sed -i "s/\$(initialEditRates)/$initialEditRates/g" {params.fileDir}/{wildcards.num}.xml
        sed -i "s/\$(tissueRootFreqs)/$tissueRootFreqs/g" {params.fileDir}/{wildcards.num}.xml

        # use LAML starting tree
        # remove node names from newick and the origin node
        newick=$(cat {input.lamlTreeOriginal} | sed 's/node[0-9]*:/:/g' | sed 's/^.//' | sed 's/..$//')

        beast \
        -threads {params.threads} \
        -overwrite \
        -working \
        -D inName={wildcards.sim} \
        -D fileDir={params.inFileDir} \
        -D newick=\"$newick\" \
        -D generations={params.generations} \
        -D numEditRates=\"$numEditRates\" \
        -D numEditRatesPlusTwo=\"$numEditRatesPlusTwo\" \
        -D numTissueRates=\"$numTissueRates\" \
        -D numTissues=\"$numTissues\" \
        -D mcmclength={params.mcmclength} \
        -D outname=chain_{wildcards.num} \
        {params.fileDir}/{wildcards.num}.xml > {output.terminalLog}
        """

rule combineBeamChains:
    input:
        terminalLog = lambda wildcards: expand("{outdir}/beam_gtr/{sim}/terminal_{num}.log", num=range(1, config['numChains']+1), sim=wildcards.sim, outdir=wildcards.outdir),
        beamLogs = lambda wildcards: expand("{outdir}/beam_gtr/{sim}/chain_{num}.log", num=range(1, config['numChains']+1), sim=wildcards.sim, outdir=wildcards.outdir),
        beamResults = lambda wildcards: expand("{outdir}/beam_gtr/{sim}/chain_{num}.trees", num=range(1, config['numChains']+1), sim=wildcards.sim, outdir=wildcards.outdir),
    output:
        combinedLog = "{outdir}/beam_gtr/{sim}/combined.log",
        combinedTrees = "{outdir}/beam_gtr/{sim}/combined.trees"
    params:
        logcombiner = config['logcombiner'],
        essCutoff = config['essCutoff'],
        treeannotator = config['treeannotator'],
        threads = 1,
        mem = '1G'
    shell:
        """
        # find chains that have converged based on ess threshold specified
        log_files=""
        trees_files=""
        ess_convergences=()
        for file in {input.beamLogs}; do
            terminal_log=$(echo $file | sed 's/chain_/terminal_/')
            
            ess_convergence=$(grep "Msamples" $terminal_log | tail -n 1 | sed 's/^ *//;s/ *$//' | tr -s ' ' | cut -d' ' -f3)
            if (( $(echo "$ess_convergence > {params.essCutoff}" | bc -l) )); then
                log_files+="-log $file "
                trees_file=$(echo $file | sed 's/\.log$/.trees/')
                trees_files+="-log $trees_file "
            else
                echo "$file did not converge, so not including it in the final output"
            fi
        done

        # combine logs and trees that passed
        if [ -n "$log_files" ]; then
            {params.logcombiner} $log_files -o {output.combinedLog}
            {params.logcombiner} $trees_files -o {output.combinedTrees}
        else
            echo "No chains passed the ESS threshold of {params.essCutoff}, so not combining any chains"
        fi
        """


rule beamPostprocessing:
    input:
        combinedTrees = "{outdir}/beam_gtr/{sim}/combined.trees",
        combinedLog = "{outdir}/beam_gtr/{sim}/combined.log"
    output:
        graphPosterior = "{outdir}/beam_gtr/{sim}/posterior_prob_graph.csv",
        probabilityPlot = "{outdir}/beam_gtr/{sim}/probability_migration_graph.pdf",
        samples = "{outdir}/beam_gtr/{sim}/combined_migration_graph_1.pdf",
        migrationCountMatrix = "{outdir}/beam_gtr/{sim}/posterior_trees_migration_count_matrix.csv",
        mutualInformation = "{outdir}/beam_gtr/{sim}/posterior_trees_migration_mutual_information.txt",
    params:
        scripts = config['scripts'],
        primaryTissue = config['primaryTissue'],
        outprefix_thresholded = "{outdir}/beam_gtr/{sim}/thresholded_migration_graph",
        outprefix_samples = "{outdir}/beam_gtr/{sim}/combined",
        outprefix_metastasis_timing = "{outdir}/beam_gtr/{sim}/metastasis_timing",
        experimentTime = config['generations'],
        numSamples = 10,
        consensusTimingThreshold = 0.5,
        threads = 5,
        mem = "1G"
    shell:
        """
        if [ ! -s {input.combinedTrees} ]; then
            echo "Combined trees file is empty. Exiting."
            touch {output.graphPosterior}
        else
            thresholds="0.4,0.5,0.6,0.7,0.8,0.9,0.95,0.99"

            python {params.scripts}/formatting/beam_postprocessing.py \
                {input.combinedTrees} \
                {input.combinedLog} \
                {params.primaryTissue} \
                {output.graphPosterior} \
                {params.threads} \
                {output.probabilityPlot} \
                $thresholds \
                {params.outprefix_thresholded} \
                {params.outprefix_samples} \
                {params.numSamples} \
                {params.experimentTime} \
                {output.migrationCountMatrix} \
                {output.mutualInformation} \
                {params.outprefix_metastasis_timing} \
                {params.consensusTimingThreshold}
        fi
        """


rule runRandomAndConsensusTissueInference:
    input:
        lamlTreeNoBranchLengths = "{outdir}/laml/{sim}/{sim}_laml_trees_no_origin_no_branch_lengths.nwk",
        # lamlTreeNoBranchLengths = "{outdir}/true_trees/{sim}/true_tree_no_tissues.nwk",  # Manual change for ground truth tree runs
        leafTissues = lambda wildcards: glob.glob(os.path.join(config['inputpath'], wildcards.sim, "cell_tree_*[0-9].labeling"))
    output:
        randomResult = "{outdir}/random_consensus_parsimony_tissue_inference/{sim}/random_tissues.nwk",
        consensusResult = "{outdir}/random_consensus_parsimony_tissue_inference/{sim}/consensus_tissues.nwk",
        parsimonyResult = "{outdir}/random_consensus_parsimony_tissue_inference/{sim}/parsimony_tissues.nwk"
    params:
        primary_tissue = "P",
        threads = 1,
        mem = '1G'
    run:
        import pandas as pd
        from ete3 import Tree
        from beam_sup.migration_inference import label_tissues_fitch_parsimony, label_tissues_consensus, label_tissues_random

        # Load tree and resolve polytomies
        tree = Tree(input.lamlTreeNoBranchLengths, format=8)
        tree.resolve_polytomy()

        # Read leaf tissue table
        tissues_df = pd.read_csv(input.leafTissues[0], sep=r"\s+", header=None, names=["cell", "tissue"], dtype={"cell": str, "tissue": str})

        # Perform tissue labeling
        random_tree = label_tissues_random(tree, tissues_df)
        consensus_tree = label_tissues_consensus(tree, tissues_df, params.primary_tissue)
        parsimony_tree, all_solutions = label_tissues_fitch_parsimony(tree, tissues_df, params.primary_tissue, 1)

        # Write output trees
        random_tree.write(outfile=output.randomResult, format=8, format_root_node=True)
        consensus_tree.write(outfile=output.consensusResult, format=8, format_root_node=True)
        parsimony_tree.write(outfile=output.parsimonyResult, format=8, format_root_node=True)



rule prepMachina:
    input:
        lamlTreeNoBranchLengths = "{outdir}/laml/{sim}/{sim}_laml_trees_no_origin_no_branch_lengths.nwk",
        # lamlTreeNoBranchLengths = "{outdir}/true_trees/{sim}/true_tree_no_tissues.nwk",  # Manual change for ground truth tree runs
        leafTissues = lambda wildcards: glob.glob(os.path.join(config['inputpath'], wildcards.sim,"cell_tree_*[0-9].labeling"))
    output:
        labeling = "{outdir}/machina/{sim}/{sim}_laml_trees_no_origin_no_branch_lengths.labeling",
        edges = "{outdir}/machina/{sim}/{sim}_laml_trees_no_origin_no_branch_lengths.tree",
        colors = "{outdir}/machina/{sim}/{sim}_laml_trees_no_origin_no_branch_lengths_colors.txt",
        # labeling = "{outdir}/machina/{sim}/true_tree_no_tissues.labeling",  # Manual change for ground truth tree runs
        # edges = "{outdir}/machina/{sim}/true_tree_no_tissues.tree",  # Manual change for ground truth tree runs
        # colors = "{outdir}/machina/{sim}/true_tree_no_tissues_colors.txt",  # Manual change for ground truth tree runs
    params:
        scripts = config['scripts'],
        outputdir = "{outdir}/machina/{sim}",
        primaryTissue = config['primaryTissue'],
        threads = 1,
        mem = '1G'
    singularity:
        f"{config['containers']}/crispr_barcode_migration_inference.sif"
    shell:
        """
        python {params.scripts}/machina/prep_machina.py {input.lamlTreeNoBranchLengths} {params.outputdir} {params.primaryTissue} {input.leafTissues}
        """

rule runMachina:
    input:
        labeling = "{outdir}/machina/{sim}/{sim}_laml_trees_no_origin_no_branch_lengths.labeling",
        edges = "{outdir}/machina/{sim}/{sim}_laml_trees_no_origin_no_branch_lengths.tree",
        colors = "{outdir}/machina/{sim}/{sim}_laml_trees_no_origin_no_branch_lengths_colors.txt",
        # labeling = "{outdir}/machina/{sim}/true_tree_no_tissues.labeling",  # Manual change for ground truth tree runs
        # edges = "{outdir}/machina/{sim}/true_tree_no_tissues.tree",  # Manual change for ground truth tree runs
        # colors = "{outdir}/machina/{sim}/true_tree_no_tissues_colors.txt",  # Manual change for ground truth tree runs
    output:
        machinaResults = "{outdir}/machina/{sim}/machina_results.txt",
        machinaTree = "{outdir}/machina/{sim}/P-T-P-R.tree",
        machinaTissues = "{outdir}/machina/{sim}/P-T-P-R.labeling"
    params:
        scripts = config['scripts'],
        outputdir = "{outdir}/machina/{sim}",
        primaryTissue = config['primaryTissue'],
        threads = 50,
        mem = '8G'
    singularity:
        f"{config['containers']}/crispr_barcode_migration_inference.sif"
    shell:
        """
        unique_tissues=$(cut -f2 {input.labeling} | sort | uniq)
        num_unique_tissues=$(echo "$unique_tissues" | wc -l)

        if [ "$num_unique_tissues" -gt 1 ]; then

            # check if primary tissue is in the labeling file
            if grep -q "{params.primaryTissue}" {input.labeling}; then
                # run machina
                {params.scripts}/machina/run_machina_tr.sh --threads {params.threads} --edges {input.edges} --labels {input.labeling} --colors {input.colors} --primary-tissue {params.primaryTissue} --outdir {params.outputdir}
                
                # move the dot and edge file to the primary tissue output to satisfy the snakemake since the file label might be different
                cp {params.outputdir}/{params.primaryTissue}-T-{params.primaryTissue}-R.dot {output.machinaTree}
                cp {params.outputdir}/{params.primaryTissue}-T-{params.primaryTissue}-R.tree {output.machinaTissues}
            else
                most_common_tissue=$(cut -f2 {input.labeling} | sort | uniq -c | sort -nr | head -n 1 | awk '{{print $2}}')
                echo "The {params.primaryTissue} is not in the tissue labels. Using the most common tissue $most_common_tissue as the primary tissue."
                {params.scripts}/machina/run_machina_tr.sh --threads {params.threads} --edges {input.edges} --labels {input.labeling} --colors {input.colors} --primary-tissue $most_common_tissue --outdir {params.outputdir}

                # move the dot and edge file to the primary tissue output to satisfy the snakemake since the file label will be different due to the different primary tissue
                cp {params.outputdir}/$most_common_tissue-T-$most_common_tissue-R.dot {output.machinaTree}
                cp {params.outputdir}/$most_common_tissue-T-$most_common_tissue-R.tree {output.machinaTissues}
            fi
        else
            echo "Only one unique tissue found in the labeling file, so not enough to run Machina. Exiting."
            touch {output.machinaTissues}
            touch {output.machinaTree}
            touch {output.machinaResults}
        fi
        """

