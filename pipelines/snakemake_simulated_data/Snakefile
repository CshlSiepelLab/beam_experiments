rule runBeamGtrNs:
    input:
        fasta = "{outdir}/beam/{sim}/{sim}.fasta",
        tissues = "{outdir}/beam/{sim}/{sim}_tip_tissues.csv",
        editRates = "{outdir}/beam/{sim}/{sim}_fixed_edit_rates.txt",
        lamlTreeOriginal = "{outdir}/laml/{sim}/{sim}_laml_trees.nwk",
    output:
        terminalLog = "{outdir}/beam_gtr_ns/{sim}/terminal_{num}.log",
        beamLog = "{outdir}/beam_gtr_ns/{sim}/chain_{num}.log",
        beamResult = "{outdir}/beam_gtr_ns/{sim}/chain_{num}.trees"
    params:
        xml = config['gtrXml'],
        inFileDir = "{outdir}/beam/{sim}",
        fileDir = "{outdir}/beam_gtr_ns/{sim}",
        generations = config['generations'],
        primaryTissue = config['primaryTissue'],
        threads = 5,
        mem = '2G'
    shell:
        """
        cp {params.xml} {params.fileDir}/{wildcards.num}.xml

        # calculate necessary inputs for the editing model
        initialEditRates=$(cat {input.editRates} | tr '\\n' ' ')
        array=($initialEditRates)
        numEditRates=${{#array[@]}}
        numEditRatesPlusTwo=$(( numEditRates + 2 ))

        # format tissue information
        unique_tissues=$(cat {input.tissues} | cut -d',' -f2 | sort | uniq)
        numTissues=$(echo $unique_tissues | tr ' ' '\n' | wc -l)

        # force the known known primary tissue at the origin for root frequencies in the likelihood calculation
        sorted_unique_tissues="{params.primaryTissue} $(echo $unique_tissues | tr ' ' '\n' | grep -v '^{params.primaryTissue}$' | tr '\n' ' ')"
        if ! echo "$unique_tissues" | grep -qw "{params.primaryTissue}"; then
            numTissues=$(( numTissues + 1 ))
        fi
        tissueRootFreqs=$(for i in $(seq 1 $numTissues); do if [[ "$i" = "1" ]]; then echo -n "1 "; else echo -n "0 "; fi; done)

        numTissueRates=$(( ((numTissues * numTissues) - numTissues) / 2 ))

        tissueCodeMap=""
        trailingCodeMap="? = "
        i=0
        for tissue in $sorted_unique_tissues; do
            tissueCodeMap+="$tissue=$i,"
            trailingCodeMap+="$i "
            i=$((i+1))
        done
        tissueCodeMap+="${{trailingCodeMap}}"

        # for some reason this cannot be taken in at the command line, likely because the = signs are problematic and not taken as a single string
        sed -i "s/\$(tissueCodeMap)/$tissueCodeMap/g" {params.fileDir}/{wildcards.num}.xml
        sed -i "s/\$(initialEditRates)/$initialEditRates/g" {params.fileDir}/{wildcards.num}.xml
        sed -i "s/\$(tissueRootFreqs)/$tissueRootFreqs/g" {params.fileDir}/{wildcards.num}.xml

        # use LAML starting tree
        # remove node names from newick and the origin node
        newick=$(cat {input.lamlTreeOriginal} | sed 's/node[0-9]*:/:/g' | sed 's/^.//' | sed 's/..$//')

        # Replace mcmc specs with nested sampling specs
        mcmc_specs="<run id=\\"mcmc\\" spec=\\"MCMC\\" chainLength=\\"\\$(mcmclength)\\">"
        ns_specs="<run id=\\"mcmc\\" spec=\\"beast.gss.NS\\" chainLength=\\"100000000\\" particleCount=\\"1\\" subChainLength=\\"10000\\" epsilon=\\"1e-10\\">"
        sed -i "s/$mcmc_specs/$ns_specs/g" {params.fileDir}/{wildcards.num}.xml

        beast \
        -threads {params.threads} \
        -overwrite \
        -working \
        -D inName={wildcards.sim} \
        -D fileDir={params.inFileDir} \
        -D newick=\"$newick\" \
        -D generations={params.generations} \
        -D numEditRates=\"$numEditRates\" \
        -D numEditRatesPlusTwo=\"$numEditRatesPlusTwo\" \
        -D numTissueRates=\"$numTissueRates\" \
        -D numTissues=\"$numTissues\" \
        -D outname=chain_{wildcards.num} \
        {params.fileDir}/{wildcards.num}.xml > {output.terminalLog}
        """

rule runBeamRandomNs:
    input:
        fasta = "{outdir}/beam/{sim}/{sim}.fasta",
        tissues = "{outdir}/beam/{sim}/{sim}_tip_tissues.csv",
        editRates = "{outdir}/beam/{sim}/{sim}_fixed_edit_rates.txt",
        lamlTreeOriginal = "{outdir}/laml/{sim}/{sim}_laml_trees.nwk",
    output:
        terminalLog = "{outdir}/beam_random_ns/{sim}/terminal_{num}.log",
        beamLog = "{outdir}/beam_random_ns/{sim}/chain_{num}.log",
        beamResult = "{outdir}/beam_random_ns/{sim}/chain_{num}.trees"
    params:
        xml = config['randomXml'],
        inFileDir = "{outdir}/beam/{sim}",
        fileDir = "{outdir}/beam_random_ns/{sim}",
        generations = config['generations'],
        primaryTissue = config['primaryTissue'],
        threads = 5,
        mem = '2G'
    shell:
        """
