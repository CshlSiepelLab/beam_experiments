<beast beautitemplate='MultiTypeBirthDeath' beautistatus='' namespace="beast.base.evolution.alignment:beast.base.inference:beast.base.evolution.operator:beast.base.inference.operator:beast.base.evolution.sitemodel" required="BEAST.base" version="2.7">

<!-- syntactic sugar -->
<map name="Uniform" >beast.base.inference.distribution.Uniform</map>
<map name="Exponential" >beast.base.inference.distribution.Exponential</map>
<map name="prior" >beast.base.inference.distribution.Prior</map>

    
<!-- input data -->
<data  id="alignment" spec="feast.fileio.AlignmentFromFasta" fileName="$(fileDir)/$(inName).fasta">
    <userDataType spec="beam.datatype.EditData"/>
</data>

<data id="tissue" spec="beastclassic.evolution.alignment.AlignmentFromTrait">
    <traitSet id="traitset" spec="feast.fileio.TraitSetFromXSV" fileName="$(fileDir)/$(inName)_tip_tissues.csv" taxa="@taxonset" taxonNameCol="0" skipFirstRow="false" sep="," traitname="discrete"/>
    <userDataType id="tissueDatatype" spec="beam.datatype.TissueData" primaryTissue="$(primaryTissue)" otherTissues="$(otherTissues)"/>
</data>

<run id="mcmc" spec="MCMC" chainLength="$(mcmclength)">
        <state id="state" spec="State" storeEvery="5000">
            <stateNode id="tree" spec="beam.tree.BeamStartingTreeFromNewick" taxa="@alignment" IsLabelledNewick="true" adjustTipHeights="true" newick="$(newick)">
                <taxonset id="taxonset" spec="TaxonSet" alignment="@alignment"/>
            </stateNode>
            <parameter id="silencingRate" spec="parameter.RealParameter" dimension="1" lower="0" name="stateNode" upper="1000">0.001</parameter>
            <parameter id="clockRate.c" spec="parameter.RealParameter" name="stateNode">0.01</parameter>
            <parameter id="relativeGeoRates.s:tissue" spec="parameter.RealParameter" lower="0" dimension="$(numTissueRates)" name="stateNode">1</parameter>
            <parameter id="traitClockRate" spec="parameter.RealParameter" name="stateNode">0.01</parameter>
            <parameter id="piPrimaryTissueFreq" spec="parameter.RealParameter" dimension="1" estimate="true" lower="0" upper="1" name="stateNode">0.5</parameter>
            <parameter id="birthRate" spec="parameter.RealParameter" dimension="1" lower="0" name="stateNode" upper="1">0.006</parameter>
            <parameter id="deathRate" spec="parameter.RealParameter" dimension="1" lower="0" name="stateNode" upper="1">0.0001</parameter>

        </state>
        
        
        <distribution id="posterior" spec="CompoundDistribution">
            
            <distribution id="prior" spec="CompoundDistribution">

                <distribution id="birthDeathSamplingModel" spec="bdsky.evolution.speciation.BirthDeathSkylineModel"
                          conditionOnSurvival="True" tree="@tree" origin="$(generations).0001" contemp="true"
                          birthRate="@birthRate" deathRate="@deathRate" rho="1"
                          samplingRate="0" >
                </distribution>

                <prior id="silencingRatePrior" name="distribution" x="@silencingRate">
                    <Exponential name="distr">
                        <parameter spec="parameter.RealParameter" estimate="false" name="mean">0.1</parameter>
                    </Exponential>
                </prior>

                <prior id="ClockPrior.c" name="distribution" x="@clockRate.c">
                    <Exponential name="distr">
                        <parameter spec="parameter.RealParameter" estimate="false" name="mean">0.1</parameter>
                    </Exponential>
                </prior>

                <prior id="relativeGeoRatesPrior.s:tissue" name="distribution" x="@relativeGeoRates.s:tissue">
                    <Exponential name="distr">
                        <parameter spec="parameter.RealParameter" estimate="false" name="mean">1.0</parameter>
                    </Exponential>
                </prior>

                <prior id="geoclockPrior.c:tissue" name="distribution" x="@traitClockRate">
                    <Exponential name="distr">
                        <parameter spec="parameter.RealParameter" estimate="false" name="mean">0.1</parameter>
                    </Exponential>
                </prior>

                <prior id="piPrimaryTissueFreqPrior" name="distribution" x="@piPrimaryTissueFreq">
                    <Uniform name="distr" lower="0" upper="1"/>
                </prior>

                <prior id="birthRatePrior" name="distribution" x="@birthRate">
                    <Uniform name="distr" lower="0" upper="1"/>
                </prior>
                
                <prior id="deathRatePrior" name="distribution" x="@deathRate">
                    <Uniform name="distr" lower="0" upper="1"/>
                </prior>


            </distribution>
            
            
            <distribution id="likelihood" spec="CompoundDistribution" useThreads="true">
                
                <distribution id="treeLikelihood" spec="beam.likelihood.BeamIrreversibleTreeLikelihood" origin="$(generations).0001" data="@alignment" tree="@tree">
                    <siteModel spec="SiteModel" id="siteModel" mutationRate="1" gammaCategoryCount="1">
                        <substModel id="substModel" spec="beam.substitutionmodel.BeamMutationSubstitutionModel" editRates="@editRate" silencingRate="@silencingRate">
                            <editRates spec="parameter.RealParameter" estimate="false" name="stateNode" lower="0" dimension="$(numEditRates)">$(initialEditRates)</parameter>
                            <frequencies spec="beast.base.evolution.substitutionmodel.Frequencies" frequencies="1 0 0" estimate="false"/>
                        </substModel>
                    </siteModel>
                    <branchRateModel spec="beast.base.evolution.branchratemodel.StrictClockModel" clock.rate="@clockRate.c"/>
                </distribution>
                
                <distribution id="traitLikelihood" spec="beam.likelihood.BeamBeagleAncestralTissueLikelihood" origin="$(generations).0001" tag="location" tree="@tree" data="@tissue">
                    <siteModel id="geoSiteModel.s:tissue" spec="SiteModel" gammaCategoryCount="1" mutationRate="1">
                        <substModel id="substModelMigration" spec="beam.substitutionmodel.BeamNoDirectSeedingSpecifiedTissueGTRTissueSubstitutionModel" rates="@relativeGeoRates.s:tissue" pi="@piPrimaryTissueFreq" specifiedTissueIndex="$(specifiedIndex)">
                            <frequencies spec="beast.base.evolution.substitutionmodel.Frequencies" frequencies="$(tissueRootFreqs)" estimate="false"/>
                        </substModel>
                    </siteModel>
                    <branchRateModel id="StrictClockModel.c:tissue" spec="beast.base.evolution.branchratemodel.StrictClockModel" clock.rate="@traitClockRate"/>
                </distribution>
                
            </distribution>
            
        </distribution>
        
    <!-- tree operators -->
    <operator  spec="Uniform" tree="@tree" weight="30"/>
    <operator  spec="SubtreeSlide" tree="@tree" weight="3"/>
    <operator spec="SubtreeSlide" tree="@tree" weight="3" size="30"/>
    <operator  spec="Exchange" isNarrow="false" tree="@tree" weight="30"/>

    <!-- operators on phylogenetic parameters-->
    <operator id="clockRateScaler" spec="ScaleOperator" parameter="@clockRate.c" scaleFactor="0.8" weight="3"/>
    <operator id="silencingRateScaler" spec="ScaleOperator" parameter="@silencingRate" scaleFactor="0.8" weight="3"/>
        
    <!-- operators on ancestral state model sparameters -->
    <operator id="georateScaler.s:tissue" spec="ScaleOperator" parameter="@relativeGeoRates.s:tissue" scaleAllIndependently="true" scaleFactor="0.99" weight="30"/>
    <operator id="tissueClockRateScaler" spec="ScaleOperator" parameter="@traitClockRate" scaleFactor="0.8" weight="3"/>
    <operator id="piPrimaryTissueFreqScaler" spec="ScaleOperator" parameter="@piPrimaryTissueFreq" scaleFactor="0.8" weight="3"/>
    

    <!-- Operators on phylodynamic parameters -->
    <operator id="birthRateScaler" spec="ScaleOperator" parameter="@birthRate" scaleFactor="0.8" weight="3"/>
    <operator id="deathRateScaler" spec="ScaleOperator" parameter="@deathRate" scaleFactor="0.8" weight="3"/>

    <operator id="updownBD" spec="UpDownOperator" scaleFactor="0.8" weight="30">
         <up idref="birthRate"/>
         <down idref="deathRate"/>
    </operator>


    <!-- loggers -->
        <logger id="tracelog" spec="Logger" fileName="$(outname).log" logEvery="10000" model="@posterior" sanitiseHeaders="true" sort="smart">
            <log idref="posterior"/>
            <log idref="likelihood"/>
            <log idref="prior"/>
            <log id="treeHeight" spec="beast.base.evolution.tree.TreeHeightLogger" tree="@tree"/>
            <log idref="silencingRate" />
            <log idref="clockRate.c"/>
            <log idref="relativeGeoRates.s:tissue"/>
            <log idref="traitClockRate"/>
            <log id="tissueSubstModelLogger" spec="beam.substitutionmodel.BeamTissueSubstitutionModelLogger" dataType="@codeMap" model="@substModelMigration"/>
            <log idref="treeLikelihood"/>
            <log idref="traitLikelihood"/>
            <log idref="birthRate"/>
            <log idref="deathRate"/>
            <log idref="piPrimaryTissueFreq"/>
        </logger>

        <logger id="screenlog" spec="Logger" logEvery="10000">
            <log idref="posterior"/>
            <log id="ESS" spec="util.ESS" arg="@posterior"/>
            <log idref="likelihood"/>
            <log idref="prior"/>
        </logger>

        <logger id="treeWithTraitLogger" spec="Logger" fileName="$(outname).trees" logEvery="10000" mode="tree">
                <log id="treeWithTraitLoggerItem" spec="beastclassic.evolution.tree.TreeWithTraitLogger" tree="@tree">
                    <metadata idref="traitLikelihood"/>
                </log>
        </logger>

    <operatorschedule id="OperatorSchedule" spec="kernel.BactrianOperatorSchedule"/>
</run>

</beast>
